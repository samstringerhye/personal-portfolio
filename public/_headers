/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# HTML pages: no-transform stops Cloudflare injecting its bot-detection script (JavaScript
# Detections), which the Free plan can't switch off and which cost 0.4-0.7s of main thread per page
# on mobile. Pages are stored pre-compressed, so they stay Brotli-compressed. Listed per path so the
# rule doesn't also match /_astro/* and merge two Cache-Control values.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/about
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/resume
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/colophon
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/blog
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/blog/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/work/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000

# Embedded prototypes (public/_protected-embeds/) are framed by the case study page itself
# and need X-Frame-Options: SAMEORIGIN instead of the DENY above. Cloudflare's _headers
# matching merges same-named headers from every matching rule rather than having the more
# specific one win, so a rule here would just append SAMEORIGIN alongside DENY and the
# browser falls back to the stricter value. The actual override happens in code instead —
# see src/middleware.ts, serveEmbeddedAsset, which sets the header explicitly on the response.
