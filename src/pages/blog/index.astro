---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

const allPosts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime())
---

<BaseLayout title="Writing | Sam Stringer-Hye" description="Writing about design decisions, building with AI, and the details people skip." noindex>
  <section class="blog-index" aria-label="Blog posts">
    <h1 class="blog-index-heading typo-display-md">Writing</h1>

    {allPosts.length === 0 && (
      <div class="blog-empty-wrap">
        <p class="blog-empty typo-body-lg">No posts yet. Check back soon.</p>
      </div>
    )}

    {allPosts.map((post, i) => (
      <article class="blog-row">
        <a href={`/blog/${post.id}`} class="blog-row-link" data-astro-prefetch="hover">
          <time class="blog-row-date typo-ui-caps" datetime={post.data.publishedDate.toISOString().slice(0, 10)}>
            {post.data.publishedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </time>
          <h2 class="blog-row-title typo-headline-lg">{post.data.title}</h2>
          <p class="blog-row-desc typo-body-lg">{post.data.description}</p>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .blog-index {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
  }

  .blog-index-heading {
    color: var(--color-text-primary);
    margin: 0;
    padding-block: var(--space-6);
    padding-inline: var(--content-inset-md);
  }

  .blog-empty-wrap {
    padding-block: var(--space-6);
    padding-inline: var(--content-inset-md);
    max-width: var(--prose-measure);
    margin-inline: auto;
    text-align: center;
  }

  .blog-empty {
    color: var(--color-text-primary);
  }

  .blog-row {
    position: relative;
  }

  /* Last row grows to fill any leftover space, so it (not empty whitespace) reaches the footer */
  .blog-row:last-of-type {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .blog-row::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-rule);
    transform: scaleX(var(--border-draw, 1));
    transform-origin: left;
  }

  .blog-row-link {
    display: block;
    padding-block: var(--space-5);
    padding-inline: var(--content-inset-md);
    text-decoration: none;
    color: inherit;
  }

  .blog-row:last-of-type .blog-row-link {
    flex: 1;
  }

  .blog-row-date {
    display: block;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .blog-row-title {
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
  }

  .blog-row-desc {
    color: var(--color-text-primary);
    margin: 0;
    max-width: var(--prose-measure);
  }

  @media (--2x) {
    .blog-index-heading {
      padding-inline: var(--content-inset-sm);
    }

    .blog-row-link {
      padding-inline: var(--content-inset-sm);
    }

    .blog-empty-wrap {
      padding-inline: var(--content-inset-sm);
      max-width: none;
    }
  }
</style>

<script>
  async function init() {
    const { tightenSingleLineHeadings } = await import('../../components/tighten-headings')
    tightenSingleLineHeadings('.blog-index-heading, .blog-row-title, .blog-row-date, .blog-row-desc')
  }

  function deferInit() {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => init(), { timeout: 1500 })
    } else {
      setTimeout(init, 100)
    }
  }

  deferInit()
  document.addEventListener('astro:page-load', deferInit)
</script>
