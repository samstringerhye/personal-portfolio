---
import BaseLayout from '../layouts/BaseLayout.astro'
import ClientLogos from '../components/ClientLogos.astro'
import { Image } from 'astro:assets'
import portrait from '../assets/about/sam-portrait.jpg'
import { animations } from '../data/tokens'
import headphone from '../assets/about/icons/headphone.png'
import videoGame from '../assets/about/icons/video_game.png'
import ghost from '../assets/about/icons/ghost.png'
import clapperBoard from '../assets/about/icons/clapper_board.png'

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Sam Stringer-Hye",
    "jobTitle": "Associate Design Director",
    "worksFor": { "@type": "Organization", "name": "Razorfish" },
    "homeLocation": { "@type": "Place", "address": { "@type": "PostalAddress", "addressLocality": "Philadelphia", "addressRegion": "PA", "addressCountry": "US" } },
    "url": "https://samstringerhye.com",
    "sameAs": ["https://linkedin.com/in/samstringerhye"],
    "knowsAbout": ["Design Leadership", "Brand Identity", "Content Platforms", "Design Systems", "Product Design"],
  },
}

// A few things from the interests list, placed loosely around the photo: x and y are the center in %
// of the photo's box, size the width in %. Clay sculpts in 3D (about-icons.ts) replace the flat
// Fluent emoji (MIT, Microsoft) once the canvas is up; the emoji stay as the fallback.
const ICONS = [
  { src: headphone, alt: 'Audiophile', x: 10, y: 14, size: 30, sculpt: 'headphones', yaw: 0.35, pitch: 0.15 },
  { src: videoGame, alt: 'Gamer', x: 94, y: 36, size: 24, sculpt: 'gamepad', yaw: -0.3, pitch: 0.3 },
  { src: ghost, alt: 'Horror fiend', x: 84, y: 88, size: 26, sculpt: 'ghost', yaw: -0.3, pitch: 0.05 },
  { src: clapperBoard, alt: 'Cinephile', x: 3, y: 72, size: 22, sculpt: 'clapperboard', yaw: 0.4, pitch: 0.1 },
]
const models = ICONS.map(({ sculpt, x, y, size, yaw, pitch }) => ({ sculpt, x, y, size, yaw, pitch }))
const float = animations.about.icons

const skills = [
  { title: 'Design Leadership', desc: 'Leading teams of three to six designers, including six on Amica.com' },
  { title: 'Brand & Content Platforms', desc: 'Brand direction for Whataburger and Mashable, and the content authoring model behind Amica.com' },
  { title: 'Design Systems', desc: 'Systems for Amica, MyFrontier, CVS, Samsung.com, and Whataburger' },
  { title: 'Product Design', desc: 'Flows, prototypes, and motion for Bespoke, Whataburger, and Frontier' },
]
---

<BaseLayout title="About | Sam Stringer-Hye" description="About Sam Stringer-Hye | Associate Design Director at Razorfish." jsonLd={aboutJsonLd}>
  <section class="about-page" aria-label="About">
    <div class="about-row about-row--intro">
      <div class="about-intro-right">
        <h1 class="about-name typo-display-md">All that screen time actually led somewhere</h1>
        <p class="about-bio typo-body-lg">
          I got my first computer at seven and never really looked up. That turned into 14 years across brand, editorial, and product, from Mashable and NowThis to leading client teams at Razorfish.
        </p>
        <p class="about-bio typo-body-lg">
          I'm the person who notices when the spacing is off, when a transition feels wrong, or when a component system only works in the deck.
        </p>
      </div>
      <div class="about-portrait-cell" data-no-reveal style={`--float: ${float.float}px; --tilt: ${float.tilt}deg; --float-duration: ${float.duration}s`}>
        <div class="about-orbit">
          <Image
            src={portrait}
            alt="Sam Stringer-Hye in glasses and a navy work jacket, standing in front of a red corrugated wall"
            widths={[400, 640, 720, 960]}
            sizes="(max-width: 768px) 80vw, 33vw"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
            class="about-portrait"
          />
          <canvas class="about-icons-3d" aria-hidden="true" data-models={JSON.stringify(models)}></canvas>
          <ul class="about-icons" aria-label="Things I'm into">
            {ICONS.map((icon, i) => (
              <li class="about-icon" style={`left: ${icon.x.toFixed(1)}%; top: ${icon.y.toFixed(1)}%; width: ${icon.size}%; animation-delay: -${(i * float.stagger).toFixed(2)}s`}>
                <Image src={icon.src} alt={icon.alt} width={256} format="webp" loading="eager" />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="about-row about-row--skills">
      <h2 class="about-skills-heading typo-headline-lg">What I do</h2>
      <ul class="skill-grid" role="list">
        {skills.map(s => (
          <li class="skill-cell">
            <h3 class="skill-title typo-headline-sm">{s.title}</h3>
            <p class="skill-desc typo-body-lg">{s.desc}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="about-row about-row--logos">
      <div class="about-row-body">
        <h2 class="about-section-label typo-headline-lg">Selected clients</h2>
      </div>
      <div class="about-logos-wrap">
        <ClientLogos />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }


  .about-row {
    position: relative;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }

  .about-row::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-rule);
    transform: scaleX(var(--border-draw, 1));
    transform-origin: left;
  }

  /* ── Bio split ── */
  .about-portrait-cell {
    grid-column: 1 / 5;
    /* Span the gutter so the photo meets the column rule */
    margin-inline-end: calc(-1 * var(--grid-gutter));
  }

  .about-name {
    margin: 0 0 var(--space-3);
  }

  .about-portrait {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .about-intro-right {
    grid-column: 5 / -1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--content-inset-md);
  }

  .about-intro-right::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--border-width-1);
    background: var(--color-rule);
    transform: scaleY(var(--border-draw, 1));
    transform-origin: top;
  }

  .about-bio {
    color: var(--color-text-primary);
    margin: 0;
    max-width: var(--prose-measure);
  }

  /* ── Skill grid ── */
  .about-skills-heading {
    grid-column: 1 / -1;
    margin: 0;
    padding: var(--space-5) var(--content-inset-md) var(--space-4);
  }

  .skill-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .skill-grid::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-rule);
  }

  .skill-cell {
    position: relative;
    padding: var(--space-4) var(--space-4);
  }

  .skill-cell + .skill-cell::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--border-width-1);
    background: var(--color-rule);
    transform: scaleY(var(--border-draw, 1));
    transform-origin: top;
  }

  .skill-title {
    margin: 0 0 var(--space-3);
  }

  .skill-desc {
    color: var(--color-text-primary);
    margin: 0;
  }

  /* ── Shared ── */
  .about-row-body {
    grid-column: 1 / -1;
    padding-block: var(--space-5);
    padding-inline: var(--content-inset-md);
  }

  .about-section-label {
    margin: 0 0 var(--space-4);
  }

  .about-logos-wrap {
    grid-column: 1 / -1;
    padding-bottom: var(--space-5);
  }

  /* ── Mobile ── */
  @media (--2x) {

    .about-portrait-cell,
    .about-intro-right {
      grid-column: 1 / -1;
    }

    .about-portrait-cell {
      margin-inline-end: 0;
    }

    .about-intro-right {
      padding-inline: var(--content-inset-sm);
    }

    .about-intro-right::before {
      top: 0;
      left: 0;
      right: 0;
      bottom: auto;
      width: auto;
      height: var(--border-width-1);
      transform: scaleX(var(--border-draw, 1));
      transform-origin: left;
    }

    .skill-grid {
      grid-template-columns: 1fr 1fr;
    }

    .skill-cell:nth-child(n+3) {
      border-top: var(--border-width-1) solid var(--color-rule);
    }

    .skill-cell:nth-child(odd)::before {
      display: none;
    }

    .skill-cell {
      padding-inline: var(--content-inset-sm);
    }

    .about-skills-heading {
      padding-inline: var(--content-inset-sm);
    }

    .about-row-body {
      grid-column: 1 / -1;
      padding-inline: var(--content-inset-sm);
      max-width: none;
    }
  }
</style>

<script>
  import type { AboutIcon } from '../components/about-icons'

  let teardown: (() => void) | undefined

  async function init() {
    teardown?.()
    teardown = undefined
    const orbit = document.querySelector<HTMLElement>('.about-orbit')
    const canvas = orbit?.querySelector<HTMLCanvasElement>('.about-icons-3d')
    if (!orbit || !canvas) return
    const icons = JSON.parse(canvas.dataset.models ?? '[]') as AboutIcon[]
    const { mountAboutIcons } = await import('../components/about-icons')
    teardown = mountAboutIcons(orbit, canvas, icons)
  }

  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:before-swap', () => { teardown?.(); teardown = undefined })
</script>
