---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro'
import { getSortedWork, buildCaseStudyProps } from './_caseStudy'

export async function getStaticPaths() {
  const sorted = await getSortedWork()

  return sorted
    .filter(entry => !entry.data.passwordProtected)
    .map(entry => ({ params: { slug: entry.id }, props: { entry, sorted } }))
}

const { entry, sorted } = Astro.props
const { Content, prevSlug, prevTitle, nextSlug, nextTitle, noindex, ogImage, jsonLd } = await buildCaseStudyProps(entry, sorted)
---

<CaseStudyLayout
  title={entry.data.title}
  tagline={entry.data.tagline}
  ogImage={ogImage}
  jsonLd={jsonLd}
  prevSlug={prevSlug}
  prevTitle={prevTitle}
  nextSlug={nextSlug}
  nextTitle={nextTitle}
  noindex={noindex}
  heroLayers={entry.data.thumbnailLayers}
  heroAlt={entry.data.thumbnailAlt}
  heroYear={entry.data.year}
  heroTone={entry.data.thumbnailText}
>
  <Content />
</CaseStudyLayout>
