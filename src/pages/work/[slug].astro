---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro'
import { getSortedWork, buildCaseStudyProps } from './_caseStudy'

export const prerender = false

// This SSR route exists so password-protected case studies can be gated by
// middleware (which requires SSR, since Cloudflare Workers can't run sharp
// at request time and static assets bypass the Worker entirely). In dev,
// Astro always prioritizes this single-segment dynamic route over the
// prerendered [...slug].astro rest-param route, so it also has to handle
// every OTHER case study slug here — in production those are instead served
// as prebuilt static files by Cloudflare's asset lookup before this route
// is ever reached, preserving their build-time image optimization.
const { slug } = Astro.params
const sorted = await getSortedWork()
const entry = sorted.find(e => e.id === slug)
if (!entry) return new Response(null, { status: 404 })

// Set by middleware.ts while a protected case study is locked: render the hero with the password
// form and leave the body out, so nothing behind the password reaches the browser
const gate = (Astro.locals as { gate?: { error?: boolean; rateLimited?: boolean } }).gate
const { Content, prevSlug, prevTitle, prevLocked, nextSlug, nextTitle, nextLocked, noindex, ogImage, jsonLd } = await buildCaseStudyProps(entry, sorted)
---

<CaseStudyLayout
  title={entry.data.title}
  tagline={entry.data.tagline}
  ogImage={ogImage}
  jsonLd={jsonLd}
  prevSlug={prevSlug}
  prevTitle={prevTitle}
  prevLocked={prevLocked}
  nextSlug={nextSlug}
  nextTitle={nextTitle}
  nextLocked={nextLocked}
  noindex={noindex || !!gate}
  gate={gate}
  heroLayers={entry.data.thumbnailLayers}
  heroAlt={entry.data.thumbnailAlt}
  heroYear={entry.data.yearLabel ?? entry.data.year}
  heroTags={entry.data.tags?.slice(0, 2)}
  heroTone={entry.data.thumbnailText}
  heroScene={entry.data.thumbnailScene}
>
  {!gate && <Content />}
</CaseStudyLayout>
