---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found | Sam Stringer-Hye" description="Page not found.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="not-found" aria-label="Page not found">
    <p class="not-found-code typo-ui-caps">404</p>
    <h1 class="typo-display-md">Page not found</h1>
    <p class="typo-body-lg">Nothing here. Just empty pixels.</p>
    <div class="not-found-actions">
      <a href="/" class="not-found-link typo-body-lg">Home</a>
      <a href="/#work" class="not-found-link typo-body-lg">Work</a>
      <a href="/about" class="not-found-link typo-body-lg">About</a>
      <a href="/#experience" class="not-found-link typo-body-lg">Experience</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: calc(100svh - var(--nav-height));
    padding: var(--space-4);
    gap: var(--space-2);
  }

  .not-found-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .not-found-link {
    padding: var(--space-1) var(--space-3);
    min-height: var(--touch-target);
    display: inline-flex;
    align-items: center;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .not-found-code {
    color: var(--color-text-primary);
  }
</style>
