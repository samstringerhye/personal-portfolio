---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSection from '../components/HeroSection.astro'
import WorkList from '../components/WorkList.astro'
import Leadership from '../components/Leadership.astro'
import ExperienceList from '../components/ExperienceList.astro'
import ScrollingInterests from '../components/ScrollingInterests.astro'
import OffHours from '../components/OffHours.astro'
import LatestWriting from '../components/LatestWriting.astro'
import RowLink from '../components/RowLink.astro'
import HomeContact from '../components/HomeContact.astro'

import homeData from '../content/home.json'
import type { HomeContent } from '../types/content'

// JSON imports widen fields like headingTag to string; home.schema.json enforces the allowed values
const home = homeData as HomeContent
// Off hours replaces the marquee once it has something to show (drafts count only on preview builds)
const showOffHours = home.offHours.items.some(item => item.caption) || __SHOW_DRAFTS__
---

<BaseLayout title="Sam Stringer-Hye | Associate Design Director" description="Sam Stringer-Hye is an Associate Design Director who leads Razorfish design teams on client work for Amica, Samsung, CVS, and Frontier.">
  <HeroSection
    headline={home.hero.headline}
    tag={home.hero.headlineTag}
    role={home.hero.headlineRole}
    body={home.hero.body}
    bodyHighlights={home.hero.bodyHighlights}
    bodyRole={home.hero.bodyRole}
  />
  <hr class="section-rule" />
  <WorkList
    headline={home.work.headline}
    headingTag={home.work.headingTag}
    headingRole={home.work.headingRole}
    cardTitleTag={home.work.cardTitleTag}
    cardTitleRole={home.work.cardTitleRole}
  />
  <hr class="section-rule" />
  <Leadership
    headline={home.leadership.headline}
    items={home.leadership.items}
    headingTag={home.leadership.headingTag}
    headingRole={home.leadership.headingRole}
    itemTitleRole={home.leadership.itemTitleRole}
    itemBodyRole={home.leadership.itemBodyRole}
  />
  <LatestWriting />
  <hr class="section-rule" />
  <ExperienceList />
  <RowLink label="Archive" href="/archive" text="Motion and editorial work, 2012 on" />
  <hr class="section-rule" />
  {showOffHours ? (
    <OffHours headline={home.offHours.headline} items={home.offHours.items} />
  ) : (
    <ScrollingInterests
      interests={home.interests.items}
      textRole={home.interests.textRole}
    />
  )}
  <hr class="section-rule" />
  <HomeContact headline={home.contact.headline} />
</BaseLayout>
