---
import BaseLayout from './BaseLayout.astro'
import CaseStudyNav from '../components/CaseStudyNav.astro'
import CaseStudyHero from '../components/CaseStudyHero.astro'
import ContactEmail from '../components/ContactEmail.astro'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  tagline?: string
  ogImage?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  prevSlug?: string
  prevTitle?: string
  nextSlug?: string
  nextTitle?: string
  noindex?: boolean
  heroLayers?: { subject: ImageMetadata; background: string; heroOffset?: number }
  heroAlt?: string
  heroYear?: number
  heroTone?: 'light' | 'dark'
}

const { title, tagline, ogImage, jsonLd, prevSlug, prevTitle, nextSlug, nextTitle, noindex, heroLayers, heroAlt, heroYear, heroTone } = Astro.props
---

<BaseLayout title={`${title} — Sam Stringer-Hye`} description={tagline} ogImage={ogImage} jsonLd={jsonLd} noindex={noindex}>
  <div class="scroll-progress" aria-hidden="true"></div>
  <article class="case-study-body">
    {heroLayers && <CaseStudyHero subject={heroLayers.subject} background={heroLayers.background} heroOffset={heroLayers.heroOffset} alt={heroAlt ?? title} title={title} tagline={tagline} year={heroYear} tone={heroTone} />}
    <slot />
  </article>

  <section class="case-study-cta" aria-labelledby="case-study-cta-heading">
    <hr class="section-rule" />
    <div class="case-study-cta-content">
      <h2 id="case-study-cta-heading" class="typo-headline-sm">Like what you see?</h2>
      <ContactEmail class="case-study-cta-link typo-body-lg" />
    </div>
  </section>

  <CaseStudyNav
    prevSlug={prevSlug}
    prevTitle={prevTitle}
    nextSlug={nextSlug}
    nextTitle={nextTitle}
  />
</BaseLayout>

<style is:global>
  .case-study-body {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 0;
  }

  /* ── Intro: the paragraph under the hero, set larger with generous space as a lead-in ── */
  .case-study-body .prose-group:has(> .cs-intro) {
    grid-column: 2 / 10;
    padding-block: var(--space-8);
  }

  .case-study-body .prose-group > .cs-intro {
    margin: 0;
    font-size: var(--text-200);
    line-height: var(--line-height-normal);
    color: var(--color-text-primary);
  }

  @media (--2x) {
    .case-study-body .prose-group:has(> .cs-intro) {
      grid-column: 1 / -1;
      padding-block: var(--space-7);
    }
  }

  /* ── Contact CTA ── */
  .case-study-cta {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }

  .case-study-cta .section-rule {
    grid-column: 1 / -1;
  }

  .case-study-cta-content {
    grid-column: 2 / 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-block: var(--space-6);
  }

  .case-study-cta-link {
    text-decoration: underline;
    text-decoration-thickness: var(--border-width-1);
    text-underline-offset: 0.15em;
  }

  /* ── All children: full-width, no universal border ── */
  .case-study-body > * {
    grid-column: 1 / -1;
    margin: 0;
  }

  /* ── Bordered frame only on visual elements ── */
  .case-study-body .cs-hero-image,
  .case-study-body .cs-hero-meta,
  .case-study-body .image-pair,
  .case-study-body .carousel,
  .case-study-body .zigzag-section,
  .case-study-body .cs-figure,
  .case-study-body .image-grid,
  .case-study-body > img,
  .case-study-body .accent-band {
    border: var(--border-width-1) solid var(--color-text-primary);
  }

  /* Collapse doubled borders: when two bordered siblings are adjacent,
     pull the second one up by 1px so the borders overlap instead of stacking. */
  .case-study-body :is(.cs-hero-image, .cs-hero-meta, .image-pair, .carousel, .zigzag-section, .cs-figure, .image-grid, .accent-band, .lottie-grid)
  + :is(.cs-hero-meta, .image-pair, .carousel, .zigzag-section, .cs-figure, .image-grid, .accent-band, .lottie-grid) {
    margin-top: calc(-1 * var(--border-width-1));
  }


  /* ── Hero image ── */
  .case-study-body .cs-hero-image {
    overflow: hidden;
    border: none;
    border-bottom: var(--border-width-1) solid var(--color-rule);
  }

  .case-study-body .cs-hero-image img {
    width: 100%;
    height: auto;
    display: block;
    max-height: none;
    object-fit: cover;
  }

  /* ── Meta bar ── */
  .case-study-body .cs-hero-meta {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    padding: 0;
    margin-top: 0;
  }

  .case-study-body .cs-meta-item {
    grid-column: span 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
  }

  .case-study-body .cs-meta-item + .cs-meta-item {
    border-left: var(--border-width-1) solid var(--color-text-primary);
  }

  .case-study-body .cs-meta-value {
    margin: 0;
  }

  /* ── Copy blocks: align to column grid ── */
  .case-study-body > h1,
  .case-study-body > h2,
  .case-study-body > h3,
  .case-study-body > p,
  .case-study-body > ul,
  .case-study-body > ol,
  .case-study-body > blockquote {
    grid-column: 2 / 10;
    padding: 0;
  }

  /* Prose groups: columns 2–8 (6 of 12 columns) */
  .case-study-body .prose-group {
    grid-column: 2 / 8;
    padding: 0;
  }

  /* ── Carousel: inherits bordered frame from > * rule ── */
  .case-study-body .carousel {
    overflow: hidden;
  }

  .case-study-body .carousel-track {
    cursor: grab;
  }
  .case-study-body .carousel-track.is-dragging {
    cursor: grabbing;
  }

  /* ── Standalone images ── */
  .case-study-body > img {
    padding: 0;
    object-fit: cover;
  }

  .case-study-body img:where(:not(.device-screen)):where(:not(.device-frame)):where(:not(.browser-screen)):where(:not(.mosaic-media)) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100vh;
    object-fit: contain;
    background: var(--color-bg-primary);
  }

  .case-study-body img.has-transparency:not(.mosaic-media) {
    background: var(--color-bg-primary);
    padding: var(--space-6);
    object-fit: contain;
  }

  .case-study-body .carousel-track img.has-transparency {
    padding: var(--space-5) var(--space-7);
  }

  /* ── Image hover: subtle scale + shadow lift + zoom cursor ── */
  .case-study-body .cs-hero-image,
  .case-study-body .cs-figure,
  .case-study-body .image-pair,
  .case-study-body .image-pair > img,
  .case-study-body .image-grid,
  .case-study-body .image-grid > .cs-figure,
  .case-study-body .zigzag-media,
  .case-study-body .carousel {
    overflow: hidden;
  }

  .case-study-body .cs-figure img,
  .case-study-body .image-pair img:not(.device-screen):not(.device-frame),
  .case-study-body .image-grid img,
  .case-study-body .zigzag-media {
    transition: scale 0.3s ease;
  }

  @media (hover: hover) {
    .case-study-body .cs-figure img:hover,
    .case-study-body .image-pair img:not(.device-screen):not(.device-frame):hover,
    .case-study-body .image-grid img:hover {
      scale: 1.02;
    }
  }

  /* Carousel images: no zoom hover */
  .case-study-body .carousel .cs-figure img,
  .case-study-body .carousel img {
    transition: none;
  }
  .case-study-body .carousel .cs-figure img:hover,
  .case-study-body .carousel img:hover {
    scale: 1;
  }

  @media (hover: hover) {
    .case-study-body .zigzag-media:hover {
      scale: 1.02;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study-body img {
      transition: none;
    }
  }

  /* ── Lists ── */
  .case-study-body ul {
    list-style: disc;
    padding-left: 1.25em;
  }

  .case-study-body li {
    margin-bottom: var(--space-1);
  }

  /* ── Image pairs: two images side by side ── */
  .case-study-body .image-pair {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--border-width-1);
    padding: 0;
    background: var(--color-text-primary);
  }

  .case-study-body .image-pair > *,
  .case-study-body .image-pair-cell {
    margin: 0;
    padding: 0;
    border: none;
    background: var(--color-bg-primary);
    line-height: 0;
    overflow: hidden;
  }

  .case-study-body .image-pair img:not(.device-screen):not(.device-frame) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 75vh;
    margin-inline: auto;
  }

  .case-study-body .image-pair:has(img.has-transparency) {
    background: var(--color-bg-primary);
    column-gap: 0;
  }

  .case-study-body .image-pair-cell:has(img.has-transparency) + .image-pair-cell {
    border-left: var(--border-width-1) solid var(--color-rule);
  }

  .case-study-body .image-pair-cell:has(img.has-transparency) {
    background: var(--color-bg-primary);
  }

  .case-study-body .image-pair img.has-transparency {
    object-fit: contain;
    background: transparent;
  }

  /* ── Image pair with device frames: padded, centered, warm bg ── */
  .case-study-body .image-pair:has(.device-phone) {
    background: var(--color-bg-warm, #fdf8f4);
    column-gap: var(--border-width-1);
  }

  .case-study-body .image-pair > .image-pair-cell:has(.device-phone) {
    background: var(--color-bg-warm, #fdf8f4);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5) var(--space-3);
    line-height: normal;
    overflow: visible;
  }

  .case-study-body .image-pair-cell .device-phone {
    width: 280px;
    max-width: 100%;
  }

  /* ── Zigzag: alternating image/text 2-col sections ── */
  .case-study-body .zigzag-section {
    display: grid;
    grid-template-columns: subgrid;
  }

  .case-study-body .zigzag-media {
    grid-column: 2 / 7;
  }

  .case-study-body .zigzag-prose {
    grid-column: 7 / 12;
  }

  .case-study-body .zigzag-reversed .zigzag-media {
    grid-column: 7 / 12;
    grid-row: 1;
  }

  .case-study-body .zigzag-reversed .zigzag-prose {
    grid-column: 2 / 7;
    grid-row: 1;
  }


  .case-study-body .zigzag-media {
    overflow: hidden;
    line-height: 0;
    border-radius: var(--radius-lg);
  }

  .case-study-body .zigzag-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study-body .zigzag-media .cs-figure {
    border: none;
    height: 100%;
    padding: 0;
  }

  .case-study-body .zigzag-media .cs-figure > p,
  .case-study-body .zigzag-media .cs-figure > img {
    height: 100%;
  }

  .case-study-body .zigzag-media .cs-figure figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-1) var(--space-3);
    background: linear-gradient(transparent, rgba(0,0,0,0.5));
    color: var(--color-bg-primary);
  }

  .case-study-body .zigzag-media .cs-figure {
    position: relative;
  }

  .case-study-body .zigzag-prose {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0;
    gap: var(--space-2);
  }

  .case-study-body .zigzag-prose .prose-group {
    padding: 0;
    border: none;
  }


  /* ── Accent band: full-width color section ── */
  .case-study-body .accent-band {
    padding-inline: var(--content-inset-md);
  }
  .accent-band-1 { background: var(--color-accent-1); }
  .accent-band-2 { background: var(--color-accent-2); }
  .accent-band-3 { background: var(--color-accent-3); }

  /* Children inside accent band lose their own border */
  .case-study-body .accent-band > * {
    border: none;
  }

  /* ── Figure: image + figcaption ── */
  .case-study-body .cs-figure {
    padding-inline: 0;
  }

  .case-study-body .cs-figure > p,
  .case-study-body .cs-figure > img {
    padding: 0;
    margin: 0;
    border: none;
  }

  /* Flush figures: full-bleed width, capped to one viewport height via crop */
  .case-study-body .cs-figure--flush img {
    max-height: 100vh;
    object-fit: cover;
  }

  .case-study-body .cs-figure figcaption {
    padding: var(--space-2) 0 0;
    font-size: var(--text-100);
    color: var(--color-text-primary);
    line-height: var(--line-height-normal);
  }

  /* Bare, non-flush figures: the border wraps the whole box, so give the
     caption its own divider instead of letting it sit flush against the image. */
  .case-study-body > .cs-figure:not(.cs-figure--flush) figcaption {
    border-top: var(--border-width-1) solid var(--color-text-primary);
    padding-top: var(--space-3);
    margin-top: var(--space-2);
  }

  /* ── Image grid: 2×2 (or n-column) layout ── */
  .case-study-body .image-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols, 2), 1fr);
    gap: var(--border-width-1);
    padding: 0;
    background: var(--color-text-primary);
  }

  .case-study-body .image-grid > .cs-figure,
  .case-study-body .image-grid > img {
    margin: 0;
    padding: 0;
    border: none;
    background: var(--color-bg-primary);
  }

  .case-study-body .image-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    max-height: 60vh;
  }

  .case-study-body .image-grid .cs-figure figcaption {
    background: var(--color-bg-primary);
    border-top: var(--border-width-1) solid var(--color-text-primary);
    padding: var(--space-3) 0 0;
  }

  /* ── Lottie grid: 4-col full-width with dividers ── */
  .case-study-body .lottie-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--color-accent-1);
    border-top: var(--border-width-1) solid var(--color-text-primary);
    border-bottom: var(--border-width-1) solid var(--color-text-primary);
  }

  .case-study-body .lottie-grid .lottie-player {
    padding: var(--space-6);
    border-right: var(--border-width-1) solid var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .case-study-body .lottie-grid .lottie-player:last-child {
    border-right: none;
  }

  /* ── Vertical rhythm: tiered spacing by adjacency ── */
  .case-study-body .zigzag-section,
  .case-study-body .accent-band,
  .case-study-body .cs-figure,
  .case-study-body .prose-group {
    padding-block: var(--space-6);
  }

  .case-study-body .cs-figure--flush {
    padding-block: 0;
  }

  .case-study-body .carousel {
    padding-block: 0;
  }

  /* Prose after prose: tighter grouping within a topic */
  .case-study-body .prose-group + .prose-group {
    padding-top: var(--space-3);
  }

  /* Visual after its prose intro: connected pair */
  .case-study-body .prose-group + .cs-figure:not(.cs-figure--flush),
  .case-study-body .prose-group + .image-pair {
    padding-top: var(--space-4);
  }

  /* New prose section after a visual: topic shift */
  .case-study-body :is(.cs-figure, .image-pair) + .prose-group {
    padding-top: var(--space-7);
  }

  /* ── Mobile ── */
  @media (--2x) {
    .case-study-cta-content {
      grid-column: 1 / -1;
      padding-inline: var(--content-inset-sm);
      padding-block: var(--space-5);
    }


    .case-study-body > h1,
    .case-study-body > h2,
    .case-study-body > h3,
    .case-study-body > p,
    .case-study-body > ul,
    .case-study-body > ol,
    .case-study-body > blockquote,
    .case-study-body .prose-group {
      grid-column: 1 / -1;
      padding-inline: var(--content-inset-sm);
    }

    .case-study-body .zigzag-section {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .case-study-body .zigzag-media,
    .case-study-body .zigzag-prose {
      padding-inline: 0;
    }

    .case-study-body .zigzag-media {
      border-radius: 0;
    }

    .case-study-body .zigzag-prose {
      padding-inline: var(--content-inset-sm);
    }

    .case-study-body img {
      max-height: none;
    }

    /* Remove box borders on mobile — use horizontal dividers instead */
    .case-study-body .cs-hero-meta,
    .case-study-body .image-pair,
    .case-study-body .carousel,
    .case-study-body .zigzag-section,
    .case-study-body > .cs-figure,
    .case-study-body .image-grid,
    .case-study-body > img,
    .case-study-body .accent-band {
      border: none;
      border-top: var(--border-width-1) solid var(--color-rule);
      border-bottom: var(--border-width-1) solid var(--color-rule);
    }

    /* Collapse doubled borders on mobile too */
    .case-study-body :is(.cs-hero-image, .cs-hero-meta, .image-pair, .carousel, .zigzag-section, .cs-figure, .image-grid, .accent-band, .lottie-grid)
    + :is(.cs-hero-meta, .image-pair, .carousel, .zigzag-section, .cs-figure, .image-grid, .accent-band, .lottie-grid) {
      margin-top: calc(-1 * var(--border-width-1));
    }

    /* Figures inside grids/zigzags: no extra borders */
    .case-study-body .image-grid .cs-figure,
    .case-study-body .zigzag-media .cs-figure {
      border: none;
    }

    .case-study-body .image-pair,
    .case-study-body .image-grid {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 0;
      background: none;
    }

    /* Divider line between stacked images */
    .case-study-body .image-pair > *:not(:first-child),
    .case-study-body .image-pair-cell:not(:first-child),
    .case-study-body .image-grid > *:not(:first-child) {
      border-top: var(--border-width-1) solid var(--color-rule);
      border-left: none;
    }

    .case-study-body .lottie-grid {
      grid-template-columns: repeat(2, 1fr);
      border-left: none;
      border-right: none;
    }

    .case-study-body .lottie-grid .lottie-player:nth-child(2) {
      border-right: none;
    }

    .case-study-body .lottie-grid .lottie-player:nth-child(n+3) {
      border-top: var(--border-width-1) solid var(--color-text-primary);
    }

    .case-study-body .cs-hero-meta {
      display: flex;
      flex-direction: column;
    }

    .case-study-body .cs-meta-item {
      flex: none;
    }

    .case-study-body .cs-meta-item + .cs-meta-item {
      border-left: none;
      border-top: var(--border-width-1) solid var(--color-rule);
    }

  }

  /* ── Scroll progress bar ── */
  .scroll-progress {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-accent-1);
    z-index: var(--z-nav, 100);
    pointer-events: none;
    transition: none;
    transform: scaleX(0);
    transform-origin: left;
  }

</style>


<script>
  const mobileQuery = window.matchMedia('(max-width: 768px)') /* matches @custom-media --2x */

  function sizeImagePairs() {
    const isMobile = mobileQuery.matches
    document.querySelectorAll<HTMLElement>('.image-pair').forEach(pair => {
      const imgs = pair.querySelectorAll('img')
      if (imgs.length !== 2) return

      if (isMobile) {
        pair.style.gridTemplateColumns = ''
        return
      }

      const ratios = Array.from(imgs).map(img => {
        const w = parseInt(img.getAttribute('width') ?? '') || img.naturalWidth
        const h = parseInt(img.getAttribute('height') ?? '') || img.naturalHeight
        return w && h ? w / h : 0
      })

      if (ratios[0] > 0 && ratios[1] > 0) {
        pair.style.gridTemplateColumns = `${ratios[0]}fr ${ratios[1]}fr`
      }
    })
  }

  sizeImagePairs()
  mobileQuery.addEventListener('change', sizeImagePairs)
  document.addEventListener('astro:page-load', sizeImagePairs)
  document.addEventListener('astro:before-swap', () => {
    mobileQuery.removeEventListener('change', sizeImagePairs)
  }, { once: true })
</script>

<script>
  function detectTransparentImages() {
    const body = document.querySelector('.case-study-body')
    if (!body) return

    body.querySelectorAll<HTMLImageElement>('img').forEach(img => {
      if (img.classList.contains('mosaic-media') || img.classList.contains('has-transparency') || img.dataset.transparencyChecked) return

      const check = () => {
        if (!img.naturalWidth) return
        try {
          const canvas = document.createElement('canvas')
          canvas.width = Math.min(img.naturalWidth, 100)
          canvas.height = Math.min(img.naturalHeight, 100)
          const ctx = canvas.getContext('2d')
          if (!ctx) return
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height)
          const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data
          // Sample corner pixels for alpha < 255
          const corners = [
            3,                                          // top-left
            (canvas.width - 1) * 4 + 3,               // top-right
            (canvas.height - 1) * canvas.width * 4 + 3, // bottom-left
            ((canvas.height - 1) * canvas.width + canvas.width - 1) * 4 + 3, // bottom-right
          ]
          const hasAlpha = corners.some(i => data[i] < 250)
          if (hasAlpha) {
            img.classList.add('has-transparency')
          }
        } finally {
          img.dataset.transparencyChecked = 'true'
        }
      }
      if (img.complete) check()
      else img.addEventListener('load', check, { once: true })
    })
  }

  detectTransparentImages()
  document.addEventListener('astro:page-load', detectTransparentImages)
</script>
