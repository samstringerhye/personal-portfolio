---
import type { SubjectBox } from '../components/narrow-art'
import BaseLayout from './BaseLayout.astro'
import CaseStudyNav from '../components/CaseStudyNav.astro'
import CaseStudyHero from '../components/CaseStudyHero.astro'
import DeviceHero from '../components/DeviceHero.astro'
import type { SceneName } from '../components/DeviceScene.astro'
import ContactEmail from '../components/ContactEmail.astro'
import BackToWork from '../components/BackToWork.astro'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  tagline?: string
  ogImage?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  prevSlug?: string
  prevTitle?: string
  prevLocked?: boolean
  nextSlug?: string
  nextTitle?: string
  nextLocked?: boolean
  noindex?: boolean
  heroLayers?: { subject: ImageMetadata; background: string; heroOffset?: number; subjectBox?: SubjectBox; subjectBounds?: SubjectBox }
  heroAlt?: string
  heroYear?: number | string
  // The homepage card's tags, shown beside the year on a device hero as on its card
  heroTags?: string[]
  heroTone?: 'light' | 'dark'
  // A coded device scene: the hero is the live device, carried over from its homepage card
  heroScene?: SceneName
  // Locked password-protected case study: hero with the password form, no body, CTA or pager
  gate?: { error?: boolean; rateLimited?: boolean }
}

const { title, tagline, ogImage, jsonLd, prevSlug, prevTitle, prevLocked, nextSlug, nextTitle, nextLocked, noindex, heroLayers, heroAlt, heroYear, heroTags, heroTone, heroScene, gate } = Astro.props
// The device hero has no password form, so a locked case study keeps the framed hero
const deviceHero = heroScene && !gate
---

<BaseLayout title={`${title} | Sam Stringer-Hye`} description={tagline} ogImage={ogImage} jsonLd={jsonLd} noindex={noindex}>
  {!gate && <div class="scroll-progress" aria-hidden="true"></div>}
  <div class="cs-back" transition:persist="cs-back"><BackToWork /></div>
  <div class="case-study-layout">
    <article class="case-study-body">
      {deviceHero && <DeviceHero scene={heroScene} label={heroAlt ?? title} title={title} tagline={tagline} year={heroYear} tags={heroTags} />}
      {heroLayers && !deviceHero && <CaseStudyHero subject={heroLayers.subject} background={heroLayers.background} heroOffset={heroLayers.heroOffset} subjectBox={heroLayers.subjectBox} subjectBounds={heroLayers.subjectBounds} alt={heroAlt ?? title} title={title} tagline={tagline} year={heroYear} tone={heroTone} gate={gate} />}
      {!gate && <div class="case-study-content"><slot /></div>}
    </article>

    {!gate && <section class="case-study-cta" aria-labelledby="case-study-cta-heading">
      <hr class="section-rule" />
      <div class="case-study-cta-content">
        <h2 id="case-study-cta-heading" class="typo-headline-sm">Want to talk about this work?</h2>
        <ContactEmail class="case-study-cta-link typo-body-lg" />
      </div>
    </section>}

    {!gate && <CaseStudyNav
      prevSlug={prevSlug}
      prevTitle={prevTitle}
      prevLocked={prevLocked}
      nextSlug={nextSlug}
      nextTitle={nextTitle}
      nextLocked={nextLocked}
    />}
  </div>
</BaseLayout>

<style is:global>
  .case-study-layout,
  .case-study-body,
  .case-study-content {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }

  .case-study-layout,
  .case-study-content {
    row-gap: var(--cs-section-gap);
  }

  .case-study-body {
    row-gap: var(--cs-hero-gap);
  }

  /* ── Contact CTA ── */
  .case-study-cta {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }

  .case-study-cta .section-rule {
    grid-column: 1 / -1;
  }

  .case-study-cta-content {
    grid-column: 2 / 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cs-heading-gap);
    padding: var(--cs-callout-inset);
  }

  /* The end-of-study contact, styled as a button so it reads as the next step */
  .case-study-cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: var(--space-1) var(--space-4);
    color: var(--color-text-primary);
    text-decoration: none;
    border: 0;
    background: var(--ek-surface, var(--color-bg-primary));
    transition: background-color var(--duration-short) ease, color var(--duration-short) ease;
  }

  @media (hover: hover) {
    .case-study-cta-link:hover {
      color: var(--color-bg-primary);
      background: var(--color-text-primary);
    }
  }

  @media (--1x) {
    .case-study-cta-link {
      align-self: stretch;
    }
  }

  /* Layout, spacing and the visual panels: editorial.css (html.ek) */

  /* Case study artwork scrolls beneath the sticky header. Keep the navigation readable while
     figures and motion panels pass behind it; the homepage keeps its transparent hero treatment. */
  html.ek:has(.case-study-body) .nav {
    background: var(--color-bg-primary);
  }

  .case-study-body .carousel-track {
    cursor: grab;
  }
  .case-study-body .carousel-track.is-dragging {
    cursor: grabbing;
  }

  .case-study-body img:where(:not(.device-screen)):where(:not(.device-frame)):where(:not(.browser-screen)):where(:not(.mosaic-media)) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100vh;
    object-fit: contain;
  }

  .case-study-body img.has-transparency:not(.mosaic-media) {
    padding: var(--space-6);
    object-fit: contain;
  }

  /* Slides share one height, so no padding on the transparent ones */
  .case-study-body .carousel-track img.has-transparency {
    padding: 0;
  }

  .case-study-body ul {
    list-style: disc;
    padding-left: 1.25em;
  }

  .case-study-body li {
    margin-bottom: var(--space-1);
  }

  .evidence-note {
    grid-column: 1 / -1;
    max-width: 65ch;
    color: var(--ek-ink-body);
    font-size: var(--text-100);
    line-height: 1.5;
  }

  .motion-caption {
    padding: 0 var(--space-3) var(--space-3);
    color: white;
    text-align: center;
    font-size: var(--text-100);
  }

  /* ── Lottie grid: 4 columns, 2 on phones ── */
  .case-study-body .lottie-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .case-study-body .lottie-grid .lottie-player {
    padding: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (--2x) {
    .case-study-cta-content {
      grid-column: 1 / -1;
    }

    .case-study-body img {
      max-height: none;
    }

    .case-study-body .image-pair,
    .case-study-body .image-grid {
      grid-template-columns: 1fr !important;
    }

    .case-study-body .lottie-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Scroll progress bar ── */
  .scroll-progress {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-accent-1);
    z-index: var(--z-nav, 100);
    pointer-events: none;
    transition: none;
    transform: scaleX(0);
    transform-origin: left;
  }

</style>


<script>
  const mobileQuery = window.matchMedia('(max-width: 768px)') /* matches @custom-media --2x */

  function sizeImagePairs() {
    const isMobile = mobileQuery.matches
    document.querySelectorAll<HTMLElement>('.image-pair').forEach(pair => {
      const imgs = pair.querySelectorAll('img')
      if (imgs.length !== 2) return

      if (isMobile) {
        pair.style.gridTemplateColumns = ''
        return
      }

      const ratios = Array.from(imgs).map(img => {
        // A laptop is as wide as its screen, whatever page it shows
        if (img.closest('.device-mock--laptop')) return 1.6
        // Mockups set their own shape: a browser window is wide, a phone narrow
        if (img.closest('.mock--browser')) return 1.8
        if (img.closest('.mock--phone')) return 0.8
        const w = parseInt(img.getAttribute('width') ?? '') || img.naturalWidth
        const h = parseInt(img.getAttribute('height') ?? '') || img.naturalHeight
        return w && h ? w / h : 0
      })

      if (ratios[0] > 0 && ratios[1] > 0) {
        pair.style.gridTemplateColumns = `${ratios[0]}fr ${ratios[1]}fr`
      }
    })
  }

  sizeImagePairs()
  mobileQuery.addEventListener('change', sizeImagePairs)
  document.addEventListener('astro:page-load', sizeImagePairs)
</script>

<script>
  function detectTransparentImages() {
    const body = document.querySelector('.case-study-body')
    if (!body) return

    body.querySelectorAll<HTMLImageElement>('img').forEach(img => {
      // Device frames are transparent by design and sized by their own component; padding them shrinks the bezel
      if (img.classList.contains('mosaic-media') || img.classList.contains('device-frame') || img.classList.contains('device-screen') || img.classList.contains('has-transparency') || img.dataset.transparencyChecked) return

      const check = () => {
        if (!img.naturalWidth) return
        try {
          const canvas = document.createElement('canvas')
          canvas.width = Math.min(img.naturalWidth, 100)
          canvas.height = Math.min(img.naturalHeight, 100)
          const ctx = canvas.getContext('2d')
          if (!ctx) return
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height)
          const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data
          // Sample corner pixels for alpha < 255
          const corners = [
            3,                                          // top-left
            (canvas.width - 1) * 4 + 3,               // top-right
            (canvas.height - 1) * canvas.width * 4 + 3, // bottom-left
            ((canvas.height - 1) * canvas.width + canvas.width - 1) * 4 + 3, // bottom-right
          ]
          const hasAlpha = corners.some(i => data[i] < 250)
          if (hasAlpha) {
            img.classList.add('has-transparency')
          }
        } finally {
          img.dataset.transparencyChecked = 'true'
        }
      }
      if (img.complete) check()
      else img.addEventListener('load', check, { once: true })
    })
  }

  detectTransparentImages()
  document.addEventListener('astro:page-load', detectTransparentImages)
</script>
