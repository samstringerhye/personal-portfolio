---
import type { ImageMetadata } from 'astro'
interface Props {
  src: ImageMetadata
  /** Coordinates in source pixels; the original asset remains unchanged. */
  x: number
  y: number
  width: number
  height: number
  alt: string
  maxWidth?: string
}
const { src, x, y, width, height, alt, maxWidth = '48rem' } = Astro.props
if (x < 0 || y < 0 || width <= 0 || height <= 0 || x + width > src.width || y + height > src.height) {
  throw new Error(`EvidenceCrop: crop exceeds source bounds for ${src.src}`)
}
---
<div class="evidence-crop" style={`aspect-ratio: ${width} / ${height}; max-width: ${maxWidth}`}>
  <img src={src.src} alt={alt} width={src.width} height={src.height} loading="lazy" decoding="async"
    style={`width: ${src.width / width * 100}%; left: ${-x / width * 100}%; top: ${-y / height * 100}%`} />
</div>
<style>
  .evidence-crop {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin-inline: auto;
  }
  /* Keep the source crop independent of global image caps and transparent-image padding. */
  :global(html.ek .case-study-body) .evidence-crop img {
    position: absolute;
    display: block;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border-radius: 0;
  }
</style>
