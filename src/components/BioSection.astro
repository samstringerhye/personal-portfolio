---
import type { HeadingTag, TextTag, TypographyRole } from '../types/typography'

interface Props {
  headline: string
  body: string
  headlineTag?: HeadingTag
  headlineRole?: TypographyRole
  bodyTag?: TextTag
  bodyRole?: TypographyRole
}

const {
  headline, body,
  headlineTag = 'h2', headlineRole = 'display',
  bodyTag = 'p', bodyRole = 'subhead',
} = Astro.props as Props
const HeadlineTag = headlineTag as any
const BodyTag = bodyTag as any

---

<section class="bio-section" aria-label="About">
  <div class="bio-inner" data-reveal-group>
    <div class="bio-left">
      <HeadlineTag class:list={["bio-headline", `typo-${headlineRole}`]} data-reveal>{headline}</HeadlineTag>
    </div>
    <div class="bio-divider"></div>
    <div class="bio-right">
      <BodyTag class:list={["bio-text", `typo-${bodyRole}`]} data-reveal>{body}</BodyTag>
    </div>
  </div>
</section>

<style>
  .bio-section {
    position: relative;
    z-index: 1;
  }

  .bio-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    width: 100%;
  }

  .bio-left {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--content-inset-md);
    min-width: 0;
  }

  .bio-headline {
    color: var(--color-text-primary);
    margin: 0;
    width: 100%;
    min-width: 0;
    opacity: 1;
    filter: none;
  }

  .bio-divider {
    width: var(--border-width-1);
    background: var(--color-rule);
  }

  .bio-right {
    position: relative;
    display: flex;
    align-items: center;
    padding: var(--content-inset-md);
  }

  .bio-text {
    color: var(--color-text-primary);
    margin: 0;
    width: 100%;
  }

  .bio-text {
    opacity: 0;
    filter: blur(var(--bioInitBlur));
  }

  @media (--2x) {
    .bio-inner {
      grid-template-columns: 1fr;

    }

    .bio-left {
      justify-content: flex-start;
      padding: var(--content-inset-sm);
    }

    .bio-right {
      padding: var(--content-inset-sm);
    }

    .bio-divider {
      width: auto;
      height: var(--border-width-1);
      margin-inline: calc(var(--page-margin) * -1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-headline,
    .bio-text {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
