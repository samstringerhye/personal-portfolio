---
// Goes to the homepage work list. Any link to "/" also plays the hero → card zoom (work-transition.ts).
interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<a href="/#work" class:list={['back-to-work', className]} aria-label="All work" data-astro-prefetch="hover">
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16.5 10H3.5M8.5 5l-5 5 5 5" />
  </svg>
  <span>All work</span>
</a>

<style>
  .back-to-work {
    width: auto;
    gap: var(--space-2);
    padding-inline: var(--space-2);
    border-radius: 0;
    font-size: var(--text-100);
  }
</style>
