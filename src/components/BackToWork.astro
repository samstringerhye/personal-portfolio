---
// Goes to the homepage work list. Any link to "/" also plays the hero → card zoom (work-transition.ts).
interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<a href="/#work" class:list={['back-to-work', className]} aria-label="Back to work" data-astro-prefetch="hover">
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16.5 10H3.5M8.5 5l-5 5 5 5" />
  </svg>
</a>
