---
// Goes to the homepage work list, or back in history when the case study was opened from it (back-to-work.ts).
interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<a href="/#work" class:list={['back-to-work', className]} aria-label="All work" data-astro-prefetch="hover">
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16.5 10H3.5M8.5 5l-5 5 5 5" />
  </svg>
</a>

<script>
  import './back-to-work'

  // The button floats over the case study, so it steps out of the way while reading down the page
  // (past the hero) and comes back on any scroll up. global.css .cs-back[data-away]
  let lastY = window.scrollY
  window.addEventListener('scroll', () => {
    const y = window.scrollY
    if (Math.abs(y - lastY) < 4) return
    document.querySelector('.cs-back')?.toggleAttribute('data-away', y > lastY && y > window.innerHeight / 2)
    lastY = y
  }, { passive: true })
  document.addEventListener('astro:page-load', () => {
    lastY = window.scrollY
    document.querySelector('.cs-back')?.removeAttribute('data-away')
  })
</script>
