---
// The address is assembled in the browser, so it never appears in the HTML or the source for scrapers to read.
// The link reads "Email me" (or the address, with showAddress) and its destination is filled in.
interface Props {
  class?: string
  // Show the address as the link text once it is filled in (still absent from the HTML)
  showAddress?: boolean
  // Prefills the draft's subject line
  subject?: string
  // Link text other than "Email me"
  label?: string
}
const { class: className, showAddress, subject, label = 'Email me' } = Astro.props
---

<a data-contact-email data-show-address={showAddress ? '' : undefined} data-contact-subject={subject} class={className}>{label}</a>

<script>
  import './contact-email'
</script>
