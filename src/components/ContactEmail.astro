---
// The address is assembled in the browser, so it never appears in the HTML or the source for scrapers to read.
// The link reads "Email me" and only its destination is filled in.
interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<a data-contact-email class={className}>Email me</a>

<script>
  const user = 'hello'
  const host = ['samstringerhye', 'com'].join('.')

  function fill() {
    document.querySelectorAll<HTMLAnchorElement>('a[data-contact-email]').forEach((link) => {
      link.href = `mailto:${user}@${host}`
    })
  }

  fill()
  document.addEventListener('astro:page-load', fill)
</script>
