---
/**
 * The outcome's numbers: each a figure in the serif and a plain label under it. Real results only;
 * where a project has none, real scope facts (markets, page types, screens) stand in.
 */
interface Props {
  items: { value: string; label: string }[]
  variant?: 'metrics' | 'summary'
}

const { items, variant = 'metrics' } = Astro.props
---

<dl class:list={['cs-metrics', variant === 'summary' && 'cs-metrics--summary']}>
  {items.map(m => (
    <div class="cs-metric">
      <dt class="cs-metric-value">{m.value}</dt>
      <dd class="cs-metric-label">{m.label}</dd>
    </div>
  ))}
</dl>

<style>
  /* The outcome bar: across the viewport like the details bar under the hero, hairlines above and
     below that reach the window's edges, the figures centered in equal columns */
  .cs-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: var(--cs-block-gap) var(--grid-gutter);
    margin: 0;
    padding: var(--cs-block-gap) 0;
    border-style: solid;
    border-width: 1px 0;
    border-image: linear-gradient(var(--ek-hairline, #e6eaee) 0 0) 1 / 1px 0 / 0 100vw;
  }

  .cs-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cs-caption-gap);
    text-align: center;
  }

  .cs-metric-value {
    font-family: var(--font-serif);
    font-size: var(--text-500);
    font-weight: 300;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .cs-metric-label {
    max-width: 16rem;
    margin: 0;
    font-size: var(--text-100);
    line-height: var(--line-height-normal);
    color: var(--ek-ink-body);
  }

  .cs-metrics--summary {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .cs-metrics--summary .cs-metric {
    align-items: flex-start;
    text-align: left;
    gap: var(--cs-label-gap);
  }

  .cs-metrics--summary .cs-metric-value {
    font-size: var(--text-200);
    line-height: 1.2;
  }

  .cs-metrics--summary .cs-metric-label {
    font-size: var(--text-75);
    line-height: 1.6;
  }

  @media (max-width: 48rem) {
    .cs-metrics--summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 24rem) {
    .cs-metrics--summary {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
