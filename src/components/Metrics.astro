---
/**
 * The outcome's numbers: each a figure in the serif and a plain label under it. Real results only;
 * where a project has none, real scope facts (markets, page types, screens) stand in.
 */
interface Props {
  items: { value: string; label: string }[]
}

const { items } = Astro.props
---

<dl class="cs-metrics">
  {items.map(m => (
    <div class="cs-metric">
      <dt class="cs-metric-value">{m.value}</dt>
      <dd class="cs-metric-label">{m.label}</dd>
    </div>
  ))}
</dl>

<style>
  .cs-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-5) var(--grid-gutter);
    margin: 0;
  }

  .cs-metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--ek-hairline, #e6eaee);
  }

  .cs-metric-value {
    font-family: var(--font-serif);
    font-size: var(--text-500);
    font-weight: 300;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .cs-metric-label {
    margin: 0;
    font-size: var(--text-100);
    line-height: var(--line-height-normal);
    color: var(--ek-ink-body);
  }
</style>
