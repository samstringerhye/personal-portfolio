---
/**
 * Real benchmark data: average component nesting depth across the production
 * design systems indexed into the same database. Amica came back deepest, which
 * is what made shallow nesting a hard constraint. Source: Sam's
 * cross-system-research.md (7 systems have recorded depth; the other 7 of the 14
 * were indexed for node counts only, so they are not charted here).
 */

const systems = [
  { name: 'Amica', avg: 12.5, max: 29, self: true },
  { name: 'MUI', avg: 10.4, max: 22, self: false },
  { name: 'Carbon', avg: 8.8, max: 21, self: false },
  { name: 'Atlassian', avg: 8.7, max: 21, self: false },
  { name: 'Primer', avg: 6.7, max: 17, self: false },
  { name: 'Simple DS', avg: 6.5, max: 14, self: false },
  { name: 'Ant Design', avg: 5.6, max: 21, self: false },
]
const scaleMax = 13
---

<section class="bench" aria-label="Average nesting depth across benchmarked design systems">
  <div class="bench-head">
    <span class="bench-title">Average component nesting depth</span>
    <span class="bench-note">14 systems indexed · 1.4M nodes · depth recorded for 7</span>
  </div>

  <ul class="bench-rows">
    {systems.map((s) => (
      <li class:list={["bench-row", { "bench-row--self": s.self }]}>
        <span class="bench-name">{s.name}</span>
        <span class="bench-track">
          <span class="bench-bar" style={`width:${(s.avg / scaleMax) * 100}%`}></span>
        </span>
        <span class="bench-val">{s.avg}<span class="bench-max">max {s.max}</span></span>
      </li>
    ))}
  </ul>

  <p class="bench-foot">Amica nested deepest of every system with recorded depth. That is what made shallow nesting a hard constraint for the rebuild, not a preference.</p>
</section>

<style>
  .bench {
    background: var(--color-bg-primary);
    border-top: var(--border-width-1) solid var(--color-text-primary);
    border-bottom: var(--border-width-1) solid var(--color-text-primary);
    padding: var(--space-6, 2rem);
    margin-block: var(--space-6, 2rem);
    font-family: var(--font-primary);
  }

  .bench-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .bench-title { font-size: var(--text-100); font-weight: 700; color: var(--color-text-primary); }
  .bench-note { font-size: var(--text-75); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary, #667); }

  .bench-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .bench-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr 4.5rem;
    align-items: center;
    gap: 0.75rem;
  }
  .bench-name { font-size: var(--text-100); color: var(--color-text-secondary, #667); text-align: right; }
  .bench-row--self .bench-name { color: var(--color-text-primary); font-weight: 700; }

  .bench-track {
    height: 22px;
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    border-radius: 4px;
    overflow: hidden;
  }
  .bench-bar {
    display: block;
    height: 100%;
    background: color-mix(in srgb, var(--color-text-primary) 22%, transparent);
    border-radius: 4px;
  }
  .bench-row--self .bench-bar { background: #00a88f; }

  .bench-val {
    font-size: var(--text-100);
    font-weight: 700;
    color: var(--color-text-primary);
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .bench-max { font-size: var(--text-75); font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-secondary, #667); }

  .bench-foot { margin: 1.25rem 0 0; font-size: var(--text-100); color: var(--color-text-secondary, #667); max-width: 44rem; }

  @media (max-width: 560px) {
    .bench-row { grid-template-columns: 4.5rem 1fr 3.5rem; gap: 0.5rem; }
  }
</style>
