---
import '../../styles/amica-tokens.css'
/**
 * Before/After comparison of the Amica design system migration.
 * Visualizes inherited library problems vs rebuilt self-contained system.
 * Mirrors SystemBeforeAfter.astro structure exactly with GSAP animations.
 */
---

<section class="amica-ba" aria-label="Amica design system before and after comparison">
  <div class="ba-grid">
    <div class="ba-col ba-before">
      <div class="ba-label">Before</div>
      <h4 class="ba-title">Inherited Library</h4>
      <ul class="ba-list">
        <li class="ba-item ba-problem">
          <span class="ba-icon">✕</span>
          <div>
            <strong>3,044 off-library references</strong>
            <span class="ba-detail">Some abandoned mid-migration, some never published</span>
          </div>
        </li>
        <li class="ba-item ba-problem">
          <span class="ba-icon">✕</span>
          <div>
            <strong>61 dead component masters</strong>
            <span class="ba-detail">Instances still on canvas with no live source</span>
          </div>
        </li>
        <li class="ba-item ba-problem">
          <span class="ba-icon">✕</span>
          <div>
            <strong>No token system</strong>
            <span class="ba-detail">Hardcoded hex, duplicated into Primary Light / Primary Dark variants</span>
          </div>
        </li>
        <li class="ba-item ba-problem">
          <span class="ba-icon">✕</span>
          <div>
            <strong>Deliverable-first organization</strong>
            <span class="ba-detail">314,000 nodes grouped by page type, not component</span>
          </div>
        </li>
      </ul>
    </div>

    <div class="ba-divider" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M5 12h14m0 0l-6-6m6 6l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <div class="ba-col ba-after">
      <div class="ba-label">After: rebuilt architecture</div>
      <h4 class="ba-title">Self-Contained System</h4>
      <ul class="ba-list">
        <li class="ba-item ba-success">
          <span class="ba-icon">✓</span>
          <div>
            <strong>Single source of truth</strong>
            <span class="ba-detail">Every reference resolves back to the library</span>
          </div>
        </li>
        <li class="ba-item ba-success">
          <span class="ba-icon">✓</span>
          <div>
            <strong>61 masters restored</strong>
            <span class="ba-detail">Zero visual regressions, verified by independent re-index</span>
          </div>
        </li>
        <li class="ba-item ba-success">
          <span class="ba-icon">✓</span>
          <div>
            <strong>Two-tier token architecture</strong>
            <span class="ba-detail">54 semantic tokens across Light and Dark mode</span>
          </div>
        </li>
        <li class="ba-item ba-success">
          <span class="ba-icon">✓</span>
          <div>
            <strong>209 component sets</strong>
            <span class="ba-detail">Composed freely across templates without new variants</span>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <div class="ba-stats">
    <div class="ba-stat">
      <span class="ba-stat-number" data-target="209">209</span>
      <span class="ba-stat-label">Component Sets</span>
    </div>
    <div class="ba-stat">
      <span class="ba-stat-number" data-target="464">464</span>
      <span class="ba-stat-label">Local Variables</span>
    </div>
    <div class="ba-stat">
      <span class="ba-stat-number" data-target="97" data-suffix="%">97%</span>
      <span class="ba-stat-label">Cascade Success</span>
    </div>
    <div class="ba-stat">
      <span class="ba-stat-number" data-target="100" data-suffix="%">100%</span>
      <span class="ba-stat-label">Padding Compliance</span>
    </div>
  </div>
</section>

<style>
  .amica-ba {
    --amica-warm-neutral: var(--amica-cream);
    --amica-bg: var(--amica-light-mint);

    background: var(--color-bg-primary);
    border-top: var(--border-width-1) solid var(--color-text-primary);
    border-bottom: var(--border-width-1) solid var(--color-text-primary);
    padding-block: var(--space-6);
    padding-inline: var(--space-6);
    margin-block: var(--space-6);
  }

  .ba-grid {
    display: flex;
    gap: 1rem;
    align-items: stretch;
  }

  .ba-col {
    flex: 1;
    padding: 1.5rem;
    background: white;
    border: 1px solid var(--amica-mint);
  }

  .ba-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }

  .ba-before .ba-label {
    color: var(--color-text-secondary, #667);
  }

  .ba-after .ba-label {
    color: var(--amica-teal);
  }

  .ba-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--amica-mint);
  }

  .ba-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ba-item {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text-primary);
  }

  .ba-item div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .ba-detail {
    font-size: 0.75rem;
    color: var(--color-text-secondary, #667);
  }

  .ba-detail code {
    font-family: var(--font-primary);
    font-size: 0.72rem;
    background: var(--amica-bg);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  .ba-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 700;
    margin-top: 1px;
  }

  .ba-problem .ba-icon {
    background: var(--color-bg-primary);
    color: var(--color-text-secondary, #667);
  }

  .ba-success .ba-icon {
    background: var(--color-accent-2, var(--amica-teal));
    color: white;
  }

  .ba-divider {
    display: flex;
    align-items: center;
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .ba-stats {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--amica-mint);
  }

  .ba-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .ba-stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1;
  }

  .ba-stat-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary, #667);
  }

  @media (max-width: 768px) {
    .ba-grid {
      flex-direction: column;
      gap: 0.5rem;
    }

    .ba-divider {
      justify-content: center;
      transform: rotate(90deg);
    }

    .amica-ba {
      padding-inline: var(--space-4);
    }

    .ba-stats {
      gap: 1.5rem;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  let ctx: { revert: () => void } | null = null

  async function initAmicaBA() {
    const container = document.querySelector('.amica-ba') as HTMLElement | null
    if (!container || container.dataset.baInit === 'true') return
    container.dataset.baInit = 'true'

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Show final state immediately
      container.querySelectorAll<HTMLElement>('.ba-stat-number').forEach(el => {
        const target = el.dataset.target || '0'
        const suffix = el.dataset.suffix || ''
        el.textContent = target + suffix
      })
      return
    }

    const { default: gsap } = await import('gsap')
    const { ScrollTrigger } = await import('gsap/ScrollTrigger')
    gsap.registerPlugin(ScrollTrigger)

    ctx?.revert()
    ctx = gsap.context(() => {
      const grid = container.querySelector('.ba-grid')
      const stats = container.querySelector('.ba-stats')

      gsap.from(container.querySelectorAll('.ba-item'), {
        y: 20,
        opacity: 0,
        duration: 0.5,
        stagger: 0.08,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: grid,
          start: 'top 80%',
        }
      })

      container.querySelectorAll<HTMLElement>('.ba-stat-number').forEach(el => {
        const target = parseInt(el.dataset.target || '0', 10)
        const suffix = el.dataset.suffix || ''
        const obj = { val: 0 }
        // Markup carries the final value for crawlers and no-JS; count up from zero here
        el.textContent = '0' + suffix

        gsap.to(obj, {
          val: target,
          duration: 2,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: stats,
            start: 'top 85%',
          },
          onUpdate() {
            el.textContent = Math.round(obj.val) + suffix
          },
        })
      })
    })
  }

  initAmicaBA()
  document.addEventListener('astro:page-load', initAmicaBA)
  document.addEventListener('astro:before-swap', () => { ctx?.revert(); ctx = null })
</script>
