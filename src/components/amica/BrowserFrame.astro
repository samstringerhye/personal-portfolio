---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  alt: string
  url?: string
}

const { src, alt, url = 'amica.com' } = Astro.props
---

<div class="browser-frame">
  <div class="browser-chrome">
    <span class="browser-dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="browser-url">{url}</span>
  </div>
  <Image src={src} alt={alt} width={1600} format="webp" quality={90} loading="lazy" class="browser-screen" />
</div>

<style>
  .browser-frame {
    border: var(--border-width-1) solid var(--color-text-primary);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    background: var(--color-bg-primary);
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--border-width-1) solid var(--color-text-primary);
  }

  .browser-dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .browser-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.25;
  }

  .browser-url {
    flex: 1;
    font-family: var(--font-primary);
    font-size: var(--text-100);
    color: var(--color-text-secondary, currentColor);
    background: rgba(0, 0, 0, 0.04);
    border-radius: var(--radius-full, 9999px);
    padding: 0.25rem 0.75rem;
    text-align: center;
    max-width: 320px;
    margin-inline: auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-frame :global(.browser-screen) {
    display: block;
    width: 100%;
    /* Uniform crop so every framed screenshot is the same height, whatever the
       source aspect. Anchored top left: the above-the-fold region, and on a capture wider
       than 16:10 the logo and headline side, not a slice from the middle. */
    aspect-ratio: 16 / 10;
    height: auto;
    margin: 0;
    border: none;
    object-fit: cover;
    object-position: left top;
  }
</style>
