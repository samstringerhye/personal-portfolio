---
import type { ImageMetadata } from 'astro'
import BrowserFrame from './BrowserFrame.astro'

interface Props {
  src: string
  title: string
  label: string
  description?: string
  thumbnail: ImageMetadata
  thumbnailAlt: string
}

const { src, title, label, description, thumbnail, thumbnailAlt } = Astro.props
---

<figure class="cs-figure prototype-link">
  <a href={src} target="_blank" rel="noopener" aria-label={`${label}${description ? `. ${description}` : ''}`} title={title}>
    <BrowserFrame src={thumbnail} alt={thumbnailAlt} url="amica.com" />
    <span class="prototype-link-label" aria-hidden="true">Open live prototype ↗</span>
  </a>
</figure>

<style is:global>
  .prototype-link { position: relative; }
  .prototype-link a { display: block; color: inherit; text-decoration: none; }
  .prototype-link .browser-frame { border: none; border-radius: 0; }
  .prototype-link-label { position: absolute; right: var(--space-3); bottom: var(--space-3); display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 var(--space-2); background: var(--color-bg-primary); border: 0; font-size: var(--text-100); }
  .prototype-link a:hover .prototype-link-label { background: var(--color-text-primary); color: var(--color-bg-primary); }
  .prototype-link a:focus-visible { outline: none; }
  .prototype-link a:focus-visible .prototype-link-label { box-shadow: var(--focus-ring); }
</style>
