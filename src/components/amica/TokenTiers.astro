---
import '../../styles/amica-tokens.css'
/**
 * Token tier diagram for the Amica design system case study.
 * Shows the primitive-to-semantic token relationship.
 */
---

<section class="token-tiers" aria-label="Amica token tier diagram">
  <div class="flow">
    <div class="tier">
      <div class="tier-header">
        <span class="tier-number">1</span>
        <div>
          <h4 class="tier-title">Primitive</h4>
          <p class="tier-subtitle">Raw values, hidden from pickers</p>
        </div>
      </div>
      <ul class="token-list">
        <li><code>green/600</code> <span class="val">#00A88F</span></li>
        <li><code>green/900</code> <span class="val">#003D33</span></li>
        <li><code>neutral/1000</code> <span class="val">#001512</span></li>
        <li><code>gap/2xs</code> <span class="val">12px</span></li>
        <li><code>radius/xl</code> <span class="val">24px</span></li>
      </ul>
      <div class="tier-count">Construction material only</div>
    </div>

    <div class="arrow" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M5 12h14m0 0l-6-6m6 6l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <div class="tier">
      <div class="tier-header">
        <span class="tier-number">2</span>
        <div>
          <h4 class="tier-title">Semantic</h4>
          <p class="tier-subtitle">Purpose-driven aliases, organized by what you&apos;re painting</p>
        </div>
      </div>
      <ul class="token-list">
        <li><code>surface/interactive/default</code> <span class="ref">→ green/600</span></li>
        <li><code>content/on-canvas/action</code> <span class="ref">→ green/700</span></li>
        <li><code>border/feedback/error</code> <span class="val">#C4164A</span></li>
        <li><code>elevation/brand</code> <span class="ref">→ green/700, low alpha</span></li>
      </ul>
      <div class="tier-count">54 tokens across Light and Dark mode</div>
    </div>
  </div>

  <div class="why-box">
    <strong>Why?</strong> Change <code>green/600</code> once, every button fill, active tab, and focus ring updates automatically across both modes.
  </div>
</section>

<style>
  .token-tiers {
    --amica-ink: var(--amica-near-black);
    background: var(--color-bg-primary);
    border-top: var(--border-width-1) solid var(--color-text-primary);
    border-bottom: var(--border-width-1) solid var(--color-text-primary);
    padding-block: var(--space-6);
    padding-inline: var(--space-6);
    margin-block: var(--space-6);
  }

  .flow { display: flex; align-items: stretch; gap: 0.5rem; }
  .tier { flex: 1; background: white; border: 1px solid var(--amica-mint); padding: 1.25rem; display: flex; flex-direction: column; }
  .tier-header { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--amica-mint); }
  .tier-number { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; min-width: 28px; background: var(--amica-teal); color: white; border-radius: 50%; font-weight: 700; font-size: var(--text-100); }
  .tier-title { font-size: var(--text-100); font-weight: 700; color: var(--amica-forest); margin: 0; line-height: 1.2; }
  .tier-subtitle { font-size: var(--text-75); color: color-mix(in srgb, var(--amica-forest), white 35%); margin: 0.15rem 0 0; line-height: 1.3; }
  .token-list { list-style: none; margin: 0; padding: 0; flex: 1; display: flex; flex-direction: column; gap: 0.4rem; }
  .token-list li { display: flex; justify-content: space-between; align-items: center; font-size: var(--text-75); gap: 0.5rem; }
  .token-list code { font-family: var(--font-primary); font-size: var(--text-75); color: var(--amica-ink); background: var(--amica-light-mint); padding: 0.15rem 0.4rem; border-radius: 4px; white-space: nowrap; }
  .val, .ref { font-family: var(--font-primary); font-size: var(--text-75); text-align: right; }
  .val { color: var(--amica-forest); }
  .ref { color: var(--amica-jungle); }
  .tier-count { margin-top: 0.75rem; padding-top: 0.5rem; border-top: 1px solid var(--amica-mint); font-size: var(--text-75); color: var(--amica-forest); text-align: center; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .arrow { display: flex; align-items: center; color: var(--amica-teal); flex-shrink: 0; }
  .why-box { margin-top: 1.25rem; padding: 0.85rem 1rem; background: white; border-left: 3px solid var(--amica-teal); font-size: var(--text-100); color: var(--amica-forest); line-height: 1.5; }
  .why-box code { font-family: var(--font-primary); font-size: var(--text-75); background: var(--amica-light-mint); padding: 0.1rem 0.35rem; border-radius: 3px; }

  @media (max-width: 768px) {
    .flow { flex-direction: column; gap: 0.25rem; }
    .arrow { justify-content: center; transform: rotate(90deg); }
    .token-tiers { padding-inline: var(--space-4); }
  }

  @media (max-width: 480px) {
    .token-list li { align-items: flex-start; flex-direction: column; gap: 0.15rem; }
    .val, .ref { text-align: left; }
  }
</style>

<script>
  import { animations } from '../../data/tokens'

  let ctx: { revert: () => void } | null = null

  async function initTokenTiers() {
    const container = document.querySelector('.token-tiers') as HTMLElement | null
    if (!container || container.dataset.tiersInit === 'true') return
    container.dataset.tiersInit = 'true'

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const { default: gsap } = await import('gsap')
    const { ScrollTrigger } = await import('gsap/ScrollTrigger')
    gsap.registerPlugin(ScrollTrigger)

    ctx?.revert()
    ctx = gsap.context(() => {
      gsap.from(container.querySelectorAll('.tier, .why-box'), {
        y: 20,
        opacity: 0,
        duration: animations.caseStudy.tokenTiers.duration,
        stagger: animations.caseStudy.tokenTiers.stagger,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.token-tiers',
          start: 'top 80%',
        }
      })
    })
  }

  initTokenTiers()
  document.addEventListener('astro:page-load', initTokenTiers)
  document.addEventListener('astro:before-swap', () => { ctx?.revert(); ctx = null })
</script>
