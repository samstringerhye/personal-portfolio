---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import couplePhoto from '../../assets/work/amica-design-system/bento/photo-couple-fence.jpg'
import roadAheadPhoto from '../../assets/work/amica-design-system/bento/car-road-ahead-masthead.jpg'
import avatarImage from '../../assets/work/amica-design-system/bento/avatar.jpg'
import logo from '../../assets/work/amica-design-system/bento/amica-logo.svg?raw'
import trustpilotStar from '../../assets/work/amica-design-system/hero/trustpilot-star.svg?raw'
import productAuto from '../../assets/work/amica-design-system/bento/product-auto.svg?raw'
import productHome from '../../assets/work/amica-design-system/bento/product-home.svg?raw'
import productCondo from '../../assets/work/amica-design-system/bento/product-condo.svg?raw'
import productRenters from '../../assets/work/amica-design-system/bento/product-renters.svg?raw'
import productGridAuto from '../../assets/work/amica-design-system/bento/product-grid-auto.jpg'
import productGridMotorcycle from '../../assets/work/amica-design-system/bento/product-grid-motorcycle.jpg'
import productGridMarine from '../../assets/work/amica-design-system/bento/product-grid-marine.jpg'
import productGridRv from '../../assets/work/amica-design-system/bento/product-grid-rv.jpg'
import productGridBundle from '../../assets/work/amica-design-system/bento/product-grid-bundle.jpg'
import editorialHome from '../../assets/work/amica-design-system/bento/editorial-home.jpg'
import editorialCare from '../../assets/work/amica-design-system/bento/editorial-care.jpg'

// The tiles crop with object-fit: cover, so an image wider than its box needs box height × aspect.
// Boxes are the measured tile sizes in vw, below and above the 960px breakpoint.
type Box = { w: number; h: number }
const coverSizes = (img: ImageMetadata, narrow: Box, wide: Box) => {
  const need = ({ w, h }: Box) => Math.ceil(Math.max(w, (h * img.width) / img.height))
  return `(max-width: 960px) ${need(narrow)}vw, ${need(wide)}vw`
}
const coverWidths = (img: ImageMetadata, steps: number[]) => [...new Set(steps.map((w) => Math.min(w, img.width)))]
const photoTile = { narrow: { w: 94, h: 47 }, wide: { w: 32, h: 16 }, steps: [480, 960, 1440, 2048, 2700] }
const productCard = { narrow: { w: 18, h: 26 }, wide: { w: 6, h: 4 }, steps: [160, 320, 640, 1280, 1600] }
// Editorial thumbnails are at most 84px square
const editorialSizes = (img: ImageMetadata) => `${Math.ceil((84 * img.width) / img.height)}px`

const preserveIllustrationRatio = (svg: string) =>
  svg.replace('preserveAspectRatio="none"', 'preserveAspectRatio="xMidYMid meet"')

const products = [
  { name: 'Auto', icon: preserveIllustrationRatio(productAuto), selected: true },
  { name: 'Home', icon: preserveIllustrationRatio(productHome) },
  { name: 'Condo', icon: preserveIllustrationRatio(productCondo) },
  { name: 'Renters', icon: preserveIllustrationRatio(productRenters) },
]

const editorialCards = [
  {
    title: 'Home, made personal',
    body: 'Coverage shaped around the way you live.',
    label: 'Home insurance',
    image: editorialHome,
  },
  {
    title: 'Ready for the road',
    body: 'Protection that stays with you from driveway to destination.',
    label: 'Auto insurance',
    // Same file as the prototype's woman-with-motorcycle-orig.jpg
    image: productGridMotorcycle,
  },
  {
    title: 'Help when it matters',
    body: 'Real guidance from people who know your coverage.',
    label: 'Our service',
    image: editorialCare,
  },
]

const quickLinkGroups = [
  {
    label: 'Log in',
    links: [
      { label: 'Pay A Bill', icon: 'material-symbols:paid-outline' },
      { label: 'Report A Claim', icon: 'material-symbols:error-outline' },
      { label: 'Log In', icon: 'material-symbols:person-outline' },
    ],
  },
  {
    label: 'No sign in required',
    links: [
      { label: 'Pay As Guest', icon: 'material-symbols:paid-outline' },
      { label: 'Report Any Claim', icon: 'material-symbols:error-outline' },
      { label: 'Create Account', icon: 'material-symbols:person-outline' },
    ],
  },
]

const productGridCards = [
  { name: 'Auto', image: productGridAuto },
  { name: 'Motorcycle', image: productGridMotorcycle },
  { name: 'Marine', image: productGridMarine },
  { name: 'RV & Trailer', image: productGridRv },
  { name: 'Bundle & Save', image: productGridBundle, offer: true },
]

const statCards = [
  { value: '97', suffix: '%', label: 'Claims resolved in one call' },
  { value: '94', suffix: '%', label: 'Members who’d recommend Amica' },
  { value: '91', suffix: '%', label: 'Policyholder renewal rate' },
]

const chevron = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>'
const down = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>'
---

<section class="mosaic" aria-label="Amica design system in use: component mosaic">
  <div class="mosaic__grid">
    <article class="tile tile--masthead">
      <Image class="mosaic-media masthead-image" src={roadAheadPhoto} alt="Couple standing beside their car at sunset" widths={coverWidths(roadAheadPhoto, photoTile.steps)} sizes={coverSizes(roadAheadPhoto, photoTile.narrow, photoTile.wide)} format="webp" loading="lazy" />
      <div class="masthead-card">
        <div class="masthead-rating" aria-label="Excellent rating on Trustpilot">
          <strong>Excellent</strong>
          <span class="masthead-stars" aria-hidden="true">
            {Array.from({ length: 5 }, () => <i set:html={trustpilotStar} />)}
          </span>
          <span>Trustpilot</span>
        </div>
        <h2>Car insurance that's made for your road ahead</h2>
        <p>Protection and support built around you.</p>
        <div class="masthead-fields" aria-hidden="true">
          <span>Auto <i set:html={down} /></span>
          <span class="masthead-zip">ZIP code</span>
        </div>
        <span class="button button--full">Get a quote</span>
        <span class="masthead-link">Continue a saved quote</span>
      </div>
    </article>

    <div class="tile tile--photo"><Image class="mosaic-media" src={couplePhoto} alt="Couple leaning on a fence outside their home" widths={coverWidths(couplePhoto, photoTile.steps)} sizes={coverSizes(couplePhoto, photoTile.narrow, photoTile.wide)} format="webp" loading="lazy" /></div>

    <article class="tile tile--editorial" aria-label="Explore Amica coverage">
      <div class="editorial-panel">
        <header class="editorial-header">
          <span>Insurance for real life</span>
          <h3>Coverage for every part of your world</h3>
          <p>Straightforward protection, backed by people who show up.</p>
        </header>
        <div class="editorial-list">
          {editorialCards.map((card) => (
            <div class="editorial-item">
              <Image class="mosaic-media" src={card.image} alt="" widths={coverWidths(card.image, [128, 256, 512, 768])} sizes={editorialSizes(card.image)} format="webp" loading="lazy" />
              <span class="editorial-item__copy">
                <strong>{card.title}</strong>
                <span class="editorial-item__body">{card.body}</span>
                <span class="editorial-item__link">{card.label}</span>
              </span>
            </div>
          ))}
        </div>
        <div class="editorial-button">Explore coverage</div>
      </div>
    </article>

    <article class="tile tile--product-grid" aria-label="Insurance products">
      <header class="product-grid__header">
        <h3>Insurance built for real people, by real people.</h3>
        <p>No two policies are the same. Just as it should be</p>
      </header>
      <div class="product-grid__tabs" aria-hidden="true">
        {['Vehicles', 'Property', 'Personal', 'Small Business', 'Retirement', 'Bundle & Save'].map((tab, index) => <span class:list={{ active: index === 0 }}>{tab}</span>)}
      </div>
      <div class="product-grid__cards">
        {productGridCards.map((card) => (
          <figure class="product-grid__card">
            {card.offer && <span class="product-grid__offer">Offer</span>}
            <Image class="mosaic-media" src={card.image} alt="" widths={coverWidths(card.image, productCard.steps)} sizes={coverSizes(card.image, productCard.narrow, productCard.wide)} format="webp" loading="lazy" />
            <figcaption>{card.name}</figcaption>
            <span class="product-grid__arrow" aria-hidden="true">→</span>
          </figure>
        ))}
      </div>
      <div class="product-grid__button">Explore All Products</div>
    </article>

    <article class="tile tile--stats" aria-label="Reasons to believe statistics">
      <header class="stats-header">
        <h3>Coverage you can actually trust</h3>
      </header>
      <div class="stats-card">
        <div class="stats-card__group">
          {statCards.map((stat) => (
            <div class="stats-card__stat">
              <strong>{stat.value}<small>{stat.suffix}</small></strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </article>

    <article class="tile tile--hero-copy">
      <div class="hero-copy">
        <div class="hero-top"><span class="logo" set:html={logo} /><span class="login">Log In</span></div>
        <div class="hero-content"><h2>Insurance that protects <em>everything worth protecting</em></h2><p>Real coverage from real people, since 1907.</p><span class="button">Get A Quote</span></div>
      </div>
    </article>

    <article class="tile tile--quick-links" aria-label="Account quick links">
      {quickLinkGroups.map((group) => (
        <section class="quick-link-group" aria-label={group.label}>
          <h3>{group.label}</h3>
          <div class="quick-link-row">
            {group.links.map((link) => (
              <div class="quick-link-item">
                <Icon name={link.icon} aria-hidden="true" />
                <span>{link.label}</span>
              </div>
            ))}
          </div>
        </section>
      ))}
    </article>

    <article class="tile tile--faq">
      {['How do I file a claim?', 'What does home insurance cover?', 'Can I bundle auto and home?', 'How are dividends paid?'].map((question) => <div class="faq-row"><span>{question}</span><i set:html={chevron} /></div>)}
    </article>

    <article class="tile tile--nav">
      <div class="nav-card">{['Insurance', 'Claims', 'Customer Service', 'Resources', 'Find an office'].map((item) => <div class="nav-row"><span>{item}</span><i>→</i></div>)}</div>
    </article>

    <article class="tile tile--macro" aria-hidden="true"><span class="macro-ring"><span>Get A Quote</span></span></article>

    <article class="tile tile--picker">
      <div class="picker-shell">
        <h3>What would you like to insure?</h3>
        <div class="picker-row">{products.map((product) => <div class:list={['product-card', { 'product-card--selected': product.selected }]} data-product={product.name.toLowerCase()}><i class="checkbox" aria-hidden="true">{product.selected && '✓'}</i><span class="product-illustration" set:html={product.icon} /><span class="product-name">{product.name}</span></div>)}</div>
      </div>
    </article>

    <article class="tile tile--testimonial">
      <span class="quote-mark">"</span>
      <p>After the storm, Amica <em>called us before we even called them.</em> Everything was handled in days.</p>
      <div class="attribution-row">
        <Image src={avatarImage} alt="" class="avatar mosaic-media" width={88} format="webp" loading="lazy" />
        <div class="attribution-info">
          <div class="attribution-name">M. Delgado</div>
          <div class="attribution-subtext">Policyholder since 2011</div>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  const video = document.currentScript?.closest('.mosaic')?.querySelector('video')
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay')
    video.pause()
  }
</script>

<style is:global>
  @font-face {
    font-family: 'Apercu Pro';
    src: url('/work/amica-design-system/prototype/fonts/Apercu-Regular-Pro.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Apercu Pro';
    src: url('/work/amica-design-system/prototype/fonts/Apercu-Bold-Pro.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Amica Rhymes';
    src: url('/work/amica-design-system/prototype/fonts/AmicaRhymes-Regular.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Amica Rhymes';
    src: url('/work/amica-design-system/prototype/fonts/AmicaRhymes-Medium.otf') format('opentype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Amica Rhymes';
    src: url('/work/amica-design-system/prototype/fonts/AmicaRhymes-Italic.otf') format('opentype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
</style>

<style>
  .mosaic { --teal:#00a88f; --forest:#003d33; --mint:#d6fcf5; --tint:#effffc; --ink:#001512; --cream:#f7f4e8; --tile-padding-standard:clamp(16px,1.67vw,24px); --tile-padding-compact:clamp(10px,1.11vw,16px); --bento-gap:clamp(8px,1vw,14px); --bento-radius:clamp(12px,1.4vw,20px); font-family:"Apercu Pro",var(--font-primary,system-ui); }
  .mosaic__grid { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); grid-template-rows:repeat(3,1fr); gap:var(--bento-gap); aspect-ratio:2 / 1; }
  /* A bento: each tile its own rounded card, gutters between them */
  .tile { position:relative; min-width:0; min-height:0; overflow:hidden; color:var(--ink); border-radius:var(--bento-radius); outline:1px solid rgba(0,21,18,.08); outline-offset:-1px; }
  .tile--masthead{grid-column:1/3;grid-row:1;background:var(--forest)}
  .masthead-image{display:block;width:100%;height:100%;object-fit:cover;object-position:59% center}
  .tile--masthead::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,21,18,.12),transparent 66%);pointer-events:none}
  .masthead-card{position:absolute;z-index:1;top:var(--tile-padding-compact);left:var(--tile-padding-compact);bottom:calc(var(--tile-padding-standard) * -2.5);width:66%;box-sizing:border-box;border-radius:clamp(8px,.83vw,12px);background:#fff;padding:var(--tile-padding-compact);box-shadow:0 12px 32px rgba(0,21,18,.18);display:flex;flex-direction:column;align-items:flex-start;gap:clamp(5px,.49vw,7px)}
  .masthead-rating{display:flex;align-items:center;gap:clamp(3px,.28vw,4px);font-size:clamp(7px,.65vw,9px);line-height:1;color:#24332f;white-space:nowrap}.masthead-rating strong{font-weight:700}.masthead-stars{display:flex;gap:1px}.masthead-stars i{display:block;width:clamp(7px,.69vw,10px);height:clamp(7px,.69vw,10px)}.masthead-stars i :global(svg){display:block;width:100%;height:100%}
  .masthead-card h2{margin:0;max-width:12ch;font:400 clamp(16px,1.67vw,24px)/1.02 "Amica Rhymes",var(--font-serif,Georgia,serif);letter-spacing:-.03em}.masthead-card p{margin:0;max-width:26ch;font-size:clamp(6px,.56vw,8px);line-height:1.25;color:#50635e}
  .masthead-fields{display:flex;width:100%;gap:clamp(4px,.42vw,6px);margin-top:clamp(1px,.14vw,2px)}.masthead-fields>span{height:clamp(22px,2.08vw,30px);min-width:0;flex:1;border:1px solid #c7d8d3;border-radius:clamp(4px,.42vw,6px);padding:0 clamp(6px,.56vw,8px);display:flex;align-items:center;justify-content:space-between;font-size:clamp(6px,.56vw,8px);color:#23423b}.masthead-fields i{display:flex;width:clamp(8px,.83vw,12px)}.masthead-fields i :global(svg){width:100%}.masthead-fields .masthead-zip{color:#80908c;justify-content:flex-start}
  .masthead-card .button--full{height:clamp(24px,2.22vw,32px);border-radius:clamp(4px,.42vw,6px);font-size:clamp(6px,.63vw,9px)}.masthead-link{font-size:clamp(7px,.65vw,9px);line-height:1;color:#005c47;text-decoration:underline;text-underline-offset:2px}
  .button{display:inline-flex;align-items:center;justify-content:center;background:#00a88f;color:#000000;border-radius:9px;padding:0 18px;height:42px;font-size:13.5px;font-weight:400;white-space:nowrap;font-family:"Apercu Pro",var(--font-primary,system-ui)}.button--small{height:30px;border-radius:6px;padding:0 16px;font-size:11px}.button--full{width:100%;height:36px;border-radius:6px;font-size:12.5px}
  .tile--photo{grid-column:3/7;grid-row:1}.tile--photo img{width:100%;height:100%;display:block;object-fit:cover}
  .tile--quick-links{grid-column:1/3;grid-row:1;box-sizing:border-box;padding:clamp(12px,6cqi,20px);background:#fff;box-shadow:inset 0 -8px 12px -12px rgba(0,168,143,.65);display:flex;flex-direction:column;container-type:inline-size}.quick-link-group{min-width:0;min-height:0;flex:1;display:flex;flex-direction:column;justify-content:center}.quick-link-group+ .quick-link-group{border-top:1px solid #dfe7e4}.quick-link-group h3{margin:0 0 clamp(9px,4.5cqi,16px);font:400 clamp(8px,3.8cqi,13px)/1.1 var(--font-mono,ui-monospace,SFMono-Regular,Menlo,monospace);letter-spacing:.03em;text-transform:uppercase;color:#69716f}.quick-link-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(5px,2.5cqi,10px)}.quick-link-item{min-width:0;color:#006b58;display:flex;flex-direction:column;align-items:center;gap:clamp(4px,2cqi,7px);font-size:clamp(8px,4cqi,14px);line-height:1.15;text-align:center}.quick-link-item :global(svg){width:clamp(17px,7.5cqi,24px);height:clamp(17px,7.5cqi,24px);color:#006b58}.quick-link-item span{display:block;max-width:9ch}
  .tile--editorial{grid-column:7/9;grid-row:1;background:#fff;container-type:inline-size}.editorial-panel{box-sizing:border-box;width:100%;min-height:145cqi;padding:clamp(12px,5cqi,20px);display:flex;flex-direction:column;gap:clamp(12px,5cqi,20px)}.editorial-header{text-align:center;flex:0 0 auto}.editorial-header>span{display:block;margin-bottom:clamp(5px,2.2cqi,9px);font-size:clamp(7px,3.2cqi,12px);line-height:1.1;color:#68726f}.editorial-header h3{max-width:14ch;margin:0 auto;font:400 clamp(17px,7.5cqi,30px)/.98 "Amica Rhymes",var(--font-serif,Georgia,serif);letter-spacing:-.025em}.editorial-header p{max-width:30ch;margin:clamp(7px,3cqi,12px) auto 0;font-size:clamp(7px,3.2cqi,12px);line-height:1.25}.editorial-list{display:grid;row-gap:clamp(4px,2cqi,8px)}.editorial-item{min-height:clamp(62px,28cqi,108px);padding:clamp(10px,4.5cqi,18px) 0;border-bottom:1px solid #dfe7e4;display:grid;grid-template-columns:clamp(48px,22cqi,84px) minmax(0,1fr);align-items:center;gap:clamp(12px,5cqi,20px);color:var(--ink)}.editorial-item img{display:block;width:100%;aspect-ratio:1;height:auto;border-radius:clamp(10px,4.5cqi,18px);object-fit:cover}.editorial-item__copy{min-width:0;align-self:stretch;display:flex;flex-direction:column;justify-content:center}.editorial-item strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:italic 400 clamp(11px,5.2cqi,20px)/1 "Amica Rhymes",var(--font-serif,Georgia,serif);letter-spacing:-.015em}.editorial-item__body{display:-webkit-box;margin-top:clamp(4px,2cqi,8px);overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size:clamp(9px,3.6cqi,13px);line-height:1.25}.editorial-item__link{align-self:flex-start;margin-top:clamp(7px,3cqi,12px);padding-bottom:2px;border-bottom:1px solid currentColor;color:#006b58;font-size:clamp(9px,3.6cqi,13px);line-height:1.15}.editorial-button{box-sizing:border-box;min-height:clamp(30px,12cqi,46px);margin-top:clamp(4px,2cqi,8px);border:1px solid #006b58;border-radius:clamp(8px,4cqi,16px);d