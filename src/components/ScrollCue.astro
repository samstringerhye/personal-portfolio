---
/**
 * An in-flow action below the case-study introduction. Its own space keeps it clear of metadata
 * and artwork. Scrolling respects the reader's reduced-motion preference.
 */
---

<button class="scroll-cue" type="button" aria-label="Scroll down one screen">
  <span class="scroll-cue-label typo-ui-caps">Scroll</span>
  <svg class="scroll-cue-arrow" viewBox="6 2 12 20" fill="none" aria-hidden="true">
    <path d="M12 4v15m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<style>
  .scroll-cue {
    position: relative;
    margin-top: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 0;
    border-radius: 999px;
    color: #FFFFFF;
    background: rgba(11, 33, 64, 0.8);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: pointer;
    pointer-events: auto;
    animation: scroll-cue-in 0.6s ease 0.4s both;
    transition: opacity var(--duration-quick) ease;
  }

  .scroll-cue-label {
    font-size: 0.9rem;
    line-height: 1;
  }

  .scroll-cue-arrow {
    width: 0.65rem;
    height: 0.85rem;
    flex: none;
    animation: scroll-cue-bob 1.6s var(--easing-standard) infinite;
  }

  .scroll-cue.is-gone {
    opacity: 0 !important;
    visibility: hidden;
    animation: none;
  }

  @keyframes scroll-cue-in {
    from { opacity: 0; }
  }

  @keyframes scroll-cue-bob {
    0%, 100% { translate: 0 -1px; }
    50% { translate: 0 3px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      animation: none;
    }

    .scroll-cue-arrow {
      animation: none;
    }
  }
</style>

<script>
  // Shown only while the page is at the top; the case study below takes over from there
  const update = () => {
    const gone = window.scrollY > 24
    document.querySelectorAll('.scroll-cue').forEach(el => el.classList.toggle('is-gone', gone))
  }
  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>('.scroll-cue').forEach(button => {
      if (button.dataset.scrollBound) return
      button.dataset.scrollBound = 'true'
      button.addEventListener('click', () => {
        window.scrollBy({
          top: window.innerHeight,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        })
      })
    })
  }
  bind()
  window.addEventListener('scroll', update, { passive: true })
  document.addEventListener('astro:page-load', () => { bind(); update() })
</script>
