---
// Case study hero for a project with a coded device: the title on the left and the same live device
// as its homepage card on the right, the composition the card's row has. Coming from the card, the
// device carries straight across the page change (device-scene/mount.ts).
import DeviceScene, { type SceneName } from './DeviceScene.astro'
import ScrollCue from './ScrollCue.astro'
import { animations } from '../data/tokens'

interface Props {
  scene: SceneName
  label: string
  title: string
  tagline?: string
  year?: number | string
  tags?: string[]
}

const { scene, label, title, tagline, year, tags = [] } = Astro.props
// Non-breaking hyphens: the narrow column would otherwise split "E-commerce" across lines
const heading = title.replaceAll('-', '\u2011')
// The text slides in like the homepage headline: title word by word, then the tagline, timed from
// textReveal. Arriving from its card it doesn't: the card's text is already
// in this place (mount.ts marks the hero data-carried)
const words = heading.split(/\s+/).filter(Boolean)
const reveal = animations.textReveal
const csWordDuration = `${reveal.duration}s`
const csWordStagger = `${reveal.wordStagger}s`
const csWordStart = `${animations.workCards.deviceNav.fadeInDelay}s`
const csWordSlide = `${reveal.slideUp}px`
const csWordBlur = `${reveal.initialBlur}px`
const csWordEase = reveal.cssEase
---

<section class="cs-device-hero">
  <!-- The card's caption, line for line: year and tags, title and tagline, then the Scroll cue in
       the place of the card's button -->
  <div class="cs-device-hero-text">
    {year && <p class="cs-device-hero-meta cs-hero-in typo-ui-caps" style="--i: 0"><span>{year}</span>{tags.map(tag => <span class="work-list-tag">{tag}</span>)}</p>}
    <div class="cs-device-hero-copy">
      <h1 class="cs-device-hero-title typo-headline-lg">{words.map((w, i) => <><span class="cs-hero-in" style={`--i: ${i + 1}`}>{w}</span>{i < words.length - 1 && ' '}</>)}</h1>
      {tagline && <p class="cs-device-hero-tagline cs-hero-in typo-body-lg" style={`--i: ${words.length + 1}`}>{tagline}</p>}
    </div>
    <div class="cs-device-hero-actions"><ScrollCue /></div>
  </div>
  <div class="cs-device-hero-stage">
    <DeviceScene scene={scene} label={label} />
  </div>
</section>

<style define:vars={{ csWordDuration, csWordStagger, csWordStart, csWordSlide, csWordBlur, csWordEase }}>
  .cs-hero-in {
    animation: cs-hero-in var(--csWordDuration) var(--csWordEase) both;
    animation-delay: calc(var(--csWordStart) + var(--i) * var(--csWordStagger));
  }

  .cs-device-hero[data-carried] .cs-hero-in {
    animation: none;
  }

  .cs-device-hero-title .cs-hero-in {
    display: inline-block;
  }

  @keyframes cs-hero-in {
    from {
      opacity: 0;
      transform: translateY(var(--csWordSlide));
      filter: blur(var(--csWordBlur));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-hero-in {
      animation: none;
    }
  }

  /* The text column copies the homepage card's caption (editorial.css: .work-list-caption) value
     for value, and the stage its art, so the device and every line of text hold still as the page
     changes around them (device-scene/mount.ts). Change one with the other. */
  .cs-device-hero {
    display: flex;
    flex-direction: column;
    padding-block: 0;
  }

  /* Stacked, the device starts below the floating All work button (CaseStudyLayout) */
  .cs-device-hero-stage {
    order: 1;
    position: relative;
    margin-top: calc(var(--cs-back-top) + var(--touch-target));
  }

  .cs-device-hero-text {
    order: 2;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
  }

  .cs-device-hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    max-width: 40rem;
    margin: 0;
    color: var(--color-text-primary);
  }

  .cs-device-hero-meta > span:first-child {
    margin-right: var(--space-1);
  }

  .cs-device-hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: fit-content;
    max-width: 40rem;
    margin-top: var(--space-3);
  }

  .cs-device-hero-title,
  .cs-device-hero-tagline {
    margin: 0;
  }

  .cs-device-hero .cs-device-hero-title {
    font-size: var(--text-400);
    line-height: 1.12;
  }

  .cs-device-hero .cs-device-hero-tagline {
    max-width: 38em;
    font-size: var(--text-200);
    line-height: 1.4;
    color: var(--ek-ink-body);
  }

  .cs-device-hero-actions {
    display: flex;
    margin-top: var(--space-5);
  }

  .cs-device-hero-actions :global(.scroll-cue) {
    margin-top: 0;
  }

  /* Desktop: the homepage row's grid, the text centered on the height of the device in the left 4
     of 12 columns beside it in the other 8 */
  @media (min-width: 64.0625rem) {
    .cs-device-hero {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
      align-items: center;
      padding-block: var(--page-margin) 0;
    }

    .cs-device-hero-text {
      grid-column: 1 / 5;
      grid-row: 1;
      padding-top: 0;
    }

    .cs-device-hero-stage {
      grid-column: 5 / -1;
      grid-row: 1;
      /* The card's desktop stage, so its device has the same transition box */
      height: calc(100svh - var(--nav-height) - 2 * var(--page-margin));
      margin-top: 0;
    }
  }
</style>
