---
// Case study hero for a project with a coded device: the title on the left and the same live device
// as its homepage card on the right, the composition the card's row has. Coming from the card, the
// device carries straight across the page change (device-scene/mount.ts).
import DeviceScene, { type SceneName } from './DeviceScene.astro'
import { animations } from '../data/tokens'

interface Props {
  scene: SceneName
  label: string
  title: string
  tagline?: string
  year?: number | string
}

const { scene, label, title, tagline, year } = Astro.props
// Non-breaking hyphens: the narrow column would otherwise split "E-commerce" across lines
const heading = title.replaceAll('-', '\u2011')
// The text slides in like the homepage headline: the year, the title word by word, then the
// tagline, timed from textReveal and starting as the page fades in behind a carried device
const words = heading.split(/\s+/).filter(Boolean)
const reveal = animations.textReveal
const csWordDuration = `${reveal.duration}s`
const csWordStagger = `${reveal.wordStagger}s`
const csWordStart = `${animations.workCards.deviceNav.fadeInDelay}s`
const csWordSlide = `${reveal.slideUp}px`
const csWordBlur = `${reveal.initialBlur}px`
const csWordEase = reveal.cssEase
---

<section class="cs-device-hero">
  <div class="cs-device-hero-text">
    {year && <p class="cs-device-hero-year cs-hero-in typo-ui-caps" style="--i: 0">{year}</p>}
    <h1 class="cs-device-hero-title typo-headline-lg">{words.map((w, i) => <><span class="cs-hero-in" style={`--i: ${i + 1}`}>{w}</span>{i < words.length - 1 && ' '}</>)}</h1>
    {tagline && <p class="cs-device-hero-tagline cs-hero-in typo-body-lg" style={`--i: ${words.length + 1}`}>{tagline}</p>}
  </div>
  <div class="cs-device-hero-stage">
    <DeviceScene scene={scene} label={label} />
  </div>
</section>

<style define:vars={{ csWordDuration, csWordStagger, csWordStart, csWordSlide, csWordBlur, csWordEase }}>
  .cs-hero-in {
    animation: cs-hero-in var(--csWordDuration) var(--csWordEase) both;
    animation-delay: calc(var(--csWordStart) + var(--i) * var(--csWordStagger));
  }

  .cs-device-hero-title .cs-hero-in {
    display: inline-block;
  }

  @keyframes cs-hero-in {
    from {
      opacity: 0;
      transform: translateY(var(--csWordSlide));
      filter: blur(var(--csWordBlur));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-hero-in {
      animation: none;
    }
  }

  /* Phones: the device, then the title, like the homepage card. The top padding clears the sticky
     back button (CaseStudyLayout) */
  .cs-device-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: calc(var(--touch-target) + var(--space-4)) var(--ek-section, var(--space-8));
  }

  .cs-device-hero-stage {
    order: 1;
    position: relative;
    margin-block: var(--space-2) var(--space-4);
  }

  /* Stacked: as wide as the column and about as tall as the devices in it, like the homepage's
     stacked cards */
  @media (max-width: 64rem) {
    .cs-device-hero-stage {
      aspect-ratio: 1.1;
    }

    /* The homepage card's caption (editorial.css) under its art: a space-4 step to the year row,
       whose tag pills make it taller than the year alone, then a space-3 step to the title. The
       title lands where the card's did when the page changes */
    .cs-device-hero-stage {
      margin-bottom: 0;
    }

    /* The year is centered in the card's 21px pill row, 3px below its top */
    .cs-device-hero .cs-device-hero-year {
      margin: calc(var(--space-4) - var(--space-2) + 3px) 0 calc(var(--space-3) - var(--space-2) + 3px);
    }

    .cs-device-hero-stage:not(:has(.device-scene-host:not([data-device="iphone-17-pro"]))) {
      aspect-ratio: 0.95;
    }
  }



  .cs-device-hero-text {
    display: contents;
  }

  /* The device first, then the year, title and tagline, as on the homepage card it zooms from */
  .cs-device-hero-text > * {
    order: 2;
  }

  .cs-device-hero-year {
    margin: var(--space-4) 0 0;
    color: var(--ek-ink-body);
  }

  .cs-device-hero-title,
  .cs-device-hero-tagline {
    margin: 0;
  }

  /* The card's title and tagline sizes, so the text reads as the same block when the device
     carries across */
  .cs-device-hero .cs-device-hero-title {
    font-size: var(--text-400);
    line-height: 1.12;
  }

  .cs-device-hero .cs-device-hero-tagline {
    font-size: var(--text-200);
    line-height: 1.4;
  }

  .cs-device-hero-tagline {
    max-width: 32rem;
    color: var(--ek-ink-body);
  }

  /* Desktop: the homepage row's grid, the title at the bottom of the left 4 of 12 columns beside the
     device in the other 8 */
  @media (min-width: 64.0625rem) {
    /* The text at the bottom of the column */
    .cs-device-hero-text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      align-self: stretch;
      gap: var(--space-2);
      /* The homepage card's caption (editorial.css): its 8rem below, and its button's room above
         that, so the year, title and tagline land where the card's were */
      padding-bottom: calc(8rem + var(--space-5) + var(--touch-target));
    }

    /* The card's year shares a row with taller tag pills and sits a step further from the title */
    .cs-device-hero-year {
      margin-bottom: calc(var(--space-3) - var(--space-2) + 0.5em - 3px);
    }

    .cs-device-hero {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
      align-items: end;
      padding-block: var(--page-margin);
    }

    .cs-device-hero-text {
      grid-column: 1 / 5;
    }

    .cs-device-hero-stage {
      grid-column: 5 / -1;
      height: calc(100svh - var(--nav-height) - 2 * var(--page-margin));
      margin-block: 0;
    }

  }
</style>
