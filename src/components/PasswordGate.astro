---
// Password form for protected case studies. It sits inside the hero: the hero art fades out, this
// fades in, and a correct password fades the hero back before the full page loads (see the script).
// Rendered only when middleware.ts has withheld the page; the hero's `is-gated` class (set by
// CaseStudyHero) is what shows it.
interface Props {
  title: string
  error?: boolean
  rateLimited?: boolean
}
const { title, error = false, rateLimited = false } = Astro.props
const message = rateLimited ? 'Too many attempts. Try again in a few minutes.' : error ? 'Incorrect password. Try again.' : ''
---

<div class="cs-hero-gate" data-password-gate>
  <form class="gate-form" method="POST">
    <p class="gate-label typo-ui-caps">Under NDA</p>
    <!-- The hero keeps its title in view below the form, so the form doesn't repeat it -->
    <h2 class="gate-title typo-headline-sm">Enter the password to view this case study</h2>
    <label for="gate-password" class="gate-field-label typo-ui-caps">Password</label>
    <input
      id="gate-password"
      class="gate-input typo-body-lg"
      type="password"
      name="password"
      required
      autocomplete="current-password"
      aria-describedby="gate-message"
      disabled={rateLimited}
    />
    <p id="gate-message" class="gate-message typo-body-md" role="alert">{message}</p>
    <button class="gate-button typo-ui-caps" type="submit" disabled={rateLimited}>View case study</button>
    <p class="gate-access typo-body-md">No password? <a data-contact-email data-contact-subject={`Walkthrough request: ${title}`}>Request a private walkthrough</a></p>
  </form>
</div>

<noscript>
  <style>
    .cs-hero-gate { opacity: 1 !important; visibility: visible !important; }
    .cs-hero-subject { opacity: 0 !important; }
  </style>
</noscript>

<style>
  .cs-hero-gate {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: var(--space-6);
    /* The form sits on the project color, which stays put in dark mode, so its ink does too: the
       light-scheme text and page colors from editorial.css */
    --color-text-primary: #0B2140;
    --color-bg-primary: #FEFDFC;
    color: var(--color-text-primary);
    /* Covers the whole hero, so let clicks through to the back arrow; only the form takes them */
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-medium) var(--easing-standard), visibility 0s linear var(--duration-medium);
  }

  :global(.cs-hero--light) .cs-hero-gate {
    color: white;
  }

  /* Crossfades with the hero art */
  :global(.cs-hero.is-gated) .cs-hero-gate {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--duration-medium) var(--easing-standard), visibility 0s;
  }

  /* The title stays in view below the box (editorial.css grows the box to fit the form). Nothing
     follows it, so it keeps room above the footer */
  :global(.case-study-body .cs-hero.is-gated .cs-hero-text) {
    margin-bottom: var(--cs-section-gap);
  }

  .gate-form {
    pointer-events: auto;
    width: min(24rem, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .gate-label,
  .gate-title,
  .gate-message,
  .gate-access {
    margin: 0;
  }

  .gate-access a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  .gate-input {
    width: 100%;
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    font: inherit;
    color: inherit;
    background: transparent;
    border: var(--border-width-1) solid currentColor;
    border-radius: 0;
  }

  /* Sits tight to its field, inside the form's larger gap */
  .gate-field-label {
    margin-bottom: calc(var(--space-1) - var(--space-2));
  }

  .gate-input:focus-visible,
  .gate-button:focus-visible,
  .gate-access a:focus-visible {
    outline: var(--border-width-1) solid currentColor;
    outline-offset: 3px;
  }

  .gate-message {
    min-height: 1lh;
  }

  .gate-button {
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    font: inherit;
    color: var(--color-bg-primary);
    background: var(--color-text-primary);
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }

  :global(.cs-hero--light) .gate-button {
    color: var(--color-text-primary);
    background: white;
    border-color: white;
  }

  .gate-button:disabled {
    cursor: default;
    opacity: var(--opacity-50);
  }

  .gate-access a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (hover: hover) {
    .gate-button:not(:disabled):hover,
    .gate-access a:hover {
      opacity: var(--opacity-50);
    }
  }

  @media (max-width: 768px) {
    .cs-hero-gate {
      padding: var(--space-3);
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client'

  const FADE_MS = 250 // --duration-medium
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

  function init() {
    const gate = document.querySelector<HTMLElement>('[data-password-gate]')
    const hero = gate?.closest<HTMLElement>('.cs-hero')
    const form = gate?.querySelector<HTMLFormElement>('form')
    const input = form?.querySelector<HTMLInputElement>('input')
    const button = form?.querySelector<HTMLButtonElement>('button')
    const message = form?.querySelector<HTMLElement>('.gate-message')
    if (!gate || !hero || !form || !input || !button || !message || form.dataset.bound) return
    form.dataset.bound = 'true'

    const focusInput = () => input.focus({ preventScroll: true })
    if (hero.classList.contains('is-gated')) {
      focusInput()
    } else {
      hero.classList.add('is-gated')
      setTimeout(focusInput, reduced() ? 0 : FADE_MS)
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (button.disabled || !input.value) return
      button.disabled = true
      message.textContent = ''
      let status = 0
      try {
        const response = await fetch(location.pathname, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'x-gate-fetch': '1' },
          credentials: 'same-origin',
        })
        status = response.status
      } catch {
        // Network failure: reported below
      }

      if (status === 204) {
        // Form out, hero back in, then load the real page, whose hero is identical
        hero.classList.remove('is-gated')
        await new Promise(resolve => setTimeout(resolve, reduced() ? 0 : FADE_MS))
        try {
          await navigate(location.pathname, { history: 'replace' })
        } catch {
          location.reload()
        }
        return
      }

      message.textContent = status === 401
        ? 'Incorrect password. Try again.'
        : status === 429
          ? 'Too many attempts. Try again in a few minutes.'
          : 'Something went wrong. Try again.'
      if (status !== 429) button.disabled = false
      input.select()
    })
  }

  init()
  document.addEventListener('astro:page-load', init)
</script>
