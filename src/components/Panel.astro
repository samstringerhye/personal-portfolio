---
/**
 * One visual on a faint gray field, frameless, with the room inside the panel:
 * - screens: one to four phone screens side by side, each a rounded card (top of the screen)
 * - page: a tall page filling the panel's width, cut off by its bottom edge
 * - piece: a component, a crop or a diagram, centered and contained
 * - bleed: a photo filling the panel
 * - video: a muted loop filling the panel; plays in view, holds its poster for reduced motion
 * - slot: anything else (a Lottie grid), filling the panel
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

type Src = ImageMetadata | string
interface Props {
  kind: 'screens' | 'page' | 'piece' | 'bleed' | 'video' | 'slot'
  src?: Src
  /** The same image for a dark page: transparent, with its labels re-inked light, so the board sits
      on the panel instead of showing a white box. Swapped in by prefers-color-scheme */
  srcDark?: Src
  /** Preserve PNG delivery for Figma exports when requested. */
  format?: 'png' | 'webp' | 'avif'
  alt?: string
  className?: string
  screens?: { src: Src; alt: string }[]
  span?: 'full' | 'half'
  /** Panel color, when the visual needs its own (a video's background)*/
  tint?: string
  /** Panel aspect ratio for page, piece, bleed and video */
  ratio?: string
  poster?: string
  caption?: string
  /** Multiply the image onto the tint, so a crop's white background drops out */
  multiply?: boolean
  /** Video only: fill the panel instead of showing the whole frame */
  cover?: boolean
}

const { kind, src, srcDark, format, alt = '', className, screens = [], span = 'full', tint, ratio, poster, caption, multiply, cover } = Astro.props
const half = span === 'half'
const aspect = ratio ?? (kind === 'screens' || kind === 'slot' ? undefined : half ? '4 / 5' : '16 / 10')
const style = [tint && `--panel-tint: ${tint}`, aspect && `--panel-ratio: ${aspect}`, kind === 'screens' && `--n: ${screens.length}`]
  .filter(Boolean)
  .join('; ')
const sizes = half ? '(max-width: 768px) 92vw, 46vw' : '(max-width: 768px) 92vw, 90vw'
const screenSizes = '(max-width: 768px) 92vw, 20rem'
const isLocal = (s: Src): s is ImageMetadata => typeof s !== 'string'
// Fresh PNG exports retain their native pixel ceiling instead of generating larger derivatives.
const pngWidths = (s: ImageMetadata, widths: number[]) => format === 'png'
  ? [...new Set([...widths.filter((w) => w <= s.width), Math.min(s.width, widths[widths.length - 1])])]
  : widths
---

<figure class:list={['panel', `panel--${kind}`, half && 'panel--half', multiply && 'panel--multiply', cover && 'panel--cover', className]} style={style || undefined}>
  <div class="panel-field">
    {kind === 'screens' ? (
      <div class="panel-screens" role={screens.length > 1 ? "region" : undefined} aria-label={screens.length > 1 ? "Screen comparison" : undefined}>
        {screens.map((s) => (
          isLocal(s.src)
            ? <Image src={s.src} format={format} alt={s.alt} widths={pngWidths(s.src, [400, 750, 1080])} sizes={screenSizes} class="panel-screen" />
            : <img src={s.src} alt={s.alt} class="panel-screen" loading="lazy" decoding="async" />
        ))}
      </div>
    ) : kind === 'video' ? (
      <video class="panel-media" src={src as string} poster={poster} muted loop playsinline preload="none" aria-label={alt}></video>
    ) : kind === 'slot' ? (
      <slot />
    ) : src && (
      <>
        {isLocal(src)
          ? <Image src={src} format={format} alt={alt} widths={pngWidths(src, [640, 1080, 1600, 2200, 2880])} sizes={sizes} class:list={['panel-media', srcDark && 'panel-media--light']} />
          : <img src={src} alt={alt} class:list={['panel-media', srcDark && 'panel-media--light']} loading="lazy" decoding="async" />}
        {srcDark && (isLocal(srcDark)
          ? <Image src={srcDark} format={format} alt={alt} widths={pngWidths(srcDark, [640, 1080, 1600, 2200, 2880])} sizes={sizes} class="panel-media panel-media--dark" />
          : <img src={srcDark} alt={alt} class="panel-media panel-media--dark" loading="lazy" decoding="async" />)}
      </>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // Loops play while in view; reduced motion keeps the poster
  const still = matchMedia('(prefers-reduced-motion: reduce)')
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement
      if (e.isIntersecting && !still.matches) v.play().catch(() => {})
      else v.pause()
    }
  }, { threshold: 0.25 })
  const watch = () => document.querySelectorAll<HTMLVideoElement>('.panel--video video').forEach((v) => io.observe(v))
  watch()
  document.addEventListener('astro:page-load', watch)
</script>
