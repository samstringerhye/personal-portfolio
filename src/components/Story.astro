---
/**
 * The whole story in one block under the hero: the facts in the left columns, then an optional
 * lead, problem, decision, and leadership contribution. The visuals after it carry the rest.
 */
interface Props {
  client: string
  role: string
  agency: string
  year: number | string
  /** What I made, one line each */
  made: string[]
  /** Verified result when available; omit when the project has no reportable outcome. */
  outcome?: string
  problem: string
  decision: string
  did: string
}

const { client, role, agency, year, made, outcome, problem, decision, did } = Astro.props
const facts: [string, string | string[]][] = [
  ['Client', client],
  ['Role', role],
  ['Agency', agency],
  ['Year', String(year)],
  ['Scope', made],
]
---

<section class="story" aria-label="Summary">
  <dl class="story-facts">
    {facts.map(([label, value]) => (
      <div class="story-fact">
        <dt class="typo-ui-caps">{label}</dt>
        <dd>
          {Array.isArray(value) ? (
            <ul class="story-scope">{value.map((v) => <li>{v}</li>)}</ul>
          ) : value}
        </dd>
      </div>
    ))}
  </dl>
  <div class="story-text">
    {outcome && <p class="story-lead">{outcome}</p>}
    <div class="story-part">
      <h2 class="typo-ui-caps">The problem</h2>
      <p>{problem}</p>
    </div>
    <div class="story-part">
      <h2 class="typo-ui-caps">The decision</h2>
      <p>{decision}</p>
    </div>
    <div class="story-part">
      <h2 class="typo-ui-caps">My contribution</h2>
      <p>{did}</p>
    </div>
  </div>
</section>

<style>
  .story-scope {
    margin: 0;
    padding-left: 1.1em;
    list-style: disc;
  }

  .story-scope li + li {
    margin-top: 0.35em;
  }
</style>
