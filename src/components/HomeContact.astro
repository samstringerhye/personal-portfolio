---
// End-of-page contact prompt, styled like the case studies' closing prompt so the homepage ends on
// a next step rather than the interests marquee
import ContactEmail from './ContactEmail.astro'

interface Props {
  headline: string
}

const { headline } = Astro.props
---

<section class="home-contact" aria-labelledby="home-contact-heading">
  <h2 id="home-contact-heading" class="typo-headline-lg" data-reveal="fade">{headline}</h2>
  <ContactEmail class="home-contact-link typo-body-lg" />
</section>

<style>
  .home-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--content-inset-md);
  }

  .home-contact h2 {
    margin: 0;
    color: var(--color-text-primary);
  }

  .home-contact :global(.home-contact-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: var(--space-1) var(--space-4);
    color: var(--color-text-primary);
    text-decoration: none;
    border: var(--border-width-1) solid var(--color-text-primary);
    transition: background-color var(--duration-short) ease, color var(--duration-short) ease;
  }

  @media (hover: hover) {
    .home-contact :global(.home-contact-link):hover {
      color: var(--color-bg-primary);
      background: var(--color-text-primary);
    }
  }

  @media (--1x) {
    .home-contact {
      padding: var(--content-inset-sm);
    }

    .home-contact :global(.home-contact-link) {
      align-self: stretch;
    }
  }
</style>
