---
// Keep an opening heading separate so the shared heading gap precedes the paragraph group.
const html = await Astro.slots.render('default')
const headed = html.match(/^\s*(<h[23][^>]*>[\s\S]*?<\/h[23]>)([\s\S]*)$/)
---
{headed ? (
  <div class="prose-group prose-group--headed">
    <Fragment set:html={headed[1]} />
    <div class="prose-body" set:html={headed[2]} />
  </div>
) : (
  <div class="prose-group"><Fragment set:html={html} /></div>
)}

<style is:global>
  .prose-group {
    display: flex;
    flex-direction: column;
    gap: var(--prose-gap, var(--cs-paragraph-gap));
    grid-column: 2 / 8;
  }

  .prose-body {
    display: flex;
    flex-direction: column;
    gap: var(--prose-gap, var(--cs-paragraph-gap));
  }

  @media (--2x) {
    .prose-group {
      grid-column: 1 / -1;
    }
  }

</style>
