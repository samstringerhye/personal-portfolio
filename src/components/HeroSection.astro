---
import type { HeadingTag, TypographyRole } from '../types/typography'
import { animations } from '../data/tokens'

interface Props {
  headline: string
  tag?: HeadingTag
  role?: TypographyRole
  body?: string
  bodyHighlights?: string[]
  bodyRole?: TypographyRole
}

const { headline, tag = 'h1', role = 'display-lg', body, bodyHighlights = [], bodyRole = 'title-lg' } = Astro.props as Props

// Break the bio into plain and highlighted runs, taking whichever phrase appears next
const bodySegments: { text: string; highlight: number }[] = []
if (body) {
  let cursor = 0
  while (cursor < body.length) {
    let next = { at: -1, phrase: '' }
    for (const phrase of bodyHighlights) {
      const at = body.indexOf(phrase, cursor)
      if (at !== -1 && (next.at === -1 || at < next.at)) next = { at, phrase }
    }
    if (next.at === -1) {
      bodySegments.push({ text: body.slice(cursor), highlight: 0 })
      break
    }
    if (next.at > cursor) bodySegments.push({ text: body.slice(cursor, next.at), highlight: 0 })
    // Highlights number 1–3 in reading order, cycling, so each takes a different accent
    const count = bodySegments.filter(seg => seg.highlight).length
    bodySegments.push({ text: next.phrase, highlight: (count % 3) + 1 })
    cursor = next.at + next.phrase.length
  }
}
const HeroTag = tag as any
const heroRole = `typo-${role}`

const revealCfg = animations.textReveal
const heroInitBlur = `${revealCfg.initialBlur}px`

// The headline reveals word by word in CSS from first paint, so it doesn't wait on GSAP and fonts
const headlineWords = headline.split(/\s+/).filter(Boolean)
const heroWordDuration = `${revealCfg.duration}s`
const heroWordStagger = `${revealCfg.wordStagger}s`
const heroWordStart = `${animations.hero.text.startDelay}s`
const heroWordSlide = `${revealCfg.slideUp}px`
const heroWordEase = revealCfg.cssEase
---

<section class="hero" aria-label="Introduction">
  <div class="hero-canvas-fallback" aria-hidden="true"></div>
  <div id="hero-canvas-root" aria-hidden="true">
    <canvas style="display:block;width:100%;height:100%"></canvas>
  </div>
  <div class="hero-text">
    <div class="hero-copy">
      <HeroTag class:list={["hero-block", heroRole]} data-hero-text>
        {headlineWords.map((word, i) => <><span class="hero-word" style={`--i: ${i}`}>{word}</span>{i < headlineWords.length - 1 && ' '}</>)}
      </HeroTag>
      {body && (
        <p class:list={["hero-bio", "hero-sub", `typo-${bodyRole}`]} data-hero-sub>
          {bodySegments.map(seg => seg.highlight ? <span class="hero-highlight" data-hl={seg.highlight}>{seg.text}</span> : seg.text)}
        </p>
      )}
    </div>
  </div>
</section>

<style define:vars={{ heroInitBlur, heroWordDuration, heroWordStagger, heroWordStart, heroWordSlide, heroWordEase }}>
  .hero {
    position: relative;
    width: 100%;
    height: 87vh;
    overflow: hidden;
    background-color: var(--color-bg-primary);
  }

  @media (--2x) {
    .hero {
      height: 70vh;
    }
  }

  /* Phones: short enough that the first work card shows in the first screen */
  @media (--1x) {
    .hero {
      height: 58svh;
    }
  }

  .hero-canvas-fallback {
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
    background: radial-gradient(ellipse at 50% 60%, var(--color-bg-alt) 0%, var(--color-bg-primary) 70%);
  }

  #hero-canvas-root {
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
    background-color: var(--color-bg-primary);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #hero-canvas-root.is-ready {
    opacity: 1;
  }

  .hero-text {
    position: relative;
    width: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: var(--content-inset-md);

    z-index: var(--z-base, 1);
  }

  .hero-copy {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  /* Thins the dot field behind the copy so the bio stays readable; dots keep full density at the edges */
  .hero-copy::before {
    content: '';
    position: absolute;
    inset: calc(var(--space-5) * -1) calc(var(--space-6) * -1);
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--color-bg-primary) 60%, transparent);
  }

  /* Each highlight takes a different accent. The first (the name) matches the accent the nav
     picked for the active tab (Nav.astro sets data-accent); the rest follow in rotation. */
  .hero-bio {
    margin: 0;
    color: var(--color-text-primary);
    --hl-1: var(--color-accent-text-1);
    --hl-2: var(--color-accent-text-2);
    --hl-3: var(--color-accent-text-3);
  }

  :global([data-accent="2"]) .hero-bio {
    --hl-1: var(--color-accent-text-2);
    --hl-2: var(--color-accent-text-3);
    --hl-3: var(--color-accent-text-1);
  }

  :global([data-accent="3"]) .hero-bio {
    --hl-1: var(--color-accent-text-3);
    --hl-2: var(--color-accent-text-1);
    --hl-3: var(--color-accent-text-2);
  }

  .hero-highlight {
    /* Keep each phrase (e.g. the job title) on one line */
    white-space: nowrap;
  }

  .hero-highlight[data-hl="1"] { color: var(--hl-1); }
  .hero-highlight[data-hl="2"] { color: var(--hl-2); }
  .hero-highlight[data-hl="3"] { color: var(--hl-3); }

  .hero-bio {
    max-width: 36em;
  }

  .hero-word {
    display: inline-block;
    animation: hero-word-in var(--heroWordDuration) var(--heroWordEase) both;
    animation-delay: calc(var(--heroWordStart) + var(--i) * var(--heroWordStagger));
  }

  @keyframes hero-word-in {
    from {
      opacity: 0;
      transform: translateY(var(--heroWordSlide));
      filter: blur(var(--heroInitBlur));
    }
  }

  /* Hidden until the entrance script runs, so the text isn't painted, hidden, then replayed;
     noscript and reduced motion reset this, and the failsafe shows it if the script never starts */
  .hero-sub {
    opacity: 0;
    animation: hero-text-failsafe 0s 4s forwards;
  }

  @keyframes hero-text-failsafe {
    to { opacity: 1; }
  }

  @media (--2x) {
    .hero-text {
      padding-inline: var(--content-inset-sm);
    }

    /* At title size the bio runs eight centered lines over the dot field */
    .hero-bio {
      font-size: var(--text-100);
      line-height: var(--line-height-normal);
    }
  }

  .hero-block {
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sub {
      opacity: 1;
      animation: none;
    }
    .hero-word {
      animation: none;
    }
    #hero-canvas-root {
      transition: none;
      opacity: 1;
    }
  }
</style>

<script>
  import type { CmyAutoSplitHandle } from './cmy-animate'

  let heroHandles: CmyAutoSplitHandle[] = []

  // The headline animates in CSS; this brings in the bio, which splits into lines once fonts load
  async function animateHero() {
    const subs = document.querySelectorAll<HTMLElement>('[data-hero-sub]')
    if (!subs.length) return

    heroHandles.forEach(h => h.kill())
    heroHandles = []

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const [{ default: gsap }, { animations }, { createCmyAutoSplitReveal }] = await Promise.all([
      import('gsap'),
      import('../data/tokens'),
      import('./cmy-animate'),
    ])

    if (prefersReduced) {
      gsap.set(subs, { opacity: 1 })
      return
    }

    const cfg = animations.textReveal
    const startDelay = animations.hero.text.startDelay

    await document.fonts.ready

    // The bio follows the headline in line by line, after its first words land. The headline's CSS
    // clock started at first paint, so count from page start rather than from now
    const delay = Math.max(0, startDelay + 0.4 - performance.now() / 1000)
    subs.forEach(el => {
      heroHandles.push(createCmyAutoSplitReveal(el, cfg, { delay }, 'lines'))
    })
  }

  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(() => animateHero())
  })
</script>

<script>
  let cleanupCanvas: (() => void) | null = null
  let mountPending = false

  async function mountHeroCanvas() {
    if (mountPending) return
    mountPending = true
    try {
      const root = document.getElementById('hero-canvas-root')
      if (!root) return
      cleanupCanvas?.()
      const { initHeroCanvas } = await import('./hero-canvas')
      cleanupCanvas = await initHeroCanvas(root)
    } finally {
      mountPending = false
    }
  }

  // Data Saver and low-memory phones keep the CSS gradient instead of downloading Three.js
  function canvasWorthIt() {
    const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number }
    if (nav.connection?.saveData) return false
    if (nav.deviceMemory && nav.deviceMemory <= 2) return false
    return true
  }

  // Waits for an idle moment, so the dot field doesn't compete with the headline's reveal
  document.addEventListener('astro:page-load', () => {
    if (!canvasWorthIt()) return
    if ('requestIdleCallback' in window) requestIdleCallback(() => mountHeroCanvas(), { timeout: 2500 })
    else setTimeout(mountHeroCanvas, 1500)
  })
</script>
