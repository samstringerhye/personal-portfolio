---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { boundsAttr, narrowArtStyle } from './narrow-art'
import DeviceScene from './DeviceScene.astro'
import ContactEmail from './ContactEmail.astro'
import type { HeadingTag, TypographyRole } from '../types/typography'

interface Props {
  headline?: string
  headingTag?: HeadingTag
  headingRole?: TypographyRole
  cardTitleTag?: HeadingTag
  cardTitleRole?: TypographyRole
}

const {
  headline = 'Selected Work',
  headingTag = 'h2', headingRole = 'headline-lg',
  cardTitleTag = 'h3', cardTitleRole = 'headline-sm',
} = Astro.props as Props
const SectionTag = headingTag as any
const CardTitleTag = cardTitleTag as any

const featured = (await getCollection('work'))
  .filter(w => w.data.featured && !w.data.unlisted)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
---

<section class="work-list-section" id="work" aria-labelledby="work-list-heading">
  <div class="work-list-intro">
    <div class="work-list-intro-inner">
      <SectionTag id="work-list-heading" class={`work-list-heading typo-${headingRole}`} data-reveal>{headline}</SectionTag>
    </div>
  </div>

  <!-- data-no-reveal: the site-wide image fade-up would otherwise animate every thumbnail on scroll -->
  <ul class="work-list" role="list" data-no-reveal>
    {featured.map((entry, i) => (
      <li class:list={['work-list-item', { 'work-list-item--light': entry.data.thumbnailText === 'light' }]}>
        <div class="work-list-card" style={entry.data.thumbnailLayers ? `--work-bg: ${entry.data.thumbnailScene ? 'transparent' : entry.data.thumbnailLayers.background}; ${narrowArtStyle(entry.data.thumbnailLayers.subjectBox, entry.data.thumbnailLayers.subjectBounds)}` : undefined}>
          <div
            class="work-list-media"
            data-layered={entry.data.thumbnailLayers ? '' : undefined}
            data-slug={entry.data.thumbnailLayers ? entry.id : undefined}
            data-hero-offset={entry.data.thumbnailLayers?.heroOffset}
            data-subject-bounds={entry.data.thumbnailLayers ? boundsAttr(entry.data.thumbnailLayers.subjectBounds ?? entry.data.thumbnailLayers.subjectBox) : undefined}
            data-frames={entry.data.thumbnailLayers?.frames?.length && !entry.data.thumbnailScene ? '' : undefined}
            data-scene={entry.data.thumbnailScene ? '' : undefined}
          >
            {/* A card with a device scene shows only the scene: no thumbnail art to download */}
            {entry.data.thumbnailScene ? null : entry.data.thumbnailLayers ? (
              <div class="work-list-plane">
                <div class="work-list-bg" style={`background: ${entry.data.thumbnailLayers.background}`} aria-hidden="true"></div>
                <Image
                  class="work-list-subject"
                  src={entry.data.thumbnailLayers.subject}
                  alt={entry.data.thumbnailAlt ?? entry.data.title}
                  layout="full-width"
                  sizes="(max-width: 768px) 100vw, 66vw"
                  format="webp"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
                {entry.data.thumbnailLayers.frames?.map(frame => (
                  <Image
                    class="work-list-subject work-list-frame"
                    src={frame}
                    alt=""
                    aria-hidden="true"
                    layout="full-width"
                    sizes="(max-width: 768px) 100vw, 66vw"
                    format="webp"
                    loading="lazy"
                  />
                ))}
              </div>
            ) : (
              <Image
                src={entry.data.thumbnail}
                alt={entry.data.thumbnailAlt ?? entry.data.title}
                layout="full-width"
                sizes="(max-width: 768px) 100vw, 66vw"
                format="webp"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            )}
            {entry.data.thumbnailScene && (
              <div class="work-list-scene">
                <DeviceScene scene={entry.data.thumbnailScene} label={entry.data.thumbnailAlt ?? entry.data.title} />
              </div>
            )}
          </div>
          <div class="work-list-caption">
            <p class="work-list-meta typo-ui-caps">
              <span>{entry.data.yearLabel ?? entry.data.year}</span>
              {entry.data.tags?.slice(0, 2).map(tag => <span class="work-list-tag">{tag}</span>)}
            </p>
            <div class="work-list-text">
              <CardTitleTag class={`work-list-title typo-${cardTitleRole}`}>{entry.data.title.replaceAll('-', '\u2011')}</CardTitleTag>
              <p class="work-list-tagline typo-body-lg">{entry.data.tagline}</p>
            </div>
            <div class="work-list-actions">
            <a href={`/work/${entry.id}`} class="ek-pill work-list-cta" aria-label={`${entry.data.passwordProtected ? 'Open with password' : 'View case study'}: ${entry.data.title}`} data-astro-prefetch="hover">
              {entry.data.passwordProtected ? 'Open with password' : 'View case study'}
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3.5 10h13M11.5 5l5 5-5 5" />
              </svg>
            </a>
            {entry.data.passwordProtected && (
              <span class="work-list-lock typo-ui-caps">
                <Icon name="material-symbols:lock-outline" aria-hidden="true" />
                Under NDA
              </span>
            )}
            {entry.data.passwordProtected && (
              <ContactEmail class="ek-link work-list-request typo-body-md" label="Request a private walkthrough" subject={`Walkthrough request: ${entry.data.title}`} />
            )}
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  /* The nav's Work link lands here; scroll-margin clears the sticky nav */
  .work-list-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    scroll-margin-top: var(--nav-height);
  }

  /* ── Left column: heading pinned under the nav while the cards scroll ── */
  .work-list-intro {
    border-right: var(--border-width-1) solid var(--color-rule);
  }

  .work-list-intro-inner {
    position: sticky;
    top: var(--nav-height);
    padding: var(--content-inset-md);
  }

  .work-list-heading {
    margin: 0;
    color: var(--color-text-primary);
  }

  /* ── Right column: stacked cards. Year sits top-left on the image, title and tagline bottom-left ── */
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-list-item + .work-list-item {
    border-top: var(--border-width-1) solid var(--color-rule);
  }

  /* The card is a size container so the overlay text scales with it, keeping the text-to-image
     proportions the thumbnails were composed for at every width */
  .work-list-card {
    position: relative;
    display: block;
    color: var(--color-text-primary);
    container-type: inline-size;
  }

  /* The case study button is the link: the text and the device beside it take no clicks */
  .work-list-cta {
    -webkit-tap-highlight-color: transparent;
  }

  /* Thumbnails are composed at 3:2; the frame enforces it so every card is the same height */
  .work-list-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .work-list-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long) var(--easing-standard, ease);
  }

  /* ── Layered cards: a background layer plus a transparent subject (the page transition zooms
     these same layers into the case study hero) ── */

  .work-list-plane {
    position: absolute;
    inset: 0;
    transition: transform var(--duration-long) var(--easing-standard, ease);
  }

  .work-list-bg {
    position: absolute;
    inset: 0;
  }

  .work-list-media[data-layered] .work-list-subject {
    position: absolute;
    inset: 0;
    transition: none;
    filter: drop-shadow(0 18px 22px rgba(11, 13, 27, 0.22));
  }

  /* Flipbook frames sit exactly on the subject. The first frame cuts in and the subject steps back;
     later frames crossfade (work-flip below) */
  .work-list-frame {
    opacity: 0;
  }

  .work-list-frame.is-on {
    opacity: 1;
  }

  .work-list-media[data-flipping] .work-list-frame {
    transition: opacity var(--flip-fade) ease;
  }

  .work-list-media[data-flipping] .work-list-subject:not(.work-list-frame) {
    opacity: 0;
  }

  /* ── Coded scene cards: the device stands on the page in place of the framed art; the scene's
     label describes it, so the art underneath stays hidden ── */
  .work-list-scene {
    position: absolute;
    inset: 0;
  }

  /* Groups the year and text for the narrow layout; no box of its own on wider cards */
  .work-list-caption {
    display: contents;
  }

  .work-list-meta {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: min(var(--space-5), 5.2cqi);
  }

  .work-list-lock {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
  }

  .work-list-lock svg {
    width: 1.1em;
    height: 1.1em;
  }

  .work-list-text {
    position: absolute;
    left: 0;
    bottom: 0;
    width: fit-content;
    max-width: min(40rem, 62%);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: min(var(--space-5), 5.2cqi);
  }

  /* headline-lg, but capped to ~4.9% of the card width (45px on a 917px card) */
  .work-list-title {
    margin: 0;
    font-size: min(var(--text-400), 4.9cqi);
  }

  .work-list-tagline {
    margin: 0;
    max-width: 38em;
  }

  /* ── Light cards: white text on saturated thumbnails (set per project with thumbnailText) ── */
  .work-list-item--light .work-list-meta,
  .work-list-item--light .work-list-text {
    color: white;
  }




  /* ── Narrow cards (under ~780px, any screen): too narrow for the text to share the art, so the
     card stacks two boxes on the project's color, the same size on every card: the image box,
     with the subject (subjectBox) fitted and centered in it, then the caption box: year, title
     and tagline right under the art's bottom margin, any spare room at the bottom. Keyed to the card's own width because that's
     what decides whether the text collides with the subject. The case study hero (global.css)
     matches. ── */
  @container (max-width: 780px) {
    .work-list-media {
      aspect-ratio: auto;
      height: var(--narrow-frame-height);
    }

    .work-list-media[data-layered] .work-list-subject {
      inset: auto;
      left: var(--narrow-art-left);
      top: var(--narrow-art-top);
      width: var(--narrow-art-width);
      height: var(--narrow-art-height);
      max-width: none;
      /* No drop shadow here: it spills into the padding and throws off the centering */
      filter: none;
    }

    /* The card is the size container, so the panel color goes on the caption. Room for the
       year (ui-caps), two lines of title (headline-lg) and three of tagline (body-lg), the longest
       any card needs, so every caption is the same height. */
    .work-list-caption {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      min-height: calc(1.25 * var(--text-75) + 2 * 1.25 * var(--text-400) + 3 * 1.5 * var(--text-100) + 2 * var(--space-1) + var(--narrow-pad));
      padding: 0 var(--narrow-pad) var(--narrow-pad);
      background: var(--work-bg, transparent);
    }

    .work-list-meta,
    .work-list-text {
      position: static;
      max-width: none;
      padding: 0;
    }

    /* The proportional cap would shrink the title too far at this width */
    .work-list-title {
      font-size: var(--text-400);
    }
  }

  /* ── Phones: heading stacks above the cards ── */
  @media (--2x) {
    .work-list-section {
      grid-template-columns: 1fr;
    }

    .work-list-intro {
      border-right: none;
      border-bottom: var(--border-width-1) solid var(--color-rule);
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
    }

    .work-list-intro-inner {
      position: static;
      padding: var(--content-inset-sm);
    }
  }
</style>




<script>
  // Card ↔ hero zoom between this list and the case study pages
  import './work-transition-loader'
</script>

<script>
  import { animations } from '../data/tokens'

  // Cards with frames step through them on hover, or while mostly in view on touch screens.
  // Reduced motion keeps the rest frame
  function initFlip() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const { flipHold, flipFade } = animations.workCards
    const hover = window.matchMedia('(hover: hover)').matches

    document.querySelectorAll<HTMLElement>('.work-list-media[data-frames]').forEach(media => {
      if (media.dataset.flipBound) return
      media.dataset.flipBound = 'true'
      media.style.setProperty('--flip-fade', `${flipFade}s`)
      const frames = [...media.querySelectorAll<HTMLElement>('.work-list-frame')]
      const card = media.closest<HTMLElement>('.work-list-card')
      if (!card || !frames.length) return
      let timer = 0
      let at = 0

      const show = (n: number) => frames.forEach((f, k) => f.classList.toggle('is-on', k === n))
      const start = () => {
        if (timer) return
        at = 0
        show(at)
        void media.offsetWidth
        media.dataset.flipping = ''
        timer = window.setInterval(() => show(at = (at + 1) % frames.length), flipHold * 1000)
      }
      const stop = () => {
        window.clearInterval(timer)
        timer = 0
        delete media.dataset.flipping
        show(-1)
      }

      // Back to the rest frame before the card zooms into its case study
      card.addEventListener('pointerdown', stop)
      if (hover) {
        card.addEventListener('mouseenter', start)
        card.addEventListener('mouseleave', stop)
      } else {
        new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), { threshold: 0.6 }).observe(media)
      }
    })
  }

  document.addEventListener('astro:page-load', initFlip)
</script>

