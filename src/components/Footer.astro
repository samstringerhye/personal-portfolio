---
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="footer-container">
    <!-- Name bar -->
    <div class="footer-bar">
      <div class="footer-palette" aria-hidden="true">
        <span style="background:#24F266"></span>
        <span style="background:#F22434"></span>
        <span style="background:#FBE91E"></span>
        <span style="background:#2471F2"></span>
        <span style="background:#0B0D1B"></span>
        <span style="background:white"></span>
      </div>
      <div class="footer-bar-text">
        <p class="footer-wordmark-text">Sam Stringer-Hye</p>
        <nav class="footer-links" aria-label="Footer links">
          <a href="mailto:sam@samstringerhye.com" class="footer-link footer-link--email typo-ui-caps">sam@samstringerhye.com</a>
          <a href="https://linkedin.com/in/samstringerhye" target="_blank" rel="noopener noreferrer" class="footer-link typo-ui-caps">LinkedIn <span class="visually-hidden">(opens in new tab)</span></a>
        </nav>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copyright typo-ui-caps">&copy; {year}</p>
      <a href="/colophon" class="footer-colophon-link typo-ui-caps">Colophon</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 0;
    position: relative;
    overflow: visible;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background-color: var(--color-text-primary);
    transform: scaleX(var(--footer-line-draw, 1));
    transform-origin: left;
    z-index: 1;
  }


  .footer-container {
    max-width: var(--max-content-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  /* ── Top utility bar ── */
  .footer-bar {
    position: relative;
    display: flex;
    height: var(--nav-height);
  }

  /* Bottom border — draws left to right */
  .footer-bar::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-text-primary);
    transform: scaleX(var(--border-draw, 1));
    transform-origin: left;
  }

  .footer-palette {
    display: flex;
    flex-direction: column;
    align-self: stretch;
  }

  .footer-palette span {
    width: calc(var(--nav-height) / 6);
    height: calc(var(--nav-height) / 6);
  }

  .footer-bar-text {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-2);
    padding-right: 0;
  }

  .footer-wordmark-text {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-regular);
    font-size: var(--wordmark-size);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: calc(var(--page-margin) * 2);
    padding: var(--space-3) var(--space-3);
  }

  .footer-links {
    display: flex;
  }

  .footer-link {
    color: var(--color-text-primary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    transition: opacity var(--duration-short) ease;
  }

  /* Addresses read wrong in caps; keep the UI size but drop the transform */
  .footer-link--email {
    text-transform: none;
  }

  .footer-colophon-link {
    color: var(--color-text-secondary, var(--color-text-primary));
    opacity: var(--opacity-50);
    text-decoration: none;
    transition: opacity var(--duration-short) ease;
  }

  @media (hover: hover) {
    .footer-link:hover {
      opacity: var(--opacity-50);
    }

    .footer-colophon-link:hover {
      opacity: 1;
    }
  }

  /* ── Mobile ── */
  @media (--2x) {
    .footer-bar {
      height: auto;
      align-items: stretch;
    }

    /* Swatch column matches the wordmark row only, not the full bar.
       The wordmark box is its font-size (line-height 1) plus its block padding. */
    .footer-palette {
      align-self: flex-start;
      height: calc(var(--wordmark-size) + var(--space-4) * 2);
    }

    .footer-palette span {
      flex: 1;
      height: auto;
    }

    .footer-bar-text {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .footer-wordmark-text {
      font-size: var(--wordmark-size);
      padding-block: var(--space-4);
    }

    .footer-links {
      flex-direction: column;
      gap: 0;
      border-top: var(--border-width-1) solid var(--color-rule);
      padding-block: var(--space-3);
      /* Bleed past the text indent and the swatch column so the rule spans the whole bar */
      margin-left: calc((var(--space-2) + var(--nav-height) / 6) * -1);
      padding-left: var(--space-2);
    }

    .footer-link {
      min-height: 44px;
      display: flex;
      align-items: center;
      padding: var(--space-1) 0;
    }

    .footer-bottom {
      padding: var(--space-3);
    }
  }
</style>

<script>
  const PALETTE_COLORS = [
    '#24F266', '#F22434', '#FBE91E', '#2471F2', '#0B0D1B', '#ffffff',
  ]

  let paletteIntervalId: ReturnType<typeof setInterval> | null = null

  function initPaletteCycle() {
    // Clear previous interval to prevent accumulation across page navigations
    if (paletteIntervalId !== null) {
      clearInterval(paletteIntervalId)
      paletteIntervalId = null
    }

    const spans = document.querySelectorAll<HTMLSpanElement>('.footer-palette span')
    if (!spans.length) return

    // Respect reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    let offset = 0
    function paint() {
      spans.forEach((span, i) => {
        span.style.background = PALETTE_COLORS[((i + offset) % PALETTE_COLORS.length + PALETTE_COLORS.length) % PALETTE_COLORS.length]
      })
    }
    paint()

    // Shift all colors down by one position each tick
    paletteIntervalId = setInterval(() => { offset--; paint() }, 200)
  }

  initPaletteCycle()
  document.addEventListener('astro:page-load', () => {
    initPaletteCycle()
  })
  document.addEventListener('astro:before-swap', () => {
    if (paletteIntervalId !== null) {
      clearInterval(paletteIntervalId)
      paletteIntervalId = null
    }
  })
</script>
