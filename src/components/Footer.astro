---
import ContactEmail from './ContactEmail.astro'
import { animations } from '../data/tokens'

const logoSpin = `${animations.footerLogo.spinDuration}s`

const year = new Date().getFullYear()
// The build's date, so it changes only when the site does
const updated = new Date(__BUILD_DATE__).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'America/New_York' })
---

<footer class="footer">
  <div class="footer-container">
    <!-- Name bar -->
    <div class="footer-bar">
      <svg class="footer-logo" viewBox="0 0 1100 1100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M250.5 0C388.295 0 500 111.929 500 250V500H250.5C112.705 500 1 388.071 1 250C1 111.929 112.705 0 250.5 0Z" fill="#F22434"/>
        <path d="M500 850C500 988.071 388.071 1100 250 1100C111.929 1100 -1.60836e-06 988.071 0 850C1.81059e-05 711.929 111.929 600 250 600H500V850Z" fill="#E5C800"/>
        <path d="M850 0C988.071 6.03528e-06 1100 111.929 1100 250C1100 388.071 988.071 500 850 500H600V250C600 111.929 711.929 2.21346e-06 850 0Z" fill="#00CC55"/>
        <path d="M850 600C988.071 600 1100 711.929 1100 850C1100 988.071 988.071 1100 850 1100C711.929 1100 600 988.071 600 850V600H850Z" fill="#2471F2"/>
      </svg>
      <div class="footer-bar-text">
        <p class="footer-wordmark-text">Sam Stringer-Hye</p>
        <nav class="footer-links" aria-label="Footer links">
          <ContactEmail class="footer-link typo-body-lg" />
          <a href="https://linkedin.com/in/samstringerhye" target="_blank" rel="noopener noreferrer" class="footer-link typo-body-lg">LinkedIn <span class="visually-hidden">(opens in new tab)</span></a>
        </nav>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copyright typo-ui-caps">&copy; {year} · Updated {updated}</p>
      <a href="/colophon" class="footer-colophon-link typo-ui-caps">Colophon</a>
    </div>
  </div>
</footer>

<style define:vars={{ logoSpin }}>
  .footer {
    margin-top: 0;
    position: relative;
    overflow: visible;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background-color: var(--color-text-primary);
    transform: scaleX(var(--footer-line-draw, 1));
    transform-origin: left;
    z-index: 1;
  }


  .footer-container {
    max-width: var(--max-content-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  /* ── Top utility bar ── */
  .footer-bar {
    position: relative;
    display: flex;
    height: var(--nav-height);
  }

  /* Bottom border — draws left to right */
  .footer-bar::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-text-primary);
    transform: scaleX(var(--border-draw, 1));
    transform-origin: left;
  }

  /* The site mark, turning slowly beside the name; still under reduced motion */
  .footer-logo {
    flex-shrink: 0;
    align-self: center;
    width: var(--wordmark-size);
    height: var(--wordmark-size);
    animation: footer-logo-spin var(--logoSpin) linear infinite;
  }

  @keyframes footer-logo-spin {
    to { transform: rotate(1turn); }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-logo {
      animation: none;
    }
  }

  .footer-bar-text {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-2);
    padding-right: 0;
  }

  .footer-wordmark-text {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-regular);
    font-size: var(--wordmark-size);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: calc(var(--page-margin) * 2);
    padding: var(--space-3) var(--space-3);
  }

  .footer-links {
    display: flex;
  }

  /* :global because the email link is rendered by ContactEmail, outside this component's scope */
  .footer-links :global(.footer-link) {
    color: var(--color-text-primary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    transition: opacity var(--duration-short) ease;
  }

  .footer-colophon-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--color-text-secondary, var(--color-text-primary));
    text-decoration: none;
    transition: opacity var(--duration-short) ease;
  }

  @media (hover: hover) {
    .footer-links :global(.footer-link):hover {
      opacity: var(--opacity-50);
    }

    .footer-colophon-link:hover {
      opacity: var(--opacity-50);
    }
  }

  /* ── Mobile ── */
  @media (--2x) {
    .footer-bar {
      height: auto;
      align-items: stretch;
    }

    /* Swatch column matches the wordmark row only, not the full bar.
       The wordmark box is its font-size (line-height 1) plus its block padding. */
    .footer-logo {
      align-self: flex-start;
      margin-top: var(--space-4);
    }

    .footer-bar-text {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .footer-wordmark-text {
      font-size: var(--wordmark-size);
      padding-block: var(--space-4);
    }

    .footer-links {
      flex-direction: column;
      gap: 0;
      border-top: var(--border-width-1) solid var(--color-rule);
      padding-block: var(--space-3);
      /* Bleed past the text indent and the swatch column so the rule spans the whole bar */
      margin-left: calc((var(--space-2) + var(--nav-height) / 6) * -1);
      padding-left: var(--space-2);
    }

    .footer-links :global(.footer-link) {
      min-height: 44px;
      display: flex;
      align-items: center;
      padding: var(--space-1) 0;
    }

    .footer-bottom {
      padding: var(--space-3);
    }
  }
</style>

