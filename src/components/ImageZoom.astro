---
// Click or tap a case-study image to see it full screen; the image (or "Actual size") toggles
// between fit-to-screen and its full resolution, which scrolls. Esc, Close or the backdrop exit.
---

<dialog class="image-zoom" aria-label="Enlarged image">
  <div class="image-zoom-bar">
    <button type="button" class="image-zoom-btn typo-ui-caps" data-zoom-toggle aria-pressed="false">Actual size</button>
    <button type="button" class="image-zoom-btn typo-ui-caps" data-zoom-close>Close</button>
  </div>
  <div class="image-zoom-scroll">
    <img class="image-zoom-img" alt="" decoding="async" />
  </div>
</dialog>

<style is:global>
  .case-study-body img.is-zoomable {
    cursor: zoom-in;
  }

  .image-zoom {
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-text-primary);
    background: var(--color-bg-primary);
  }

  .image-zoom::backdrop {
    background: var(--color-bg-primary);
  }

  .image-zoom-bar {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1;
    display: flex;
    gap: var(--space-1);
    padding: var(--space-2);
  }

  .image-zoom-btn {
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    font: inherit;
    color: var(--color-bg-primary);
    background: var(--color-text-primary);
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }

  .image-zoom-scroll {
    display: flex;
    width: 100%;
    height: 100%;
    overflow: auto;
    overscroll-behavior: contain;
  }

  /* margin: auto centers the image when it fits and keeps its edges reachable when it overflows */
  .image-zoom-img {
    display: block;
    margin: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
  }

  .image-zoom.is-actual .image-zoom-img {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }
</style>

<script>
  type Lenis = { stop: () => void; start: () => void }
  const lenis = () => (window as Window & { __siteLenis?: Lenis | null }).__siteLenis

  // Largest srcset candidate, so the zoomed view has the detail the inline one was missing
  function largestSource(img: HTMLImageElement) {
    const candidates = (img.getAttribute('srcset') ?? '')
      .split(',')
      .map(c => c.trim().split(/\s+/))
      .filter(([url, w]) => url && w?.endsWith('w'))
      .map(([url, w]) => ({ url, w: parseInt(w, 10) }))
      .sort((a, b) => b.w - a.w)
    return candidates[0]?.url ?? img.currentSrc ?? img.src
  }

  function isZoomCandidate(img: HTMLImageElement) {
    if (img.classList.contains('cs-hero-subject')) return false
    if (img.closest('[aria-hidden="true"], [data-no-zoom], a, button, .image-zoom')) return false
    // Icons and small marks gain nothing from enlarging
    return img.getBoundingClientRect().width >= 160 || img.naturalWidth >= 480
  }

  function initImageZoom() {
    const dialog = document.querySelector<HTMLDialogElement>('dialog.image-zoom')
    const body = document.querySelector('.case-study-body')
    if (!dialog || !body || dialog.dataset.bound) return
    dialog.dataset.bound = 'true'

    const zoomImg = dialog.querySelector<HTMLImageElement>('.image-zoom-img')!
    const toggle = dialog.querySelector<HTMLButtonElement>('[data-zoom-toggle]')!
    const close = dialog.querySelector<HTMLButtonElement>('[data-zoom-close]')!

    function setActual(actual: boolean) {
      // Full resolution on this screen: one image pixel per device pixel
      zoomImg.style.width = actual && zoomImg.naturalWidth ? `max(${zoomImg.naturalWidth / window.devicePixelRatio}px, 100%)` : ''
      dialog!.classList.toggle('is-actual', actual)
      toggle.setAttribute('aria-pressed', String(actual))
      toggle.textContent = actual ? 'Fit to screen' : 'Actual size'
    }

    function open(img: HTMLImageElement) {
      setActual(false)
      zoomImg.src = largestSource(img)
      zoomImg.alt = img.alt
      dialog!.showModal()
      lenis()?.stop()
    }

    dialog.addEventListener('close', () => {
      lenis()?.start()
      zoomImg.removeAttribute('src')
    })
    close.addEventListener('click', () => dialog.close())
    toggle.addEventListener('click', () => setActual(!dialog.classList.contains('is-actual')))
    zoomImg.addEventListener('click', () => setActual(!dialog.classList.contains('is-actual')))
    // A click on the dialog itself (not the image or buttons) is a click on the backdrop area
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('.image-zoom-scroll')) dialog.close()
    })

    body.querySelectorAll<HTMLImageElement>('img').forEach(img => {
      if (!isZoomCandidate(img)) return
      img.classList.add('is-zoomable')
      img.tabIndex = 0
      img.setAttribute('role', 'button')
      img.setAttribute('aria-haspopup', 'dialog')
      img.setAttribute('aria-label', img.alt ? `Enlarge image: ${img.alt}` : 'Enlarge image')
      img.addEventListener('click', () => open(img))
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(img) }
      })
    })
  }

  initImageZoom()
  document.addEventListener('astro:page-load', initImageZoom)
</script>
