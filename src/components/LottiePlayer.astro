---
/**
 * Inline Lottie animation player.
 * Loads animation JSON at build time and plays on viewport entry.
 */
interface Props {
  /** Path to the Lottie JSON file (relative to project root) */
  src: string
  /** Accessible label */
  label: string
  /** Whether to loop (default: true) */
  loop?: boolean
  /** Whether to autoplay on viewport entry (default: true) */
  autoplay?: boolean
  /** Play at the asset’s authored timing instead of the decorative reverse loop. */
  nativeLoop?: boolean
  /** Max width constraint */
  maxWidth?: string
  /** Visible playback control for case-study motion evidence. */
  controls?: boolean
}

const { src, label, loop = true, autoplay = true, nativeLoop = false, maxWidth = '200px', controls = false } = Astro.props

import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'

let animationData: string | null = null
try {
  const filePath = resolve(process.cwd(), src)
  animationData = readFileSync(filePath, 'utf-8')
} catch (e) {
  console.warn(`LottiePlayer: Could not read ${src}`)
}
---

{animationData && (
  <div class="lottie-example">
  <div
    class="lottie-player"
    data-animation={animationData}
    data-loop={String(loop)}
    data-autoplay={String(autoplay)}
    data-native-loop={String(nativeLoop)}
    role="img"
    aria-label={label}
    style={`max-width: ${maxWidth}; margin: 0 auto;`}
  />
  {controls && <button class="lottie-toggle" type="button" disabled aria-label={`Play ${label}`}>Play</button>}
  </div>
)}

<style>
  .lottie-player {
    width: 100%;
    aspect-ratio: 1;
  }
  .lottie-toggle {
    display: block;
    min-height: var(--touch-target);
    margin: var(--space-2) auto;
    padding: var(--space-1) var(--space-3);
    border: 1px solid currentColor;
    border-radius: 999px;
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    cursor: pointer;
  }
</style>

<script>
  import { animations } from '../data/tokens'

  let observer: IntersectionObserver | null = null
  let preloadObserver: IntersectionObserver | null = null
  const tweens = new Set<any>()
  const instances = new Set<any>()
  let generation = 0

  function destroyLottie() {
    generation += 1
    observer?.disconnect()
    observer = null
    preloadObserver?.disconnect()
    preloadObserver = null
    tweens.forEach(tween => tween.kill())
    tweens.clear()
    instances.forEach(anim => anim.destroy())
    instances.clear()
    document.querySelectorAll<HTMLElement>('.lottie-player[data-initialized]').forEach(el => {
      delete el.dataset.initialized
    })
    document.querySelectorAll<HTMLButtonElement>('.lottie-toggle').forEach(button => {
      button.onclick = null
      button.disabled = true
    })
  }

  // The player and gsap load only once an animation nears the viewport
  let depsPromise: Promise<{ lottie: any; gsap: any }> | null = null
  function loadDeps() {
    depsPromise ??= Promise.all([
      import('lottie-web/build/player/lottie_light'),
      import('gsap'),
    ]).then(([lottieMod, gsapMod]) => ({
      lottie: (lottieMod as any).default || lottieMod,
      gsap: (gsapMod as any).default || gsapMod,
    }))
    return depsPromise
  }

  async function startPlayer(el: HTMLElement, prefersReduced: boolean) {
    const currentGeneration = generation
    let lottie: any
    let gsap: any
    try {
      ({ lottie, gsap } = await loadDeps())
    } catch (e) {
      console.warn('LottiePlayer: Failed to load dependencies', e)
      depsPromise = null
      delete el.dataset.initialized
      return
    }
    if (currentGeneration !== generation || !el.isConnected) return
    try {
      const animData = JSON.parse(el.dataset.animation!)
      const nativeLoop = el.dataset.nativeLoop === 'true'
      const anim = lottie.loadAnimation({
        container: el,
        renderer: 'svg',
        loop: nativeLoop && !prefersReduced,
        autoplay: false,
        animationData: animData,
      })
      instances.add(anim)
      let playbackTween: any = null
      // Lottie completes JSON setup asynchronously. totalFrames is still zero immediately
      // after loadAnimation, so creating the frame tween there targets frame -1.
      const ready = () => {
        anim.removeEventListener('DOMLoaded', ready)
        if (currentGeneration !== generation || !el.isConnected) return
        if (prefersReduced || el.dataset.autoplay !== 'true') {
          anim.goToAndStop(Math.floor(anim.totalFrames / 2), true)
        } else if (nativeLoop) {
          anim.play()
        } else if (el.dataset.loop === 'true') {
          const obj = { frame: 0 }
          const tween = gsap.to(obj, {
            frame: anim.totalFrames - 1,
            duration: animations.lottie.loopDuration,
            ease: 'power2.inOut',
            repeat: -1,
            yoyo: true,
            repeatDelay: animations.lottie.loopRepeatDelay,
            onUpdate: () => anim.goToAndStop(obj.frame, true),
          })
          tweens.add(tween)
          playbackTween = tween
        } else {
          anim.play()
        }
        const button = el.parentElement?.querySelector<HTMLButtonElement>('.lottie-toggle')
        if (button) {
          let playing = !prefersReduced && el.dataset.autoplay === 'true'
          const updateControl = () => {
            button.textContent = playing ? 'Pause' : 'Play'
            button.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} ${el.getAttribute('aria-label')}`)
          }
          button.disabled = false
          updateControl()
          button.onclick = () => {
            playing = !playing
            if (playbackTween) {
              playing ? playbackTween.resume() : playbackTween.pause()
            } else if (playing) {
              anim.loop = el.dataset.loop === 'true'
              anim.play()
            } else {
              anim.pause()
            }
            updateControl()
          }
        }
      }
      if (anim.isLoaded) ready()
      else anim.addEventListener('DOMLoaded', ready)
    } catch (e) {
      console.warn('LottiePlayer: Failed to init animation', e)
    }
  }

  function initLottie() {
    const players = document.querySelectorAll<HTMLElement>('.lottie-player[data-animation]')
    if (players.length === 0) return

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    destroyLottie()
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const el = entry.target as HTMLElement
        if (entry.isIntersecting && !el.dataset.initialized) {
          el.dataset.initialized = 'true'
          startPlayer(el, prefersReduced)
        }
      })
    }, { threshold: 0.1 })

    // Fetch the player a screen or so ahead, so it's ready when the animation comes into view
    const preload = new IntersectionObserver((entries) => {
      if (entries.some(entry => entry.isIntersecting)) {
        loadDeps().catch(() => { depsPromise = null })
        preload.disconnect()
      }
    }, { rootMargin: '600px 0px' })

    observer = io
    preloadObserver = preload
    players.forEach(p => { io.observe(p); preload.observe(p) })
  }

  function deferLottie() {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => initLottie(), { timeout: 3000 })
    } else {
      setTimeout(initLottie, 2000)
    }
  }

  deferLottie()
  document.addEventListener('astro:page-load', deferLottie)
  document.addEventListener('astro:before-swap', destroyLottie)
  window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', initLottie)
</script>
