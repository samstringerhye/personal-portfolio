---
// A coded phone scene for a work card: the live screen plays a scripted tour of the app, inside
// the iPhone 17 Pro model once it loads (phone-scene/model.ts). Until then, or if WebGL is
// unavailable, the flat phone shows. Reduced motion holds on the home screen.
interface Props {
  scene: 'myfrontier'
  label: string
}
const { scene, label } = Astro.props
---

<div class="phone-scene" data-phone-scene={scene} role="img" aria-label={label}></div>

<style is:global>
  /* The scene builds its own DOM, so these rules are global, scoped by .phone-scene */
  .phone-scene { position: absolute; inset: 0; display: grid; place-items: center; container-type: size; pointer-events: none; }
  .phone-scene .floor { position: absolute; left: 50%; top: 93%; width: 34cqh; height: 6cqh; border-radius: 50%; background: radial-gradient(closest-side, rgba(11, 13, 27, 0.3), rgba(11, 13, 27, 0)); translate: -50% -50%; filter: blur(1.4cqh); }
  .phone-scene .stage, .phone-scene .stage > * { position: absolute; inset: 0; }
  .phone-scene .stage canvas { width: 100%; height: 100%; }
  .phone-scene-view { overflow: hidden; }
  /* Flat fallback: fit the stage. In 3D the model supplies the band and bezel */
  .phone-scene:not(.is-3d) .phone { width: auto; height: 84%; }
  /* The model fades in over the flat phone once it has warmed up */
  .phone-scene.is-3d .stage { animation: phone-scene-in 0.5s ease both; }
  @keyframes phone-scene-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .phone-scene.is-3d .stage { animation: none; } }
  .phone-scene.is-3d .band, .phone-scene.is-3d .bezel { padding: 0; background: none; border-radius: 0; width: 100%; height: 100%; }

  .phone-scene .phone { position: relative; width: 360px; aspect-ratio: 0.4785; container-type: inline-size; }
  .phone-scene .sheen { position: absolute; inset: 0; z-index: 6; pointer-events: none; background: linear-gradient(115deg, rgba(255,255,255,0) 30%, rgba(255,255,255,.13) 45%, rgba(255,255,255,0) 60%); background-size: 260% 260%; background-position: var(--sx, 50%) var(--sy, 50%); mix-blend-mode: screen; }
  .phone-scene .band { position: absolute; inset: 0; border-radius: 17cqw; padding: .9cqw;
    background: linear-gradient(135deg, #b9bbbf 0%, #6c6f75 22%, #3f4248 50%, #5d6067 78%, #a7a9ad 100%);
    transform: translateZ(0); }
  .phone-scene .bezel { width: 100%; height: 100%; border-radius: 16.1cqw; padding: 1.6cqw; background: #050506; }
  .phone-scene .screen { position: relative; width: 100%; height: 100%; border-radius: 14.4cqw; overflow: hidden; background: #151A2A; }
  .phone-scene .layer { position: absolute; inset: 0; }
  .phone-scene .layer img.view { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* The published art was drawn on an older notched phone: cover its status bar, then set the
     time and icons back down level with the Dynamic Island */
  .phone-scene .notch { position: absolute; inset: 0 0 auto 0; height: 4.4%; }
  .phone-scene .sb { position: absolute; top: 1.55%; height: 2.35%; width: auto; }
  .phone-scene .sb.l { left: 8.5%; }
  .phone-scene .sb.r { right: 7%; height: 1.45%; top: 2.05%; }
  .phone-scene .sheet .notch, .phone-scene .sheet .sb { display: none; }
  .phone-scene .dim { position: absolute; inset: 0; background: rgba(10, 14, 30, .55); opacity: 0; }
  .phone-scene .dots { position: absolute; inset: 0; width: 100%; height: 100%; display: none; z-index: 2; }
  .phone-scene .wash { position: absolute; inset: 0; background: #ff033a; clip-path: circle(0 at 50% 85%); }
  .phone-scene .lottie { position: absolute; left: 50%; top: 50%; width: 52cqw; aspect-ratio: 1; translate: -50% -50%; }
  .phone-scene .lottie.intro { top: var(--intro-y, 47.5%); width: var(--intro-w, 70cqw); opacity: 0; }
  .phone-scene .logo-cover { position: absolute; left: 15%; top: 32%; width: 72%; height: 32%; background: #ff033a; }
  .phone-scene .spin { position: absolute; left: 50%; top: 13.5%; width: 7cqw; aspect-ratio: 1; translate: -50% 0; opacity: 0; z-index: 3; }
  .phone-scene .spin svg { width: 100%; height: 100%; display: block; }
  .phone-scene .tap { position: absolute; width: 22cqw; aspect-ratio: 1; border-radius: 50%; background: rgba(255,255,255,.55); box-shadow: 0 0 0 .4cqw rgba(11,15,26,.12); translate: -50% -50%; opacity: 0; pointer-events: none; z-index: 4; }
  .phone-scene .island { position: absolute; inset: 2.7cqw auto auto 50%; translate: -50% 0; width: 32cqw; height: 9.4cqw; border-radius: 5cqw; background: #000; z-index: 5; overflow: hidden; }
  .phone-scene .fid { position: absolute; left: 50%; top: 50%; width: 68cqw; aspect-ratio: 440 / 370; translate: -50% -50%; opacity: 0; }
</style>
