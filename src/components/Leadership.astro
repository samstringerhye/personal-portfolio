---
/**
 * How I lead: the heading pinned on the left (desktop) beside numbered principle panels, two up.
 * Same split as Selected Work and Experience. Data in home.json leadership.
 */
import type { HeadingTag, TypographyRole } from '../types/typography'

interface Props {
  headline: string
  items: { title: string; body: string; link?: { href: string; label: string } }[]
  headingTag?: HeadingTag
  headingRole?: TypographyRole
  itemTitleRole?: TypographyRole
  itemBodyRole?: TypographyRole
}

const {
  headline, items,
  headingTag = 'h2', headingRole = 'headline-lg',
  itemTitleRole = 'headline-sm', itemBodyRole = 'body-lg',
} = Astro.props as Props
const HeadingTag = headingTag as any
---

<section class="leadership-section ld" aria-labelledby="leadership-heading">
  <div class="ld-intro">
    <div class="ld-intro-inner">
      <HeadingTag id="leadership-heading" class:list={["leadership-heading", `typo-${headingRole}`]} data-reveal>{headline}</HeadingTag>
    </div>
  </div>
  <ul class="ld-list" role="list" data-reveal-group>
    {items.map(item => (
      <li class="ld-item" data-reveal="fade">
        <div class="ld-text">
          <h3 class:list={["ld-title", `typo-${itemTitleRole}`]}>{item.title}</h3>
          <p class:list={["ld-body", `typo-${itemBodyRole}`]}>{item.body}</p>
          {item.link && (
            <a href={item.link.href} class:list={["ld-link ek-link", `typo-${itemBodyRole}`]}>{item.link.label}<span class="ek-arrow" aria-hidden="true">→</span></a>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .leadership-heading {
    margin: 0;
    color: var(--color-text-primary);
  }

  .ld-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Text settled at the bottom, so a row of panels reads as one band */
  .ld-item {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-7);
    min-height: clamp(14rem, 18vw, 18rem);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    border-radius: var(--ek-window-radius, 24px);
    background: var(--ek-panel, var(--color-bg-alt));
  }

  .ld-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ld-title,
  .ld-body {
    margin: 0;
    color: var(--color-text-primary);
  }

  .ld-body {
    color: var(--ek-ink-body, var(--color-text-primary));
  }

  .ld-link {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  @media (--2x) {
    .ld-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .ld-item {
      gap: var(--space-5);
      min-height: 0;
    }
  }
</style>
