---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  /** Unmodified 2× exports; CSS caps each image at its original design width. */
  examples: { image: ImageMetadata; label: string; alt: string }[]
  columns?: 2 | 4
  layout?: 'equal' | 'section'
}

const { examples, columns = 4, layout = 'equal' } = Astro.props
---

<div class:list={['component-examples', columns === 2 && 'component-examples--pair', layout === 'section' && 'component-examples--section']}>
  {examples.map(({ image, label, alt }) => (
    <figure class="component-example">
      <Image src={image} format="png" alt={alt} loading="lazy" style={`--source-width: ${image.width / 2}px`} />
      <figcaption>{label}</figcaption>
    </figure>
  ))}
</div>

<style>
  .component-examples {
    /* Export boards keep a light surface in both site themes. */
    --ek-ink-body: #34475C;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .component-examples--pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .component-examples--section {
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    align-items: center;
  }

  .component-example {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    margin: 0;
  }

  .component-example img {
    display: block;
    width: min(100%, var(--source-width));
    height: auto;
    margin: 0;
  }

  .component-example figcaption {
    margin: 0;
    font-size: var(--text-75);
    color: var(--ek-ink-body);
    text-align: center;
  }

  @container (max-width: 40rem) {
    .component-examples {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
      padding: var(--space-4);
    }
  }

  @container (max-width: 34rem) {
    .component-examples--pair {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
