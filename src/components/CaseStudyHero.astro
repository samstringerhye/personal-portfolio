---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import BackToWork from './BackToWork.astro'

interface Props {
  subject: ImageMetadata
  background: string
  heroOffset?: number
  alt: string
  title: string
  tagline?: string
  year?: number
  tone?: 'light' | 'dark'
}

const { subject, background, heroOffset = 0, alt, title, tagline, year, tone = 'dark' } = Astro.props
---

<!-- Same layers and text as the homepage card, so the card's zoom lands on an identical hero.
     Text styles live in global.css (.cs-hero-*) so the homepage can measure them. -->
<div class:list={['cs-hero', { 'cs-hero--light': tone === 'light' }]}>
  <div class="cs-hero-media cs-hero-size" data-cs-hero style={`--hero-offset: ${heroOffset}; background: ${background}`}>
    <Image
      class="cs-hero-subject"
      src={subject}
      alt={alt}
      layout="full-width"
      sizes="100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  {year && <p class="cs-hero-year typo-ui-caps">{year}</p>}
  <BackToWork class="cs-hero-back" />
  <div class="cs-hero-text">
    <h1 class="cs-hero-title typo-display-md">{title}</h1>
    {tagline && <p class="cs-hero-tagline typo-title-lg">{tagline}</p>}
  </div>
</div>

<style>
  /* Size container so the subject shift can use the rendered image height (cover: the larger of
     the frame height and width / 1.5 for 3:2 art) */
  .cs-hero-media {
    position: relative;
    overflow: hidden;
    container-type: size;
  }

  /* Overrides the case study's default image treatment (page-colored background, contain, 100vh cap,
     and the transparency checker's padding), which would hide the background behind this subject */
  :global(.case-study-body) .cs-hero-media :global(img.cs-hero-subject) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    max-height: none;
    padding: 0;
    object-fit: cover;
    background: none;
    filter: drop-shadow(0 18px 22px rgba(11, 13, 27, 0.22));
    /* Centers subjects that the card art sits above center to leave room for the card's title */
    translate: 0 calc(var(--hero-offset, 0) * max(100cqh, 66.667cqw));
  }
</style>

<script>
  // Card ↔ hero zoom (also registers the reverse zoom back to the homepage)
  import './work-transition'
</script>
