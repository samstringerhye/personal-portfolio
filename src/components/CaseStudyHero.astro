---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import PasswordGate from './PasswordGate.astro'
import ScrollCue from './ScrollCue.astro'
import { boundsAttr, narrowArtStyle, type SubjectBox } from './narrow-art'

interface Props {
  subject: ImageMetadata
  background: string
  heroOffset?: number
  subjectBox?: SubjectBox
  subjectBounds?: SubjectBox
  alt: string
  title: string
  tagline?: string
  year?: number | string
  tone?: 'light' | 'dark'
  // Set when the case study is password-protected and locked: the form replaces the art
  gate?: { error?: boolean; rateLimited?: boolean }
}

const { subject, background, heroOffset = 0, subjectBox, subjectBounds, alt, title, tagline, year, tone = 'dark', gate } = Astro.props
---

<!-- Same layers and text as the homepage card. Text styles live in global.css (.cs-hero-*). -->
<div
  class:list={['cs-hero', { 'cs-hero--light': tone === 'light', 'is-gated': gate && (gate.error || gate.rateLimited) }]}
  style={`--hero-bg: ${background}; ${narrowArtStyle(subjectBox, subjectBounds)}`}
  data-subject-bounds={boundsAttr(subjectBounds ?? subjectBox)}
  data-hero-offset={heroOffset}
>
  <div class="cs-hero-media cs-hero-size" data-cs-hero style={`--hero-offset: ${heroOffset}; background: ${background}`}>
    <Image
      class="cs-hero-subject"
      src={subject}
      alt={alt}
      layout="full-width"
      sizes="100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
    {gate && <PasswordGate title={title} error={gate.error} rateLimited={gate.rateLimited} />}
  </div>
  {year && <p class="cs-hero-year typo-ui-caps" hidden>{year}</p>}
  <div class="cs-hero-text">
    <h1 class="cs-hero-title typo-display-md">{title}</h1>
    {tagline && <p class="cs-hero-tagline typo-title-lg">{tagline}</p>}
    {!gate && <ScrollCue />}
  </div>
</div>

<style>
  /* Size container so the subject shift can use the rendered image height (cover: the larger of
     the frame height and width / 1.5 for 3:2 art) */
  .cs-hero-media {
    position: relative;
    overflow: hidden;
    container-type: size;
  }

  /* Overrides the case study's default image treatment (page-colored background, contain, 100vh cap,
     and the transparency checker's padding), which would hide the background behind this subject */
  :global(.case-study-body) .cs-hero-media :global(img.cs-hero-subject) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    max-height: none;
    padding: 0;
    object-fit: cover;
    background: none;
    filter: drop-shadow(0 18px 22px rgba(11, 13, 27, 0.22));
    /* Centers subjects that the card art sits above center to leave room for the card's title */
    translate: 0 calc(var(--hero-offset, 0) * max(100cqh, 66.667cqw));
  }

  /* Narrow: the subject framed in the padded image box, like the work cards (global.css) */
  @container (max-width: 780px) {
    :global(.case-study-body) .cs-hero-media :global(img.cs-hero-subject) {
      position: absolute;
      left: var(--narrow-art-left);
      top: var(--narrow-art-top);
      width: var(--narrow-art-width);
      height: var(--narrow-art-height);
      max-width: none;
      translate: none;
      filter: none;
    }
  }

  /* Wide but stacked (hero-fit.ts): framed the same way, above the title */
  :global(.case-study-body .cs-hero--stacked) .cs-hero-media :global(img.cs-hero-subject) {
    position: absolute;
    left: var(--narrow-art-left);
    top: var(--narrow-art-top);
    width: var(--narrow-art-width);
    height: var(--narrow-art-height);
    max-width: none;
    translate: none;
    filter: none;
  }

  /* Locked case study: the art and title crossfade with the form (PasswordGate) */
  :global(.cs-hero:has([data-password-gate])) :global(img.cs-hero-subject),
  :global(.cs-hero:has([data-password-gate])) :global(.cs-hero-text) {
    transition: opacity var(--duration-medium) var(--easing-standard);
  }

  :global(.cs-hero.is-gated) :global(img.cs-hero-subject),
  :global(.cs-hero.is-gated) :global(.cs-hero-text) {
    opacity: 0;
  }
</style>

<script>
  import { fitHero, heroFitData } from './hero-fit'

  // Stack the hero whenever its title would meet the art: on load, on resize, and once the web fonts
  // (which change the title's wrapping) are in
  let observer: ResizeObserver | null = null

  function fit() {
    const hero = document.querySelector<HTMLElement>('.cs-hero[data-subject-bounds]')
    const frame = hero?.querySelector<HTMLElement>('[data-cs-hero]')
    const data = hero && heroFitData(hero)
    if (hero && frame && data) fitHero(hero, frame, data.bounds, data.offset)
  }

  function watch() {
    observer?.disconnect()
    const hero = document.querySelector<HTMLElement>('.cs-hero[data-subject-bounds]')
    if (!hero) return
    fit()
    // Width changes come through the observer; height changes (which resize the frame) through resize
    let last = hero.offsetWidth
    observer = new ResizeObserver(() => {
      if (hero.offsetWidth === last) return
      last = hero.offsetWidth
      fit()
    })
    observer.observe(hero)
  }

  watch()
  window.addEventListener('resize', fit)
  document.fonts?.ready.then(fit)
  document.addEventListener('astro:page-load', watch)
</script>
