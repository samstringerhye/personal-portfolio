---
const pathname = Astro.url.pathname

const links = [
  { href: '/', label: 'Home' },
  { href: '/#work', label: 'Work' },
  { href: '/about', label: 'About' },
]

const inWork = pathname === '/work' || pathname.startsWith('/work/')

function isActive(href: string) {
  if (href === '/') return pathname === '/'
  // Work is a homepage section, so only its case study pages light it up from elsewhere
  if (href === '/#work') return inWork
  return pathname.startsWith(href)
}
---

<header class="nav" id="site-nav">
  <nav class="nav-inner" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label="Sam Stringer-Hye, home">
      Sam Stringer-Hye
    </a>

    <ul class="nav-links" id="nav-links" role="list">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', 'typo-ui', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? (link.href === '/#work' ? 'true' : 'page') : undefined}
            data-astro-prefetch="hover"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-bg-primary);
    padding-top: env(safe-area-inset-top);
  }

  .nav::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--border-width-1);
    background: var(--color-rule);
    transform: scaleX(var(--line-draw, 0));
    transform-origin: left;
  }

  .nav-inner {
    display: flex;
    align-items: stretch;
    gap: var(--space-1);
    height: var(--nav-height);
    max-width: var(--max-content-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    padding-inline: var(--space-3);
    position: relative;
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: var(--text-200);
    transition: background-color var(--duration-medium) ease;
    opacity: 0;
    transform: translateY(-12px);
  }

  .nav-logo::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--border-width-1);
    background: var(--color-rule);
    transform: scaleY(var(--line-draw, 0));
    transform-origin: top;
    z-index: 1;
  }

  .nav-links {
    display: flex;
    align-items: stretch;
    list-style: none;
    flex-shrink: 0;
    margin-left: auto;
  }

  .nav-links li {
    display: flex;
    position: relative;
    transition: background-color var(--duration-medium) ease;
  }

  .nav-links li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--border-width-1);
    background: var(--color-rule);
    transform: scaleY(var(--line-draw, 0));
    transform-origin: top;
    z-index: 1;
  }

  .nav-link {
    display: flex;
    flex: 1;
    align-items: center;
    padding-inline: var(--space-3);
    color: var(--color-text-primary);
    text-decoration: none;
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    opacity: 0;
    transform: translateY(-12px);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: var(--nav-toggle-gap);
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    align-items: center;
    justify-content: center;
    padding: var(--space-1);
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-toggle-bar {
    display: block;
    width: var(--nav-toggle-bar-width);
    height: var(--nav-toggle-bar-height);
    background: var(--color-text-primary);
    border-radius: var(--radius-xs);
    transition: transform var(--duration-long) ease, opacity var(--duration-long) ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-logo,
    .nav-link {
      opacity: 1;
    }
    .nav,
    .nav-logo,
    .nav-links li {
      --line-draw: 1 !important;
    }
  }

  @media (--2x) {
    .nav::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: var(--border-width-1);
      background: var(--color-rule);
    }

    .nav-logo {
      flex: 1;
    }

    .nav-logo::after {
      display: none;
    }

    .nav-toggle {
      display: flex;
      margin-left: auto;
      border-left: var(--border-width-1) solid var(--color-rule);
      aspect-ratio: 1;
      height: var(--nav-height);
      width: auto;
      min-width: unset;
      min-height: unset;
      padding: 0;
    }

    /* An explicit height, not bottom: 0, so the panel reaches the screen's bottom edge */
    .nav-links {
      position: fixed;
      top: calc(var(--nav-height) + env(safe-area-inset-top));
      left: 0;
      right: 0;
      height: calc(100dvh - var(--nav-height) - env(safe-area-inset-top));
      flex-direction: column;
      align-items: stretch;
      padding: 0;
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--color-bg-primary);
      transform: translateX(100%);
      transition: transform var(--duration-long) ease, visibility 0s var(--duration-long);
      visibility: hidden;
      overflow: hidden;
    }

    .nav-links li {
      flex: none;
    }

    .nav-links li::before {
      display: none;
    }

    .nav-links.open {
      transform: translateX(0);
      visibility: visible;
      transition: transform var(--duration-long) ease, visibility 0s 0s;
    }

    /* Labels on the page margin, in line with the logo */
    .nav-link {
      margin-inline: var(--page-margin);
      padding: var(--space-3) 0;
      font-family: var(--font-sans);
      font-size: var(--text-200);
      font-weight: var(--font-weight-light);
      letter-spacing: var(--tracking-tight);
      border-bottom: var(--border-width-1) solid var(--color-rule);
    }


    @media (prefers-reduced-motion: reduce) {
      .nav-links {
        transition: none;
      }
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:first-child {
      transform: translateY(calc((var(--nav-toggle-gap) + var(--nav-toggle-bar-height)) / 2)) rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:last-child {
      transform: translateY(calc((var(--nav-toggle-gap) + var(--nav-toggle-bar-height)) / -2)) rotate(-45deg);
    }
  }
</style>

<script>
  import { animations } from '../data/tokens'
  import './contact-email'

  type NavWindow = Window & {
    __navAfterSwapHandler?: () => void
  }

  function initNav() {
    const toggle = document.getElementById('nav-toggle')
    const links = document.getElementById('nav-links')
    if (!toggle || !links) return
    if (toggle.dataset.navBound === 'true') return

    toggle.dataset.navBound = 'true'

    let removeTrap: (() => void) | null = null

    // Disable tab access to hidden mobile nav links
    function setNavLinksTabindex(enabled: boolean) {
      links!.querySelectorAll<HTMLElement>('a, button').forEach(el => {
        if (enabled) el.removeAttribute('tabindex')
        else el.setAttribute('tabindex', '-1')
      })
    }

    // Start with links hidden from tab order on mobile
    if (window.matchMedia('(max-width: 768px)').matches) {
      setNavLinksTabindex(false)
    }
    window.matchMedia('(max-width: 768px)').addEventListener('change', (e) => {
      if (!e.matches) {
        if (toggle!.getAttribute('aria-expanded') === 'true') closeNav()
        setNavLinksTabindex(true)
      } else if (toggle!.getAttribute('aria-expanded') !== 'true') setNavLinksTabindex(false)
    })

    // While the mobile menu is open, the page behind it can't be scrolled, tabbed to or read
    function setPageLocked(locked: boolean) {
      document.querySelectorAll<HTMLElement>('#main, .footer, .skip-to-content').forEach(el => {
        el.inert = locked
      })
      document.documentElement.classList.toggle('nav-open', locked)
      const lenis = (window as Window & { __siteLenis?: { stop: () => void; start: () => void } | null }).__siteLenis
      if (locked) lenis?.stop()
      else lenis?.start()
    }

    function openNav() {
      toggle!.setAttribute('aria-expanded', 'true')
      links!.classList.add('open')
      setNavLinksTabindex(true)
      setPageLocked(true)

      // Focus trap for mobile nav: the links plus the close button
      const focusable = [...links!.querySelectorAll<HTMLElement>('a, button'), toggle!]
      const first = focusable[0]
      const last = focusable[focusable.length - 1]

      function handler(e: KeyboardEvent) {
        if (e.key !== 'Tab') return
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus() }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus() }
      }

      document.addEventListener('keydown', handler)
      first?.focus()
      removeTrap = () => document.removeEventListener('keydown', handler)
    }

    function closeNav() {
      toggle!.setAttribute('aria-expanded', 'false')
      links!.classList.remove('open')
      setNavLinksTabindex(false)
      setPageLocked(false)
      removeTrap?.()
      removeTrap = null
      toggle!.focus()
    }

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true'
      if (expanded) closeNav()
      else openNav()
    })

    // Close on Escape key (document-level for when focus is outside nav)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle!.getAttribute('aria-expanded') === 'true') {
        closeNav()
      }
    })

    // Close on nav link click (mobile)
    links.querySelectorAll('a').forEach(link => {
      if ((link as HTMLElement).dataset.navCloseBound === 'true') return
      ;(link as HTMLElement).dataset.navCloseBound = 'true'
      // Only when the mobile menu is open: closeNav pulls every link out of the tab order
      link.addEventListener('click', () => {
        if (toggle!.getAttribute('aria-expanded') === 'true') closeNav()
      })
    })
  }

  const navWindow = window as NavWindow
  if (navWindow.__navAfterSwapHandler) {
    document.removeEventListener('astro:after-swap', navWindow.__navAfterSwapHandler)
  }
  navWindow.__navAfterSwapHandler = initNav

  initNav()
  document.addEventListener('astro:after-swap', navWindow.__navAfterSwapHandler)

  // On the homepage, the Work tab takes the highlight while the work list sits under the nav.
  // Visual only: Home keeps aria-current, since this is still the homepage.
  let removeWorkSpy: (() => void) | null = null

  function initWorkSpy() {
    removeWorkSpy?.()
    removeWorkSpy = null

    const section = document.getElementById('work')
    const nav = document.getElementById('site-nav')
    const homeLi = document.querySelector<HTMLElement>('.nav-link[href="/"]')?.parentElement
    const workLi = document.querySelector<HTMLElement>('.nav-link[href="/#work"]')?.parentElement
    if (location.pathname !== '/' || !section || !nav || !homeLi || !workLi) return

    let inWork = false
    let frame = 0

    // `at` is the scroll position to judge from: the page's own, unless a swap is about to restore one
    function update(at = window.scrollY) {
      frame = 0
      const line = nav!.offsetHeight + 1
      const rect = section!.getBoundingClientRect()
      const top = rect.top + window.scrollY - at
      const next = top <= line && top + rect.height > line
      if (next === inWork) return
      inWork = next

      const [from, to] = next ? [homeLi!, workLi!] : [workLi!, homeLi!]
      from.querySelector('.nav-link')?.classList.remove('active')
      to.querySelector('.nav-link')?.classList.add('active')
    }

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(() => update())
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    // The first read happens before the page is first painted: no fade from the server-rendered Home tab
    // On Back, Astro restores the saved scroll just after the swap; start from where it will land
    const restored = (history.state as { scrollY?: number } | null)?.scrollY ?? 0
    homeLi.style.transition = workLi.style.transition = 'none'
    update(Math.max(window.scrollY, restored))
    void homeLi.offsetWidth
    homeLi.style.transition = workLi.style.transition = ''

    removeWorkSpy = () => {
      window.removeEventListener('scroll', onScroll)
      cancelAnimationFrame(frame)
    }
  }

  // Also right at the swap, so a page restored deep in the list never paints with Home lit first
  document.addEventListener('astro:after-swap', initWorkSpy)
  document.addEventListener('astro:page-load', initWorkSpy)
  document.addEventListener('astro:before-swap', () => removeWorkSpy?.())

  // On the homepage, Work links glide down to the list instead of jumping. Capture phase on
  // window runs before Astro's router, which skips clicks that are already default-prevented.
  type SmoothScroller = { scrollTo: (target: HTMLElement, opts: { offset: number; duration: number; easing: (t: number) => number }) => void }

  window.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
    const link = (e.target as Element | null)?.closest('a[href="/#work"]')
    const section = document.getElementById('work')
    if (!link || !section || location.pathname !== '/') return

    e.preventDefault()
    history.pushState(null, '', '#work')

    // Lenis only runs when motion is allowed (BaseLayout skips it for reduced motion)
    const lenis = (window as Window & { __siteLenis?: SmoothScroller | null }).__siteLenis
    if (lenis) {
      const navHeight = document.getElementById('site-nav')?.offsetHeight ?? 0
      lenis.scrollTo(section, { offset: -navHeight, duration: animations.nav.scrollToWork, easing: (t) => 1 - Math.pow(1 - t, 4) })
    } else {
      // scroll-margin-top on the section clears the nav here
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      section.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' })
    }
  }, { capture: true })
</script>

<script>
  import { animations } from '../data/tokens'

  const ENTRANCE_KEY = 'entrance-played'
  const entranceTiming = animations.nav.entrance
  // GSAP's power3.out and power3.inOut as CSS curves: the entrance runs on the Web Animations API,
  // so the first load doesn't wait on GSAP
  const EASE_OUT = 'cubic-bezier(0.165, 0.84, 0.44, 1)'
  const EASE_IN_OUT = 'cubic-bezier(0.77, 0, 0.175, 1)'

  // The resting state, set inline; an entrance animates up to it
  function showAllImmediate() {
    document.querySelectorAll<HTMLElement>('.nav-logo, .nav-link').forEach(el => {
      el.style.opacity = '1'
      el.style.transform = 'none'
    })
    document.querySelectorAll<HTMLElement>('.grid-overlay, .nav, .nav-logo, .nav-links li').forEach(el => {
      el.style.setProperty('--line-draw', '1')
    })
    const firstRule = document.querySelector<HTMLElement>('.section-rule')
    if (firstRule) firstRule.style.transform = 'scaleX(1)'
  }

  function playEntrance() {
    const seen = sessionStorage.getItem(ENTRANCE_KEY)
    sessionStorage.setItem(ENTRANCE_KEY, '1')
    showAllImmediate()
    if (seen || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    // fill: backwards holds each element at its hidden start until its turn
    const fadeIn = (el: HTMLElement, duration: number, delay: number) =>
      el.animate([{ opacity: 0, transform: 'translateY(-12px)' }, { opacity: 1, transform: 'none' }],
        { duration: duration * 1000, delay: delay * 1000, easing: EASE_OUT, fill: 'backwards' })

    const logo = document.querySelector<HTMLElement>('.nav-logo')
    if (logo) fadeIn(logo, entranceTiming.logoFade, entranceTiming.logoFadeAt)
    document.querySelectorAll<HTMLElement>('.nav-link').forEach((link, i) =>
      fadeIn(link, entranceTiming.linkFade, entranceTiming.linkFadeAt + i * entranceTiming.linkStagger))

    // First section rule (below hero) draws from left on load
    document.querySelector<HTMLElement>('.section-rule')?.animate(
      [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }],
      { duration: entranceTiming.ruleDraw * 1000, delay: entranceTiming.ruleDrawAt * 1000, easing: EASE_IN_OUT, fill: 'backwards' })
  }

  playEntrance()
  document.addEventListener('astro:after-swap', showAllImmediate)
</script>

<script>
  // Marks the nav once the page has scrolled, for its shade (editorial.css). A page change brings a
  // new nav element, so the mark is set again after each swap
  function markScrolled() {
    document.getElementById('site-nav')?.toggleAttribute('data-scrolled', window.scrollY > 8)
  }

  markScrolled()
  window.addEventListener('scroll', markScrolled, { passive: true })
  document.addEventListener('astro:after-swap', markScrolled)
  document.addEventListener('astro:page-load', markScrolled)
</script>
