{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Animation Config",
  "description": "GSAP animation parameters for all page sections. Supports $ref to tokens.json values.",
  "type": "object",
  "definitions": {
    "gsapEase": {
      "type": "string",
      "description": "GSAP easing function",
      "enum": [
        "none",
        "power1.in", "power1.out", "power1.inOut",
        "power2.in", "power2.out", "power2.inOut",
        "power3.in", "power3.out", "power3.inOut",
        "power4.in", "power4.out", "power4.inOut",
        "back.in", "back.out", "back.inOut",
        "back.in(1.4)", "back.out(1.4)", "back.inOut(1.4)",
        "elastic.in", "elastic.out", "elastic.inOut",
        "bounce.in", "bounce.out", "bounce.inOut",
        "expo.in", "expo.out", "expo.inOut",
        "circ.in", "circ.out", "circ.inOut",
        "sine.in", "sine.out", "sine.inOut",
        "steps(1)", "steps(2)", "steps(3)", "steps(4)", "steps(5)"
      ]
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "Animation duration in seconds"
    },
    "stagger": {
      "type": "number",
      "minimum": 0,
      "description": "Stagger delay between elements in seconds"
    },
    "blurPx": {
      "type": "number",
      "minimum": 0,
      "description": "Blur amount in pixels"
    },
    "offsetPx": {
      "type": "number",
      "description": "Translate offset in pixels"
    },
    "opacity01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Opacity value (0-1)"
    },
    "scrollTriggerStart": {
      "type": "string",
      "pattern": "^(top|center|bottom) \\d+%$",
      "description": "ScrollTrigger start position (e.g. 'top 70%')"
    },
    "tokenRef": {
      "type": "object",
      "description": "Reference to a design token in tokens.json via dot-path",
      "properties": {
        "$ref": { "type": "string", "pattern": "^(ref|sys)\\.", "description": "Dot-path to a token value (e.g. sys.motion.gsapEasing.enter)" }
      },
      "required": ["$ref"],
      "additionalProperties": false
    },
    "easeOrRef": {
      "description": "GSAP easing function or token $ref",
      "oneOf": [
        { "$ref": "#/definitions/gsapEase" },
        { "$ref": "#/definitions/tokenRef" }
      ]
    },
    "seconds": {
      "type": "object",
      "description": "Named durations, delays, staggers and timeline positions, in seconds",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "durationOrRef": {
      "description": "Duration in seconds or token $ref",
      "oneOf": [
        { "$ref": "#/definitions/duration" },
        { "$ref": "#/definitions/tokenRef" }
      ]
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "textReveal": {
      "type": "object",
      "description": "Unified text reveal animation config — single source for all text animations. slideUp is computed at runtime as fontSize × slideUp; CMY offset is derived from cmyStagger / duration.",
      "properties": {
        "duration":      { "$ref": "#/definitions/duration", "description": "How long each word's reveal takes" },
        "wordStagger":   { "$ref": "#/definitions/stagger", "description": "Delay between each word starting its reveal" },
        "blockStagger":  { "$ref": "#/definitions/stagger", "description": "Delay between grouped text blocks in a [data-reveal-group]" },
        "slideUp":  { "$ref": "#/definitions/offsetPx", "description": "Slide distance in pixels — used for both text motion and CMY shadow offset" },
        "initialBlur":   { "$ref": "#/definitions/blurPx", "description": "Starting blur — sharpens to 0 during reveal" },
        "ease":          { "$ref": "#/definitions/easeOrRef" },
        "cssEase":       { "type": "string", "description": "CSS equivalent of ease (power4.out), for reveals that run in CSS without GSAP" },
        "scrollStart":   { "$ref": "#/definitions/scrollTriggerStart" },
        "cmyStagger":    { "$ref": "#/definitions/stagger", "description": "Delay between each CMY color channel following the text" },
        "cmyOpacity":    { "$ref": "#/definitions/opacity01", "description": "Visibility of trailing CMY color layers" }
      },
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "description": "Hero section animations",
      "properties": {
        "canvas": {
          "type": "object",
          "description": "Three.js hero canvas parameters",
          "properties": {
            "arrangement":   { "type": "string", "enum": ["spiral", "grid", "random"], "description": "Dot arrangement pattern" },
            "numRays":       { "type": "integer", "minimum": 1, "description": "Number of spiral rays" },
            "dotsPerRay":    { "type": "integer", "minimum": 1, "description": "Dots per ray" },
            "spacing":       { "type": "number", "minimum": 0, "description": "Spacing between dots" },
            "innerRadius":   { "type": "number", "minimum": 0, "description": "Inner radius of spiral" },
            "dotRadius":     { "type": "number", "minimum": 0, "description": "Base dot radius" },
            "dotSegments":   { "type": "integer", "minimum": 3, "maximum": 32, "description": "Dot geometry segments (3=triangle, 6=hex, 32=circle)" },
            "sizeStart":     { "type": "number", "minimum": 0, "description": "Dot size at spiral start" },
            "sizeMid":       { "type": "number", "minimum": 0, "description": "Dot size at spiral midpoint" },
            "sizeEnd":       { "type": "number", "minimum": 0, "description": "Dot size at spiral end" },
            "wavePaused":    { "type": "boolean", "description": "Pause wave animation" },
            "waveSpeed":     { "type": "number", "minimum": 0, "description": "Wave animation speed multiplier" },
            "waveFrequency": { "type": "number", "minimum": 0, "description": "Wave oscillation frequency" },
            "waveAmplitude": { "type": "number", "minimum": 0, "description": "Wave oscillation amplitude" },
            "waveSharpness": { "type": "number", "minimum": 0, "maximum": 1, "description": "Wave shape sharpness (0=sine, 1=square)" },
            "propagation":   { "type": "number", "minimum": 0, "description": "Wave propagation distance" },
            "baseScale":     { "type": "number", "minimum": 0, "description": "Base scale multiplier for all dots" },
            "twistAmount":   { "type": "number", "description": "Spiral twist factor" },
            "zoom":          { "type": "number", "minimum": 1, "description": "Camera zoom level" },
            "mobileZoomFactor": { "type": "number", "minimum": 0.1, "maximum": 2, "description": "Multiplier on zoom at 768px and below" },
            "maxDpr":        { "type": "number", "minimum": 0.5, "maximum": 3, "description": "Max device pixel ratio cap" },
            "cmyStagger":    { "$ref": "#/definitions/stagger", "description": "Delay between CMY color channels in hero dot wave (seconds)" },
            "accentOpacity": { "$ref": "#/definitions/opacity01", "description": "Opacity of accent color dot layers (0=invisible, 1=fully opaque)" },
            "pointer": {
              "type": "object",
              "description": "Dots react to the pointer: pushed out and swollen near it, the red, green and blue layers pushed apart",
              "properties": {
                "radius": { "type": "number", "minimum": 0, "description": "Reach around the pointer, CSS px" },
                "push": { "type": "number", "description": "Furthest a dot is pushed out, as a share of the radius" },
                "grow": { "type": "number", "description": "Extra size at the pointer (1 doubles a dot)" },
                "split": { "type": "number", "description": "How much more the red layer is pushed than green, and blue less" },
                "stiffness": { "type": "number", "minimum": 0, "maximum": 1, "description": "Spring pull toward the pointer (and in or out as it enters or leaves), per frame" },
                "damping": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share of the spring's speed kept each frame; lower settles sooner, higher bounces more" },
                "attack": { "type": "number", "minimum": 0, "maximum": 1, "description": "How fast a dot eases into its displacement as the bulge reaches it, per frame" },
                "release": { "type": "number", "minimum": 0, "maximum": 1, "description": "How fast a dot eases back once the bulge has passed, per frame; lower leaves a longer trail" }
              },
              "additionalProperties": false
            },
            "bgColor":       { "oneOf": [{ "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, { "$ref": "#/definitions/tokenRef" }], "description": "Canvas background color (hex or token $ref)" }
          },
          "additionalProperties": false
        },
        "text": {
          "type": "object",
          "description": "Hero-specific text animation overrides",
          "properties": {
            "startDelay": { "type": "number", "minimum": 0, "description": "Initial delay waiting for canvas init (seconds)" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "description": "Experience timeline animations",
      "properties": {
        "hover": {
          "type": "object",
          "description": "Timeline card hover interaction parameters",
          "properties": {
            "cmyOpacity":              { "$ref": "#/definitions/opacity01", "description": "Opacity of CMY wipe color" },
            "saveCmyOpacity":          { "$ref": "#/definitions/opacity01", "description": "Opacity of CMY color on save/download button hover" },
            "expandDuration":          { "$ref": "#/definitions/durationOrRef", "description": "Card/year group flex expansion duration" },
            "expandEase":              { "$ref": "#/definitions/easeOrRef" },
            "collapseDuration":        { "$ref": "#/definitions/durationOrRef", "description": "Mouse leave collapse duration" },
            "collapseEase":            { "$ref": "#/definitions/easeOrRef" },
            "textShowDuration":        { "$ref": "#/definitions/durationOrRef", "description": "Text fade-in duration on hover" },
            "textHideDuration":        { "$ref": "#/definitions/durationOrRef", "description": "Text fade-out duration on other cards" },
            "collapseTextDuration":    { "$ref": "#/definitions/durationOrRef", "description": "Text fade-in duration on mouse leave" },
            "wipeDuration":            { "$ref": "#/definitions/durationOrRef", "description": "Color wipe scaleX in duration" },
            "wipeEase":                { "$ref": "#/definitions/easeOrRef" },
            "wipeOutDuration":         { "$ref": "#/definitions/durationOrRef", "description": "Color wipe scaleX out duration" },
            "wipeOutEase":             { "$ref": "#/definitions/easeOrRef" },
            "highlightsShowDuration":  { "$ref": "#/definitions/durationOrRef", "description": "Highlights fade-in duration" },
            "highlightsShowDelay":     { "$ref": "#/definitions/duration", "description": "Highlights fade-in delay" },
            "highlightsShowStagger":   { "$ref": "#/definitions/stagger", "description": "Delay between highlight lines fading in" },
            "highlightsShowEase":      { "$ref": "#/definitions/easeOrRef" },
            "highlightsHideDuration":  { "$ref": "#/definitions/durationOrRef", "description": "Highlights fade-out duration on leave" },
            "highlightsHideStagger":   { "$ref": "#/definitions/stagger", "description": "Delay between highlight lines fading out" },
            "highlightsHideEase":      { "$ref": "#/definitions/easeOrRef" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workHover": {
      "type": "object",
      "description": "WebGL chromatic aberration hover effect on work card images",
      "properties": {
        "radius":         { "type": "number", "minimum": 0.05, "maximum": 1.0, "description": "Size of effect area around cursor (0.05=pinpoint, 1.0=covers entire image)" },
        "channelSpread":  {
          "type": "object",
          "description": "RGB channel offset multipliers — higher = more separation. Keep r < g < b for natural chromatic spread.",
          "properties": {
            "r": { "type": "number", "minimum": 0.1, "maximum": 3.0, "description": "Red channel offset" },
            "g": { "type": "number", "minimum": 0.1, "maximum": 3.0, "description": "Green channel offset (should be > r)" },
            "b": { "type": "number", "minimum": 0.1, "maximum": 3.0, "description": "Blue channel offset (should be > g)" }
          },
          "additionalProperties": false
        },
        "mouseSmoothing":  { "type": "number", "minimum": 0.01, "maximum": 1.0, "description": "Cursor trailing speed (0.01=very laggy, 1.0=instant snap)" },
        "speedSmoothing":  { "type": "number", "minimum": 0.01, "maximum": 1.0, "description": "How fast velocity ramps up (0.01=slow, 1.0=instant)" },
        "speedDecay":      { "type": "number", "minimum": 0.9, "maximum": 0.999, "description": "Velocity fade per frame (0.9=snaps off, 0.999=lingers for seconds)" },
        "maxVelocity":     { "type": "number", "minimum": 0.01, "maximum": 2.0, "description": "Caps effect intensity (higher=more extreme distortion)" },
        "idleThreshold":   { "type": "number", "minimum": 0.0001, "maximum": 0.01, "description": "Velocity below which GPU rendering stops" },
        "fadeDuration":    { "type": "number", "minimum": 0, "maximum": 1.0, "description": "Canvas show/hide CSS transition in seconds" },
        "maxDpr":          { "type": "number", "minimum": 1, "maximum": 3, "description": "Max device pixel ratio (1=faster, 2=sharp retina, 3=sharpest)" }
      },
      "additionalProperties": false
    },
    "dotGrid": {
      "type": "object",
      "description": "Background dot grid overlay parameters",
      "properties": {
        "spacing": { "type": "number", "minimum": 5, "maximum": 100, "description": "Grid spacing in pixels" },
        "radius":  { "type": "number", "minimum": 0.1, "maximum": 5, "description": "Dot radius in pixels" },
        "opacity": { "$ref": "#/definitions/opacity01", "description": "Dot opacity" }
      },
      "additionalProperties": false
    },
    "interests": {
      "type": "object",
      "description": "Scrolling interests marquee",
      "properties": {
        "scrollDuration": { "type": "number", "minimum": 0, "description": "Full scroll loop duration in seconds" }
      },
      "additionalProperties": false
    },
    "smoothScroll": {
      "type": "object",
      "description": "Lenis smooth scroll parameters",
      "properties": {
        "lerp":            { "type": "number", "minimum": 0, "maximum": 1, "description": "Scroll interpolation factor (0=no smoothing, 1=instant)" },
        "wheelMultiplier": { "type": "number", "minimum": 0, "description": "Mouse wheel speed multiplier" }
      },
      "additionalProperties": false
    },
    "nav": {
      "type": "object",
      "description": "Nav first-visit entrance and the Work link's smooth scroll",
      "properties": {
        "entrance":     { "$ref": "#/definitions/seconds", "description": "First-visit grid and nav draw-in; *At keys are timeline positions" },
        "scrollToWork": { "$ref": "#/definitions/duration", "description": "Smooth scroll to the work list" }
      },
      "additionalProperties": false
    },
    "imageReveal": { "$ref": "#/definitions/seconds", "description": "Image reveals on scroll, site-wide and in case studies" },
    "homeReveal":  { "$ref": "#/definitions/seconds", "description": "Homepage timeline, interests and dot grid reveals" },
    "carousel":    { "$ref": "#/definitions/seconds", "description": "Case study carousel" },
    "clientLogos": { "$ref": "#/definitions/seconds", "description": "About page client logo marquee" },
    "lottie":      { "$ref": "#/definitions/seconds", "description": "Looping Lottie players" },
    "caseStudy": {
      "type": "object",
      "description": "Case study diagrams (Amica and Whataburger)",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "$ref": "#/definitions/seconds" }
          ]
        }
      }
    },
    "pageTransition": {
      "type": "object",
      "description": "RGBShutter panel transition between pages",
      "properties": {
        "duration":  { "$ref": "#/definitions/duration", "description": "Panel cover and reveal duration" },
        "stagger":   { "$ref": "#/definitions/stagger" },
        "ease":      { "$ref": "#/definitions/gsapEase" },
        "exitDelay": { "$ref": "#/definitions/duration", "description": "Pause before the panel reveals the new page" }
      },
      "additionalProperties": false
    },
    "workCards": {
      "type": "object",
      "description": "Homepage work card flipbook (thumbnailLayers.frames)",
      "properties": {
        "flipHold": { "$ref": "#/definitions/duration", "description": "How long each frame holds before the next" },
        "flipFade": { "$ref": "#/definitions/duration", "description": "Crossfade between frames" },
        "phone": {
          "type": "object",
          "description": "3D device on coded work cards (DeviceScene): motion shared by every device. Angles in radians",
          "properties": {
            "restYaw": { "type": "number", "description": "Turn at rest; negative shows the left side" },
            "restPitch": { "type": "number", "description": "Tilt at rest; positive leans the top back" },
            "dragYaw": { "type": "number", "description": "Turn for a drag across the full width of the device's box" },
            "dragPitch": { "type": "number", "description": "Tilt for a drag across the full height of the device's box" },
            "dragPitchLimit": { "type": "number", "minimum": 0, "description": "Furthest a drag tilts the device either way from its rest" },
            "dragReturn": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share of the way back to rest covered each frame after a drag" },
            "parallax": { "type": "number", "description": "Device offset per pixel the row sits from the viewport's center (scroll parallax)" },
            "scrollPitch": { "type": "number", "description": "Tilt from the card's place in the viewport, bottom to top" },
            "sway": { "type": "number", "description": "Idle turn amplitude" },
            "swayPeriod": { "$ref": "#/definitions/duration", "description": "Idle sway period" },
            "follow": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share of the distance to the target angle covered each frame" },
            "lensMm": { "type": "number", "minimum": 10, "description": "Camera focal length, full-frame equivalent (vertical field of view on a 24mm sensor)" }
          },
          "additionalProperties": false
        },
        "devices": {
          "type": "object",
          "description": "Rest angle per device on coded cards (DeviceScene), in radians; devices not listed use phone.restYaw and phone.restPitch",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "restYaw": { "type": "number" },
              "restPitch": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "scenes": {
          "type": "object",
          "description": "Rest angle per arrangement (device-scene/arrangements.ts), in radians; overrides its lead device's",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "restYaw": { "type": "number" },
              "restPitch": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "float": {
          "type": "object",
          "description": "Floating devices in the arrangements (device-scene/arrangements.ts): their bob, and how they drift up into place as the card scrolls in",
          "properties": {
            "bob": { "type": "number", "minimum": 0, "description": "Bob height, meters" },
            "period": { "$ref": "#/definitions/duration", "description": "One bob, seconds" },
            "wobble": { "type": "number", "description": "Lean that goes with the bob, radians" },
            "drift": { "type": "number", "minimum": 0, "description": "How far below its place a floating device starts, meters" },
            "enterFrom": { "type": "number", "description": "Where the card's center is (share of the viewport's height from the top) when the drift starts" },
            "enterTo": { "type": "number", "description": "Where it is when the device has arrived" }
          },
          "additionalProperties": false
        },
        "deviceNav": {
          "type": "object",
          "description": "A device carried between its homepage card and case study hero (device-scene/mount.ts, global.css)",
          "properties": {
            "align": { "$ref": "#/definitions/duration", "description": "Homepage scrolling the clicked card to where its hero's device sits, before the page changes" },
            "move": { "$ref": "#/definitions/duration", "description": "Device gliding to its new place" },
            "fadeIn": { "$ref": "#/definitions/duration", "description": "The two pages crossfading, the old out as the new one in, on the same curve" },
            "fadeInDelay": { "$ref": "#/definitions/duration", "description": "Direct visits only: wait before the hero's words slide in" },
            "settle": { "$ref": "#/definitions/duration", "description": "After the device lands, how long its screens stay on the frame they left on before their tours, videos and animations go on" }
          },
          "additionalProperties": false
        },
        "tours": {
          "type": "object",
          "description": "Screen tours on the CVS.com, Amica.com, Samsung.com and Bespoke cards (device-scene/tours.ts). Seconds",
          "properties": {
            "moves": {
              "type": "object",
              "description": "Transition durations shared by every tour",
              "additionalProperties": { "$ref": "#/definitions/duration" }
            }
          },
          "additionalProperties": {
            "type": "object",
            "description": "One tour's holds and scrolls, keyed by the step names in tours.ts",
            "additionalProperties": { "$ref": "#/definitions/duration" }
          }
        },
        "myfrontier": {
          "type": "object",
          "description": "The MyFrontier card's app tour (device-scene/myfrontier.ts). Seconds",
          "properties": {
            "moves": {
              "type": "object",
              "description": "Transition durations",
              "additionalProperties": { "$ref": "#/definitions/duration" }
            },
            "holds": {
              "type": "object",
              "description": "Pauses between steps, in tour order",
              "additionalProperties": { "$ref": "#/definitions/duration" }
            }
          },
          "required": ["moves", "holds"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
