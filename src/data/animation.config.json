{
  "$schema": "./animation.config.schema.json",
  "textReveal": {
    "duration": 0.4,
    "wordStagger": 0.08,
    "blockStagger": 0.06,
    "slideUp": 20,
    "initialBlur": 6,
    "ease": { "$ref": "sys.motion.gsapEasing.enter" },
    "cssEase": "cubic-bezier(0.23, 1, 0.32, 1)",
    "scrollStart": "top 70%",
    "cmyStagger": 0.04,
    "cmyOpacity": 0.4
  },
  "hero": {
    "canvas": {
      "arrangement": "spiral",
      "numRays": 80,
      "dotsPerRay": 30,
      "spacing": 1,
      "innerRadius": 0,
      "dotRadius": 0.2,
      "dotSegments": 8,
      "sizeStart": 0.1,
      "sizeMid": 1.0,
      "sizeEnd": 0.1,
      "wavePaused": false,
      "waveSpeed": 1.0,
      "waveFrequency": 0.1,
      "waveAmplitude": 0.5,
      "waveSharpness": 0.25,
      "propagation": 30,
      "baseScale": 1.25,
      "twistAmount": 0.5,
      "zoom": 20,
      "maxDpr": 2,
      "cmyStagger": 0.03,
      "accentOpacity": 0.6,
      "bgColor": { "$ref": "sys.color.bg.primary" }
    },
    "lens": {
      "radius": 150,
      "magnification": 3,
      "subpixelSplit": 0.9,
      "follow": 0.25,
      "open": 0.3
    },
    "text": {
      "startDelay": 0.25
    }
  },
  "timeline": {
    "hover": {
      "cmyOpacity": 1,
      "saveCmyOpacity": 1,
      "expandDuration": 0.5,
      "expandEase": { "$ref": "sys.motion.gsapEasing.bounce" },
      "collapseDuration": { "$ref": "sys.motion.duration.quick" },
      "collapseEase": { "$ref": "sys.motion.gsapEasing.bounceMove" },
      "textShowDuration": { "$ref": "sys.motion.duration.quick" },
      "textHideDuration": { "$ref": "sys.motion.duration.quick" },
      "collapseTextDuration": { "$ref": "sys.motion.duration.quick" },
      "wipeDuration": { "$ref": "sys.motion.duration.quick" },
      "wipeEase": { "$ref": "sys.motion.gsapEasing.bounce" },
      "wipeOutDuration": { "$ref": "sys.motion.duration.quick" },
      "wipeOutEase": { "$ref": "sys.motion.gsapEasing.bounceIn" },
      "highlightsShowDuration": 0.6,
      "highlightsShowDelay": 0.15,
      "highlightsShowStagger": 0.08,
      "highlightsShowEase": { "$ref": "sys.motion.gsapEasing.bounce" },
      "highlightsHideDuration": { "$ref": "sys.motion.duration.quick" },
      "highlightsHideStagger": 0.02,
      "highlightsHideEase": { "$ref": "sys.motion.gsapEasing.bounceIn" }
    }
  },
  "footerLogo": {
    "spinDuration": 12
  },
  "dotGrid": {
    "spacing": 30,
    "radius": 1,
    "opacity": 0.5
  },
  "interests": {
    "scrollDuration": 480
  },
  "smoothScroll": {
    "lerp": 0.5,
    "wheelMultiplier": 1
  },
  "nav": {
    "petal": {
      "fillIn": 0.2,
      "anticipate": 0.15,
      "burst": 0.25,
      "settle": 0.6,
      "reset": 0.3
    },
    "entrance": {
      "gridDraw": 1.0,
      "navDraw": 0.8,
      "navDrawAt": 0.1,
      "logoDraw": 0.6,
      "logoDrawAt": 0.2,
      "logoFade": 0.5,
      "logoFadeAt": 0.15,
      "linkDraw": 0.5,
      "linkDrawAt": 0.25,
      "linkFade": 0.4,
      "linkFadeAt": 0.3,
      "linkStagger": 0.12,
      "ruleDraw": 0.8,
      "ruleDrawAt": 0.2
    },
    "scrollToWork": 1
  },
  "imageReveal": {
    "duration": 0.9,
    "pairStagger": 0.15,
    "carouselStagger": 0.1,
    "proseDelay": 0.2
  },
  "homeReveal": {
    "duration": 0.9,
    "timelineDuration": 0.7,
    "jobStagger": 0.1,
    "yearStagger": 0.05,
    "yearDelay": 0.2,
    "dotGridDuration": 1.2
  },
  "carousel": {
    "snapDuration": 0.5
  },
  "clientLogos": {
    "scrollDuration": 40
  },
  "lottie": {
    "loopDuration": 2,
    "loopRepeatDelay": 0.5
  },
  "caseStudy": {
    "decisionStepper": {
      "hold": 3.5,
      "fade": 0.3
    },
    "beforeAfter": {
      "itemDuration": 0.5,
      "itemStagger": 0.08,
      "countDuration": 2
    },
    "tokenTiers": {
      "duration": 0.5,
      "stagger": 0.12
    },
    "diagrams": {
      "duration": 0.5,
      "stagger": 0.08,
      "tokenTiers": {
        "duration": 0.6,
        "stagger": 0.15
      },
      "tokenArrow": 0.4,
      "colorStatesStagger": 0.06,
      "spacingRows": {
        "duration": 0.4,
        "stagger": 0.05
      },
      "radiusItems": {
        "duration": 0.4,
        "stagger": 0.06
      },
      "durationItemsStagger": 0.12,
      "easingCard": 0.6,
      "elevationCards": {
        "duration": 0.6,
        "stagger": 0.1
      },
      "libraryCardsStagger": 0.1,
      "libraryStats": {
        "duration": 0.4,
        "stagger": 0.1,
        "delay": 0.3
      }
    },
    "scrubbedMorph": {
      "morph": 1,
      "labelFade": 0.3,
      "beforeOutAt": 0.2,
      "afterInAt": 0.5
    },
    "chaosToOrder": {
      "stagger": 0.03,
      "shadowAt": 0.7,
      "shadowDuration": 0.3,
      "shadowStagger": 0.02
    },
    "typeHierarchy": {
      "roleFade": 0.3,
      "roleAt": 0.5
    },
    "motionSystem": {
      "dotFade": 0.2,
      "dotFadeDelay": 0.3,
      "easingTrace": 1.2,
      "easingFade": 0.3,
      "easingFadeDelay": 0.5
    },
    "heroPhoneScroll": {
      "loop": 60,
      "loopMobile": 40,
      "speedUp": 1,
      "zoomOut": 2,
      "centerFade": 0.2,
      "phonesAt": 0.25,
      "phoneFade": 0.08,
      "phoneSlide": 0.7,
      "phoneStagger": 0.18,
      "scrollAt": 0.4
    }
  },
  "pageTransition": {
    "duration": 0.25,
    "stagger": 0.04,
    "ease": "power2.inOut",
    "exitDelay": 0.05
  },
  "workCards": {
    "flipHold": 1.4,
    "flipFade": 0.35
  }
}
