{
  "main": "dist/_worker.js/index.js",
  "name": "portfolio",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    // Serve /about/index.html at /about (the form every internal link uses) instead of a 307 to /about/
    "html_handling": "drop-trailing-slash",
    // Only the embeds need the Worker first. Gated case studies have no file in dist, so they reach
    // the Worker anyway; listing /work/* here sent the prerendered ones through SSR and raw images.
    "run_worker_first": ["/_protected-embeds/*"]
  },
  // Resizes images on the SSR (password-gated) case studies; see src/image-endpoint.ts
  "images": {
    "binding": "IMAGES"
  },
  // Logs, traces and issues for the Cloudflare dashboard; every Worker has the same block.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "$schema": "node_modules/wrangler/config-schema.json"
}
